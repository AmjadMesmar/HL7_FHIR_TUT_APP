@using Hl7FhirWorkbench.Models.Glossary

@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-book-half text-warning fs-4"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Healthcare Jargon &amp; Interoperability Glossary</h5>
                            <small class="text-white-50">Quick-reference definitions for hospital software engineering terms</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-7">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="Search term, acronym, or concept..." 
                                       @bind="searchTerm" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <select class="form-select form-select-sm" @bind="selectedCategory">
                                <option value="All">All Categories</option>
                                <option value="Identity">Identity &amp; Demographics</option>
                                <option value="Encounter">Visits &amp; Encounters</option>
                                <option value="Orders">Orders &amp; Results</option>
                                <option value="Networking">Networking &amp; Wire Protocols</option>
                                <option value="Syntax">Syntax &amp; Delimiters</option>
                                <option value="Terminology">Clinical Terminologies</option>
                                <option value="FHIR Core">FHIR R4 Core</option>
                                <option value="HL7 v2">HL7 v2 Message Types</option>
                                <option value="Architecture">System Architecture</option>
                            </select>
                        </div>
                    </div>

                    <div class="list-group list-group-flush border rounded">
                        @foreach (var item in FilteredItems)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1 flex-wrap gap-1">
                                    <h6 class="fw-bold mb-0 text-primary">
                                        @item.Term <span class="text-muted fw-normal small">(@item.ShortDefinition)</span>
                                    </h6>
                                    <div>
                                        <span class="badge @GetStandardBadge(item.Standard) me-1">@item.Standard</span>
                                        <span class="badge bg-secondary">@item.Category</span>
                                    </div>
                                </div>
                                <p class="small text-muted mb-0">@item.LongExplanation</p>
                            </div>
                        }
                        @if (!FilteredItems.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-search fs-3"></i>
                                <p class="mt-2 mb-0">No glossary terms matched "@searchTerm".</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <span class="small text-muted me-auto">Showing @FilteredItems.Count() of @GlossaryData.Items.Count terms</span>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Close">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string searchTerm = string.Empty;
    private string selectedCategory = "All";

    private IEnumerable<GlossaryItem> FilteredItems =>
        GlossaryData.Items.Where(i =>
            (selectedCategory == "All" || i.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(searchTerm) ||
             i.Term.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             i.ShortDefinition.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             i.LongExplanation.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private string GetStandardBadge(string standard) => standard switch
    {
        "HL7 v2" => "bg-warning text-dark",
        "FHIR" => "bg-success",
        "Both" => "bg-info text-dark",
        _ => "bg-primary"
    };
}
