@implements IDisposable
@inject LanguageService Lang

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-heart-pulse text-danger me-2"></i>HL7 &amp; FHIR Portal
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <!-- 1. LEARNING & CURRICULUM -->
        <div class="px-3 py-1 text-uppercase text-white-50 fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05rem;">
            @Lang.T("nav.curriculum")
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2 me-2"></i> @Lang.T("nav.overview")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="get-started">
                <i class="bi bi-book-half me-2 text-info"></i> @Lang.T("nav.master_guide")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="docs">
                <i class="bi bi-journal-bookmark-fill me-2 text-success"></i> @Lang.T("nav.living_docs")
            </NavLink>
        </div>

        <hr class="my-2 border-secondary" />

        <!-- 2. REGIONAL & ACADEMY -->
        <div class="px-3 py-1 text-uppercase text-white-50 fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05rem;">
            @Lang.T("nav.regional_training")
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="regional-interop">
                <i class="bi bi-globe-central-south-asia me-2 text-warning"></i> @Lang.T("nav.regional_interop")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="training-academy">
                <i class="bi bi-mortarboard-fill me-2 text-info"></i> @Lang.T("nav.training_academy")
            </NavLink>
        </div>

        <hr class="my-2 border-secondary" />

        <!-- 3. INTEROPERABILITY LABS -->
        <div class="px-3 py-1 text-uppercase text-white-50 fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05rem;">
            @Lang.T("nav.labs")
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="bridge">
                <i class="bi bi-shuffle me-2 text-warning"></i> @Lang.T("nav.interop_bridge")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="hl7-inspector">
                <i class="bi bi-code-slash me-2 text-primary"></i> @Lang.T("nav.hl7_inspector")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="fhir-explorer">
                <i class="bi bi-filetype-json me-2 text-success"></i> @Lang.T("nav.fhir_explorer")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="rest-playground">
                <i class="bi bi-cloud-arrow-down me-2 text-info"></i> @Lang.T("nav.rest_playground")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="hospital-flow">
                <i class="bi bi-diagram-3-fill me-2 text-warning"></i> @Lang.T("nav.hospital_flow")
            </NavLink>
        </div>

        <hr class="my-2 border-secondary" />

        <!-- 4. DEVELOPER & QA TOOLS -->
        <div class="px-3 py-1 text-uppercase text-white-50 fw-bold" style="font-size: 0.68rem; letter-spacing: 0.05rem;">
            @Lang.T("nav.tools")
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="data-factory">
                <i class="bi bi-magic me-2 text-primary"></i> @Lang.T("nav.data_factory")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="mllp-simulator">
                <i class="bi bi-hdd-network me-2 text-success"></i> @Lang.T("nav.mllp_sim")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="terminology">
                <i class="bi bi-search me-2 text-danger"></i> @Lang.T("nav.terminology")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="code-recipes">
                <i class="bi bi-filetype-cs me-2 text-warning"></i> @Lang.T("nav.code_recipes")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="test-generator">
                <i class="bi bi-check2-all me-2 text-info"></i> @Lang.T("nav.test_generator")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="war-room">
                <i class="bi bi-shield-slash-fill me-2 text-danger"></i> @Lang.T("nav.war_room")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link py-1" href="project-info">
                <i class="bi bi-info-circle-fill me-2 text-light"></i> @Lang.T("nav.project_info")
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
