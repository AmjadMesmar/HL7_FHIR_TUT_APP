@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small fw-semibold">
                <i class="bi bi-mortarboard-fill text-primary me-1"></i> Interactive Healthcare Interoperability Teaching Workbench
            </span>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="() => isGlossaryOpen = true">
                    <i class="bi bi-book-half"></i> <span class="d-none d-sm-inline">Jargon Glossary</span>
                </button>
                <span class="badge bg-primary">.NET 10</span>
                <span class="badge bg-success">FHIR R4</span>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<GlossaryModal @bind-IsOpen="isGlossaryOpen" />

@code {
    private bool isGlossaryOpen = false;
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
