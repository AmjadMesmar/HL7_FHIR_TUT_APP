@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageService Lang

<div class="page" dir="@Lang.Direction" lang="@Lang.CurrentLanguage">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small fw-semibold">
                <i class="bi bi-mortarboard-fill text-primary me-1"></i> @Lang.T("app.subtitle")
            </span>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm px-2" @onclick="Lang.ToggleLanguage" title="تغيير اللغة / Switch Language">
                    <i class="bi bi-translate text-primary"></i>
                    <span class="fw-bold">@Lang.T("app.lang.switch")</span>
                </button>
                <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="() => isGlossaryOpen = true">
                    <i class="bi bi-book-half"></i> <span class="d-none d-sm-inline">@Lang.T("app.jargon_glossary")</span>
                </button>
                <span class="badge bg-primary">.NET 10</span>
                <span class="badge bg-success">FHIR R4</span>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<GlossaryModal @bind-IsOpen="isGlossaryOpen" />

@code {
    private bool isGlossaryOpen = false;

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
