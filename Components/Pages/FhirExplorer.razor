@page "/fhir-explorer"
@rendermode InteractiveServer
@inject FhirService FhirService
@inject IJSRuntime JS

<PageTitle>FHIR R4 Resource Explorer</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-filetype-json text-success"></i> FHIR R4 Resource Explorer</h2>
            <p class="text-muted small mb-0">Explore strongly-typed FHIR R4 resources serialized via the official Firely .NET SDK.</p>
        </div>
        <div class="btn-group">
            <button class="btn btn-outline-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Load Clinical Scenario
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                @foreach (var p in ClinicalPresets.All)
                {
                    <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => SelectScenario(p.Id)">@p.Title</a></li>
                }
            </ul>
        </div>
    </div>

    <!-- Quick Scenario Buttons -->
    <div class="mb-3 d-flex flex-wrap gap-2">
        <span class="text-muted small align-self-center me-1">Scenario:</span>
        @foreach (var p in ClinicalPresets.All)
        {
            <button class="btn btn-sm @(selectedPresetId == p.Id ? "btn-success" : "btn-outline-secondary")"
                    @onclick="() => SelectScenario(p.Id)">
                @p.Title.Split('(')[0].Trim()
            </button>
        }
    </div>

    <div class="row g-3">
        <!-- Resource JSON Inspector Panel -->
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-success me-2">@resourceType</span>
                        <span class="text-muted small">Generated via Firely .NET SDK (`Hl7.Fhir.R4`)</span>
                    </div>
                    <div class="d-flex gap-2">
                        @if (isValid)
                        {
                            <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-check-circle"></i> Valid R4 Resource</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger"><i class="bi bi-x-circle"></i> Parse Warning</span>
                        }
                        <button class="btn btn-outline-secondary btn-sm py-0 px-2" @onclick="CopyJson">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <pre class="bg-dark text-light p-3 m-0 font-monospace small overflow-auto" 
                         style="max-height: 70vh; tab-size: 2; border-radius: 0 0 var(--bs-card-inner-border-radius) var(--bs-card-inner-border-radius);"><code>@fhirJson</code></pre>
                </div>
            </div>
        </div>

        <!-- Educational Reference & Data Types Side Panel -->
        <div class="col-lg-5">
            <!-- Scenario Overview -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-semibold small">
                    <i class="bi bi-info-circle text-primary"></i> Scenario Clinical Significance
                </div>
                <div class="card-body p-3 small">
                    <h6 class="fw-bold text-dark">@currentPreset?.Title</h6>
                    <p class="text-muted mb-2">@currentPreset?.Summary</p>
                    <div class="p-2 bg-light rounded border text-muted" style="white-space: pre-line;">
                        @currentPreset?.TeachingNotes
                    </div>
                </div>
            </div>

            <!-- FHIR Primitive & Complex Datatypes Cheat Sheet -->
            <div class="card shadow-sm">
                <div class="card-header bg-light fw-semibold small">
                    <i class="bi bi-mortarboard text-success"></i> FHIR Core Data Types Reference
                </div>
                <div class="card-body p-3 small overflow-auto" style="max-height: 40vh;">
                    <div class="accordion accordion-flush" id="datatypesAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 px-0 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#dtId">
                                    Identifier (CX in v2)
                                </button>
                            </h2>
                            <div id="dtId" class="accordion-collapse collapse" data-bs-parent="#datatypesAccordion">
                                <div class="accordion-body px-0 text-muted">
                                    Uniquely identifies a business entity (e.g. MRN, SSN, Account Number).<br />
                                    <strong>Properties:</strong> <code>system</code> (URI of assigning domain), <code>value</code> (the actual ID string), <code>type</code> (CodeableConcept like MR).
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 px-0 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#dtName">
                                    HumanName (XPN in v2)
                                </button>
                            </h2>
                            <div id="dtName" class="accordion-collapse collapse" data-bs-parent="#datatypesAccordion">
                                <div class="accordion-body px-0 text-muted">
                                    A person's name with parts: <code>family</code> (surname), <code>given[]</code> (first and middle names as string array), <code>prefix[]</code> (Dr.), <code>suffix[]</code> (Jr.).
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 px-0 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#dtCoding">
                                    CodeableConcept & Coding (CE / CWE in v2)
                                </button>
                            </h2>
                            <div id="dtCoding" class="accordion-collapse collapse" data-bs-parent="#datatypesAccordion">
                                <div class="accordion-body px-0 text-muted">
                                    Represents clinical concepts tied to terminology systems.<br />
                                    <code>system</code>: URI like <code>http://loinc.org</code> or <code>http://snomed.info/sct</code>.<br />
                                    <code>code</code>: standard code (e.g., 2345-7).<br />
                                    <code>display</code>: human-readable name.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 px-0 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#dtQuantity">
                                    Quantity (NM + CE in v2)
                                </button>
                            </h2>
                            <div id="dtQuantity" class="accordion-collapse collapse" data-bs-parent="#datatypesAccordion">
                                <div class="accordion-body px-0 text-muted">
                                    Measured amounts (lab results, dosages, vital signs).<br />
                                    Pairs <code>value</code> (decimal number) with <code>unit</code> and <code>system</code> (standardized to UCUM: <code>http://unitsofmeasure.org</code>).
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2 px-0 fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#dtRef">
                                    Reference (Pointer between resources)
                                </button>
                            </h2>
                            <div id="dtRef" class="accordion-collapse collapse" data-bs-parent="#datatypesAccordion">
                                <div class="accordion-body px-0 text-muted">
                                    The cornerstone of FHIR graph architecture. Links resources via relative or UUID URIs: e.g. <code>Encounter.subject = { reference: "Patient/123" }</code>.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Preset { get; set; }

    private string selectedPresetId = "registration";
    private ClinicalPreset? currentPreset;
    private string fhirJson = string.Empty;
    private string resourceType = "Resource";
    private bool isValid = true;

    protected override void OnInitialized()
    {
        var targetId = !string.IsNullOrEmpty(Preset) ? Preset : "registration";
        SelectScenario(targetId);
    }

    private void SelectScenario(string presetId)
    {
        selectedPresetId = presetId;
        currentPreset = ClinicalPresets.GetById(presetId);
        
        var parsedHl7 = Hl7V2Parser.Parse(currentPreset.Hl7V2Message);
        var transform = Hl7ToFhirMapper.MapMessage(parsedHl7);
        
        fhirJson = transform.FhirJson;
        resourceType = transform.FhirResource.TypeName;
        isValid = true;
    }

    private async Task CopyJson()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", fhirJson);
    }
}
