@page "/mllp-simulator"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>MLLP Protocol &amp; ACK / NACK Simulator</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-light text-primary mb-2 px-3 py-1 fw-semibold">Network &amp; Wire Protocols</span>
                <h1 class="h2 fw-bold mb-1">MLLP Protocol &amp; ACK / NACK Simulator</h1>
                <p class="mb-0 text-white-50">
                    Learn the Minimal Lower Layer Protocol (MLLP) framing bytes, TCP socket handshakes, and MSA acknowledgment responses.
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-dark align-self-center px-3 py-2 fw-semibold">
                    <i class="bi bi-hdd-network me-1"></i> Port 2575 TCP Simulator
                </span>
            </div>
        </div>
    </div>

    <!-- MLLP Framing Explanation Card -->
    <div class="card shadow-sm border mb-4">
        <div class="card-header bg-light py-2 fw-bold text-dark d-flex justify-content-between align-items-center">
            <span><i class="bi bi-box me-2 text-primary"></i> The MLLP Framing Packet Envelope (How Bytes Travel on TCP)</span>
            <span class="badge bg-primary">Port 2575 Spec</span>
        </div>
        <div class="card-body p-3 small">
            <p class="text-muted mb-2">
                Because raw TCP is an unbounded stream of bytes, HL7 v2 messages are wrapped inside <strong>MLLP block delimiters</strong> so the receiver knows exactly where a message starts and ends:
            </p>
            <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 p-3 bg-dark rounded font-monospace text-center mb-2">
                <div class="p-2 bg-primary text-white rounded">
                    <strong>START BYTE</strong><br />
                    <code>0x0B</code> (&lt;VT&gt; / ASCII 11)
                </div>
                <div class="text-white fs-4 fw-bold">&rarr;</div>
                <div class="p-2 bg-secondary text-white rounded flex-grow-1" style="max-width: 320px;">
                    <strong>HL7 v2 ER7 MESSAGE</strong><br />
                    <code>MSH|... PID|... PV1|...</code>
                </div>
                <div class="text-white fs-4 fw-bold">&rarr;</div>
                <div class="p-2 bg-danger text-white rounded">
                    <strong>END BYTES</strong><br />
                    <code>0x1C 0x0D</code> (&lt;FS&gt; &lt;CR&gt; / ASCII 28 &amp; 13)
                </div>
            </div>
            <div class="text-muted text-center" style="font-size: 0.78rem;">
                Without <code>0x0B</code> and <code>0x1C 0x0D</code>, interface engines (Mirth, Cloverleaf) will wait indefinitely or drop packets.
            </div>
        </div>
    </div>

    <!-- MLLP Frame Stepper & Byte Inspector -->
    <div class="card shadow-sm border mb-4 bg-light">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
            <div>
                <i class="bi bi-cpu-fill text-warning me-1"></i>
                <strong class="text-dark">Interactive TCP Wire Frame Stepper:</strong>
                <span class="badge bg-warning text-dark ms-2">Step @(stepperIndex + 1) of @WireSteps.Count</span>
            </div>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" @onclick="PrevWireStep" disabled="@(stepperIndex == 0)">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                <button class="btn btn-primary" @onclick="NextWireStep" disabled="@(stepperIndex >= WireSteps.Count - 1)">
                    Next Byte Stage <i class="bi bi-chevron-right"></i>
                </button>
                <button class="btn btn-outline-danger" @onclick="ResetWireStep">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>
        </div>
        <div class="card-body p-3">
            @{
                var curWire = WireSteps[stepperIndex];
            }
            <div class="row g-3 align-items-center mb-3">
                <div class="col-md-7">
                    <h6 class="fw-bold text-primary mb-1">@curWire.StageTitle</h6>
                    <p class="small text-muted mb-2">@curWire.Explanation</p>
                    <div class="alert @curWire.AlertClass py-1 px-2 small mb-0 font-monospace">
                        <strong>Wire Buffer:</strong> @curWire.WireStatus
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="p-2 rounded bg-dark text-light font-monospace small">
                        <div class="text-muted" style="font-size: 0.7rem;">Active Wire Byte Stream:</div>
                        <div class="fs-6 mt-1">@((MarkupString)curWire.HighlightedHex)</div>
                        <div class="text-muted mt-2" style="font-size: 0.7rem;">ASCII Meaning: @curWire.AsciiMeaning</div>
                    </div>
                </div>
            </div>

            <!-- Visual Progress Dots -->
            <div class="d-flex justify-content-between align-items-center px-2">
                @for (int w = 0; w < WireSteps.Count; w++)
                {
                    var wIdx = w;
                    <span class="badge @(stepperIndex == wIdx ? "bg-primary p-2" : (stepperIndex > wIdx ? "bg-success" : "bg-secondary")) cursor-pointer"
                          @onclick="() => stepperIndex = wIdx">
                        @(wIdx + 1). @WireSteps[wIdx].ShortName
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Interactive Handshake Simulator -->
    <div class="row g-3 mb-4">
        <!-- Inbound Message Column -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-primary border-top border-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <strong>Inbound HL7 v2 Transmission (Client &rarr; Server)</strong>
                    <span class="badge bg-primary">Socket Payload</span>
                </div>
                <div class="card-body p-2 d-flex flex-column">
                    <label class="form-label small text-muted mb-1">Message to Send:</label>
                    <textarea class="form-control font-monospace small flex-grow-1 mb-2" style="min-height: 140px;" @bind="inboundMessage" @bind:after="UpdateAckResponse"></textarea>
                    
                    <div class="p-2 bg-light rounded border small">
                        <strong>Raw Hex Packet Stream:</strong>
                        <div class="font-monospace text-muted mt-1 text-break" style="font-size: 0.75rem;">
                            <span class="text-primary fw-bold">0B</span> @GetHexRepresentation(inboundMessage) <span class="text-danger fw-bold">1C 0D</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACK Generator Response Column -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-success border-top border-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
                    <strong>ACK Response (Server &rarr; Client)</strong>
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(ackCode == "AA" ? "btn-success" : "btn-outline-success")" @onclick='() => SetAckStatus("AA")'>
                            AA (Accept)
                        </button>
                        <button class="btn @(ackCode == "AE" ? "btn-warning text-dark" : "btn-outline-warning")" @onclick='() => SetAckStatus("AE")'>
                            AE (Error)
                        </button>
                        <button class="btn @(ackCode == "AR" ? "btn-danger" : "btn-outline-danger")" @onclick='() => SetAckStatus("AR")'>
                            AR (Reject)
                        </button>
                    </div>
                </div>
                <div class="card-body p-2 d-flex flex-column">
                    <div class="alert @GetAckAlertClass() py-2 px-3 small mb-2">
                        <strong><i class="bi bi-info-circle-fill me-1"></i> Acknowledgment Code: <code>MSA-1: @ackCode</code></strong>
                        <div>@ackExplanation</div>
                    </div>

                    <pre class="bg-dark text-light p-3 rounded font-monospace small flex-grow-1 mb-2 overflow-auto" style="min-height: 130px; white-space: pre-wrap; word-break: break-all;"><code>@generatedAckMessage</code></pre>

                    <div class="p-2 bg-light rounded border small text-muted">
                        <strong>Control ID Tracking:</strong> Notice how <code>MSA-2</code> echoes back <code>@extractedControlId</code> to guarantee transaction idempotency.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- The Interface Queue Freeze Warning -->
    <div class="card bg-warning-subtle border-warning shadow-sm">
        <div class="card-body p-3 small">
            <h6 class="fw-bold text-dark mb-1"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Why Missing ACKs Freeze Hospital Operations:</h6>
            <p class="text-muted mb-0">
                Hospital interface engines operate in <strong>FIFO (First In, First Out)</strong> order. 
                When a hospital interface sends message #101, it freezes the entire queue until it receives an <code>ACK</code> with <code>MSA|AA|101</code>. 
                If the receiver crashes or fails to send an ACK within the socket timeout (typically 10-30 seconds), thousands of subsequent lab results and admission notices pile up in memory!
            </p>
        </div>
    </div>
</div>

@code {
    private string inboundMessage =
@"MSH|^~\&|EPIC_ADT|METRO_HOSPITAL|CENTRAL_EHR|METRO_HEALTH|20261011120000||ADT^A01|MSG20261011_001|P|2.5
PID|1||MRN982341^^^METRO^MR||Smith^Eleanor^Jane||19850614|F
PV1|1|I|CARD_ICU^ROOM_402^BED_B";

    private string ackCode = "AA";
    private string ackExplanation = "Message Accepted Successfully. Downstream database committed the transaction.";
    private string generatedAckMessage = string.Empty;
    private string extractedControlId = "MSG20261011_001";

    protected override void OnInitialized()
    {
        UpdateAckResponse();
    }

    private void SetAckStatus(string code)
    {
        ackCode = code;
        if (code == "AA")
        {
            ackExplanation = "Application Accept (AA): Message was validated and committed successfully.";
        }
        else if (code == "AE")
        {
            ackExplanation = "Application Error (AE): Message syntax passed, but a business rule failed (e.g. invalid doctor ID or unknown ward).";
        }
        else
        {
            ackExplanation = "Application Reject (AR): System is offline, paused, or schema completely unreadable. Sender should retry.";
        }
        UpdateAckResponse();
    }

    private void UpdateAckResponse()
    {
        extractedControlId = "MSG_UNKNOWN";
        var lines = inboundMessage.Split('\n');
        foreach (var l in lines)
        {
            var trimmed = l.Trim();
            if (trimmed.StartsWith("MSH"))
            {
                var parts = trimmed.Split('|');
                if (parts.Length > 10)
                {
                    extractedControlId = parts[10];
                }
            }
        }

        var timestamp = DateTime.UtcNow.ToString("yyyyMMddHHmmss");
        var textNote = ackCode switch
        {
            "AA" => "Message Accepted Successfully",
            "AE" => "Validation Error: Unknown Location Ward in PV1-3",
            _ => "System Busy: Receiver Interface Paused"
        };

        generatedAckMessage = $@"MSH|^~\&|CENTRAL_EHR|METRO_HEALTH|EPIC_ADT|METRO_HOSPITAL|{timestamp}||ACK|ACK_{DateTime.UtcNow.Ticks % 100000}|P|2.5
MSA|{ackCode}|{extractedControlId}|{textNote}";
    }

    private string GetHexRepresentation(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        var sample = text.Length > 20 ? text.Substring(0, 20) + "..." : text;
        var bytes = System.Text.Encoding.ASCII.GetBytes(sample);
        return string.Join(" ", bytes.Select(b => b.ToString("X2")));
    }

    private string GetAckAlertClass() => ackCode switch
    {
        "AA" => "alert-success",
        "AE" => "alert-warning",
        _ => "alert-danger"
    };

    // Wire Frame Stepper State
    private record WireStepItem(
        string ShortName,
        string StageTitle,
        string Explanation,
        string WireStatus,
        string HighlightedHex,
        string AsciiMeaning,
        string AlertClass
    );

    private int stepperIndex = 0;
    private List<WireStepItem> WireSteps = new()
    {
        new(
            ShortName: "TCP 3-Way Handshake",
            StageTitle: "1. TCP Socket Connection Established",
            Explanation: "The client opens raw TCP connection to server port 2575. Packets SYN -> SYN-ACK -> ACK establish a reliable stream.",
            WireStatus: "Socket Connected: 192.168.1.50:54210 <-> 192.168.1.10:2575",
            HighlightedHex: "<span class='text-muted'>[TCP Flags: SYN, ACK]</span>",
            AsciiMeaning: "TCP Stream Open",
            AlertClass: "alert-info"
        ),
        new(
            ShortName: "Start Block 0x0B",
            StageTitle: "2. Client Sends MLLP Start Block (<SB>)",
            Explanation: "Byte 0x0B (VT, ASCII 11) signals to the receiver buffer that a new clinical message is beginning.",
            WireStatus: "Buffer contains: 1 byte [0x0B]",
            HighlightedHex: "<span class='text-primary fw-bold'>0B</span>",
            AsciiMeaning: "<VT> (Vertical Tab)",
            AlertClass: "alert-primary"
        ),
        new(
            ShortName: "ER7 Payload Stream",
            StageTitle: "3. Streaming HL7 v2 ER7 Payload",
            Explanation: "The ASCII string payload travels across the wire chunk by chunk. Segments terminate with carriage return 0x0D (\\r).",
            WireStatus: "Buffer contains: 180 bytes [0x0B, MSH|^~\\&...]",
            HighlightedHex: "<span class='text-primary'>0B</span> <span class='text-warning'>4D 53 48 7C 5E 7E 5C 26 7C ... 50 49 44 ...</span>",
            AsciiMeaning: "MSH|^~\\&|...\\rPID|1|...\\r",
            AlertClass: "alert-warning"
        ),
        new(
            ShortName: "End Block 0x1C 0x0D",
            StageTitle: "4. Client Sends End Block (<EB><CR>)",
            Explanation: "Bytes 0x1C (FS, ASCII 28) and 0x0D (CR, ASCII 13) declare that message transmission is complete. The server flushes its buffer.",
            WireStatus: "Buffer closed & sealed. Ready for parser.",
            HighlightedHex: "<span class='text-primary'>0B</span> <span class='text-muted'>[Payload]</span> <span class='text-danger fw-bold'>1C 0D</span>",
            AsciiMeaning: "<FS> <CR> (File Separator + Carriage Return)",
            AlertClass: "alert-danger"
        ),
        new(
            ShortName: "Server Ack Reply",
            StageTitle: "5. Server Returns MLLP-Framed ACK",
            Explanation: "The server returns an ACK wrapped in its own 0x0B and 0x1C 0x0D frame containing MSA|AA to confirm receipt.",
            WireStatus: "ACK Frame Transmitted: <0x0B> MSH... MSA|AA... <0x1C><0x0D>",
            HighlightedHex: "<span class='text-success fw-bold'>0B</span> <span class='text-success'>[ACK Payload]</span> <span class='text-success fw-bold'>1C 0D</span>",
            AsciiMeaning: "MSA|AA|MSG20261011_001|Message Accepted",
            AlertClass: "alert-success"
        )
    };

    private void NextWireStep()
    {
        if (stepperIndex < WireSteps.Count - 1) stepperIndex++;
    }

    private void PrevWireStep()
    {
        if (stepperIndex > 0) stepperIndex--;
    }

    private void ResetWireStep()
    {
        stepperIndex = 0;
    }
}
