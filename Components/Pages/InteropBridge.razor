@page "/bridge"
@rendermode InteractiveServer

<PageTitle>HL7 v2 to FHIR Interoperability Bridge</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div>
            <h2 class="h3 fw-bold mb-0"><i class="bi bi-shuffle text-warning"></i> Interoperability Bridge (v2 &rarr; FHIR)</h2>
            <p class="text-muted small mb-0">Interactive visual transformer demonstrating how traditional ER7 feeds map into FHIR R4 Resources.</p>
        </div>
        <div class="btn-group">
            <button class="btn btn-outline-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown">
                Change Scenario
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                @foreach (var p in ClinicalPresets.All)
                {
                    <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => LoadScenario(p.Id)">@p.Title (@p.TriggerEvent)</a></li>
                }
            </ul>
        </div>
    </div>

    <!-- Instructions Banner -->
    <div class="alert alert-primary py-2 px-3 mb-3 d-flex align-items-center small shadow-sm">
        <i class="bi bi-lightbulb-fill text-warning fs-5 me-2"></i>
        <div>
            <strong>Interactive Instructions:</strong>
            Pick a clinical scenario below, then <strong>click any field button in the left box</strong> (e.g. <code>PID-3.1</code>, <code>PID-5</code>, or <code>OBX #1</code>) to see the translation concept and its matching FHIR JSON element!
        </div>
    </div>

    <!-- Scenario Switcher Buttons -->
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small fw-semibold me-1">Scenario:</span>
        @foreach (var p in ClinicalPresets.All)
        {
            <button class="btn btn-sm @(selectedPresetId == p.Id ? "btn-warning fw-semibold text-dark shadow-sm" : "btn-outline-secondary")"
                    @onclick="() => LoadScenario(p.Id)">
                <span class="badge bg-dark me-1">@p.TriggerEvent</span> @p.Title.Split('(')[0].Trim()
            </button>
        }
    </div>

    <!-- Active Field Inspector Card (Sticky / Highlighted) -->
    @if (selectedMapping != null)
    {
        <div class="card border-warning mb-3 shadow-sm bg-warning-subtle">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="fw-bold text-dark">
                        <i class="bi bi-link-45deg fs-5 align-middle"></i> Active Field Mapping: 
                        <span class="badge bg-primary font-monospace ms-1">@selectedMapping.SourceField</span>
                        <i class="bi bi-arrow-right mx-1"></i>
                        <span class="badge bg-success font-monospace">@selectedMapping.TargetFhirPath</span>
                    </div>
                    <button class="btn btn-sm btn-close" @onclick="() => selectedMapping = null"></button>
                </div>
                <div class="row g-2 small">
                    <div class="col-md-4">
                        <div class="p-2 bg-white rounded border h-100">
                            <span class="text-muted d-block fw-semibold">Source (HL7 v2 ER7):</span>
                            <strong>@selectedMapping.SourceLabel:</strong> <code class="text-break">@selectedMapping.SourceValue</code>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 bg-white rounded border h-100">
                            <span class="text-muted d-block fw-semibold">Target (FHIR R4 JSON):</span>
                            <strong>@selectedMapping.TargetLabel:</strong> <code class="text-break">@selectedMapping.TargetValue</code>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 bg-white rounded border h-100">
                            <span class="text-muted d-block fw-semibold">Interoperability Concept:</span>
                            <span>@selectedMapping.ConceptExplanation</span>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(selectedMapping.InteropGotcha))
                {
                    <div class="alert alert-warning mb-0 mt-2 py-1 px-2 small">
                        <strong><i class="bi bi-exclamation-triangle-fill"></i> Real-World Gotcha:</strong> @selectedMapping.InteropGotcha
                    </div>
                }
            </div>
        </div>
    }

    <!-- Side-by-Side Split View -->
    <div class="row g-3 mb-3">
        <!-- HL7 v2 Side -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-primary border-top border-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <div>
                        <span class="badge bg-primary me-2">Source</span>
                        <strong>HL7 v2 ER7 Stream</strong>
                    </div>
                    <span class="badge bg-dark">@currentPreset?.TriggerEvent</span>
                </div>
                <div class="card-body p-2 d-flex flex-column">
                    <div class="p-2 bg-dark text-light rounded font-monospace small mb-2 overflow-auto" style="max-height: 220px; white-space: pre-wrap; word-break: break-all;">
                        @foreach (var line in currentPreset?.Hl7V2Message.Split('\n') ?? Array.Empty<string>())
                        {
                            var trimmed = line.Trim();
                            if (!string.IsNullOrWhiteSpace(trimmed))
                            {
                                <div class="py-1 border-bottom border-secondary">
                                    <span class="text-info fw-bold">@trimmed.Substring(0, Math.Min(3, trimmed.Length))</span>@trimmed.Substring(Math.Min(3, trimmed.Length))
                                </div>
                            }
                        }
                    </div>

                    <h6 class="fw-semibold small text-muted px-1 mt-1 mb-1">Click a field button below to inspect:</h6>
                    <div class="d-flex flex-wrap gap-2 p-1 overflow-auto" style="max-height: 240px;">
                        @foreach (var m in transformationResult.Mappings)
                        {
                            <button class="btn btn-sm text-start font-monospace @(selectedMapping == m ? "btn-warning shadow-sm" : "btn-outline-primary")"
                                    @onclick="() => selectedMapping = m">
                                <strong>@m.SourceField</strong>: <span class="text-truncate d-inline-block align-middle" style="max-width: 160px;">@m.SourceValue</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- FHIR R4 Side -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-success border-top border-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                    <div>
                        <span class="badge bg-success me-2">Target</span>
                        <strong>FHIR R4 JSON Representation</strong>
                    </div>
                    <span class="badge bg-secondary">@transformationResult.FhirResource?.TypeName</span>
                </div>
                <div class="card-body p-0">
                    <pre class="bg-dark text-light p-3 m-0 font-monospace small overflow-auto" 
                         style="max-height: 480px; tab-size: 2; white-space: pre-wrap; word-break: break-all; border-radius: 0 0 var(--bs-card-inner-border-radius) var(--bs-card-inner-border-radius);"><code>@transformationResult.FhirJson</code></pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Mapping Traceability Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold small"><i class="bi bi-table"></i> Complete Transformation Traceability Table</span>
            <span class="badge bg-secondary">@transformationResult.Mappings.Count Active Mappings</span>
        </div>
        <div class="table-responsive w-100" style="max-width: 100%; overflow-x: auto;">
            <table class="table table-hover table-sm mb-0 small text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 110px;">v2 Field</th>
                        <th style="min-width: 140px;">v2 Value</th>
                        <th style="min-width: 180px;">FHIR JSON Path</th>
                        <th style="min-width: 250px;">Pedagogical Concept</th>
                        <th style="min-width: 200px;">Gotcha / Warning</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in transformationResult.Mappings)
                    {
                        <tr class="@(selectedMapping == m ? "table-warning" : "")" style="cursor: pointer;" @onclick="() => selectedMapping = m">
                            <td class="font-monospace fw-semibold text-primary">@m.SourceField</td>
                            <td class="font-monospace text-truncate" style="max-width: 180px;" title="@m.SourceValue">@m.SourceValue</td>
                            <td class="font-monospace fw-semibold text-success text-truncate" style="max-width: 200px;" title="@m.TargetFhirPath">@m.TargetFhirPath</td>
                            <td class="text-wrap" style="max-width: 280px;">@m.ConceptExplanation</td>
                            <td class="text-wrap" style="max-width: 240px;">
                                @if (!string.IsNullOrEmpty(m.InteropGotcha))
                                {
                                    <span class="badge bg-warning-subtle text-dark border border-warning" title="@m.InteropGotcha">
                                        <i class="bi bi-exclamation-triangle"></i> @m.InteropGotcha
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Preset { get; set; }

    private string selectedPresetId = "registration";
    private ClinicalPreset? currentPreset;
    private TransformationResult transformationResult = new();
    private FieldMappingLink? selectedMapping;

    protected override void OnInitialized()
    {
        var targetId = !string.IsNullOrEmpty(Preset) ? Preset : "registration";
        LoadScenario(targetId);
    }

    private void LoadScenario(string presetId)
    {
        selectedPresetId = presetId;
        currentPreset = ClinicalPresets.GetById(presetId);
        
        var parsed = Hl7V2Parser.Parse(currentPreset.Hl7V2Message);
        transformationResult = Hl7ToFhirMapper.MapMessage(parsed);
        
        selectedMapping = transformationResult.Mappings.FirstOrDefault();
    }
}
