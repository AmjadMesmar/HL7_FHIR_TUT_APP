@page "/hospital-flow"
@rendermode InteractiveServer

<PageTitle>Hospital Topology &amp; Message Flow Simulator</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0f5132 0%, #0d6efd 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-light text-dark mb-2 px-3 py-1 fw-semibold">Hospital Systems Architecture</span>
                <h1 class="h2 fw-bold mb-1">Hospital Topology &amp; Clinical Flow Simulator</h1>
                <p class="mb-0 text-white-50">
                    Watch how HL7 v2 ER7 messages and FHIR REST calls travel across hospital departments in real time.
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-warning text-dark align-self-center px-3 py-2 fw-semibold">
                    <i class="bi bi-diagram-3-fill me-1"></i> Multi-Department Topology
                </span>
            </div>
        </div>
    </div>

    <!-- Interactive Clinical Event Trigger Panel -->
    <div class="card shadow-sm border mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
            <span class="fw-bold small text-dark"><i class="bi bi-play-circle text-primary me-1"></i> Trigger a Hospital Event:</span>
            <div class="btn-group btn-group-sm flex-wrap">
                @foreach (var ev in ScenarioFlows)
                {
                    <button class="btn @(currentFlow.Id == ev.Id ? "btn-primary shadow-sm" : "btn-outline-secondary")"
                            @onclick="() => SelectFlow(ev)">
                        <i class="bi @ev.Icon me-1"></i> @ev.Title
                    </button>
                }
            </div>
        </div>
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1">@currentFlow.Title</h5>
                    <p class="text-muted small mb-0">@currentFlow.Description</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetStep">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                    <button class="btn btn-primary btn-sm fw-semibold" @onclick="NextStep" disabled="@(activeStepIndex >= currentFlow.Steps.Count - 1)">
                        <i class="bi bi-step-forward me-1"></i> Next Step (@(activeStepIndex + 1)/@currentFlow.Steps.Count)
                    </button>
                </div>
            </div>

            <!-- Visual Node Topology Diagram -->
            <div class="bg-dark rounded p-3 mb-3 text-light position-relative">
                <div class="row g-2 text-center align-items-center">
                    <!-- EHR Node -->
                    <div class="col">
                        <div class="p-2 rounded border @GetNodeClass("EHR")">
                            <i class="bi bi-hospital fs-4"></i>
                            <div class="fw-bold small mt-1">EHR / HIS</div>
                            <span class="badge bg-light text-dark" style="font-size: 0.65rem;">Epic / Cerner</span>
                        </div>
                    </div>
                    <!-- Arrow 1 -->
                    <div class="col-auto text-muted">
                        <i class="bi bi-arrow-left-right fs-4"></i>
                    </div>
                    <!-- Interface Engine Node -->
                    <div class="col">
                        <div class="p-2 rounded border @GetNodeClass("Engine")">
                            <i class="bi bi-router fs-4 text-warning"></i>
                            <div class="fw-bold small mt-1">Interface Engine</div>
                            <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Mirth / Rhapsody</span>
                        </div>
                    </div>
                    <!-- Arrow 2 -->
                    <div class="col-auto text-muted">
                        <i class="bi bi-arrow-left-right fs-4"></i>
                    </div>
                    <!-- Department Node -->
                    <div class="col">
                        <div class="p-2 rounded border @GetNodeClass("LIS")">
                            <i class="bi bi-eyedropper fs-4 text-info"></i>
                            <div class="fw-bold small mt-1">LIS / Lab System</div>
                            <span class="badge bg-info text-dark" style="font-size: 0.65rem;">Analyzers &amp; Orders</span>
                        </div>
                    </div>
                    <!-- Arrow 3 -->
                    <div class="col-auto text-muted">
                        <i class="bi bi-arrow-left-right fs-4"></i>
                    </div>
                    <!-- FHIR Cloud / Patient App Node -->
                    <div class="col">
                        <div class="p-2 rounded border @GetNodeClass("FHIR")">
                            <i class="bi bi-phone fs-4 text-success"></i>
                            <div class="fw-bold small mt-1">FHIR Gateway &amp; App</div>
                            <span class="badge bg-success" style="font-size: 0.65rem;">SMART on FHIR API</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Step Inspection Card -->
            @{
                var step = currentFlow.Steps[activeStepIndex];
            }
            <div class="card border-primary mb-3 bg-light shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold small">
                        <span class="badge bg-white text-primary me-2">Step @(activeStepIndex + 1) of @currentFlow.Steps.Count</span>
                        @step.Sender &rarr; @step.Receiver: @step.Summary
                    </span>
                    <span class="badge bg-light text-dark font-monospace">@step.Protocol</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <div class="fw-semibold small text-muted mb-1">Wire Payload:</div>
                            <pre class="bg-dark text-light p-2 rounded font-monospace small mb-2 overflow-auto" style="max-height: 140px; white-space: pre-wrap; word-break: break-all;"><code>@step.Payload</code></pre>
                            <div class="small text-muted">
                                <strong>Technical Wire Protocol:</strong> @step.ProtocolDetails
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="fw-semibold small text-muted mb-1">Clinical Meaning &amp; Business Logic:</div>
                            <p class="small text-dark mb-2">@step.Explanation</p>
                            <div class="alert alert-info py-1 px-2 small mb-0">
                                <strong><i class="bi bi-lightbulb"></i> Key Takeaway:</strong> @step.KeyTakeaway
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Complete Step Sequence Timeline -->
            <div class="border rounded p-2 bg-white">
                <div class="fw-bold small text-muted mb-2 px-2">Flow Sequence Timeline:</div>
                <div class="list-group list-group-flush small">
                    @for (int i = 0; i < currentFlow.Steps.Count; i++)
                    {
                        var idx = i;
                        var s = currentFlow.Steps[idx];
                        <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 @(activeStepIndex == idx ? "bg-primary-subtle fw-bold border-start border-primary border-4" : "")"
                           @onclick="() => activeStepIndex = idx">
                            <div>
                                <span class="badge @(activeStepIndex == idx ? "bg-primary" : "bg-secondary") me-2">@(idx + 1)</span>
                                <span>@s.Sender &rarr; @s.Receiver: @s.Summary</span>
                            </div>
                            <span class="badge bg-light text-dark border">@s.Protocol</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private record StepItem(
        string Sender,
        string Receiver,
        string Summary,
        string Protocol,
        string ProtocolDetails,
        string Payload,
        string Explanation,
        string KeyTakeaway
    );

    private record FlowScenario(
        string Id,
        string Title,
        string Icon,
        string Description,
        List<StepItem> Steps
    );

    private List<FlowScenario> ScenarioFlows = new();
    private FlowScenario currentFlow = null!;
    private int activeStepIndex = 0;

    protected override void OnInitialized()
    {
        ScenarioFlows = new List<FlowScenario>
        {
            new FlowScenario(
                Id: "adt_admission",
                Title: "1. Patient Admission (ADT^A01)",
                Icon: "bi-person-plus-fill",
                Description: "Emergency department staff admits Marcus Vance into the ICU Cardiology ward.",
                Steps: new List<StepItem>
                {
                    new StepItem(
                        Sender: "EHR (Registration)",
                        Receiver: "Interface Engine",
                        Summary: "Send ADT^A01 Inpatient Admission",
                        Protocol: "MLLP over TCP:2575",
                        ProtocolDetails: "<0x0B> ASCII ER7 payload <0x1C><0x0D>",
                        Payload: "MSH|^~\\&|EHR_ADMIT|METRO|ENGINE|METRO|20261012104500||ADT^A01|MSG901|P|2.5\rPID|1||MRN450192^^^METRO^MR||Vance^Marcus^T||19720325|M\rPV1|1|I|ICU_CARDIO^ROOM_402^BED_B",
                        Explanation: "The registration workstation creates an admission record. The message contains demographics (PID) and assigned bed location (PV1-3).",
                        KeyTakeaway: "Inpatient admission always carries PV1-2='I' and a bed location so pharmacy and lab systems know where the patient physically is."
                    ),
                    new StepItem(
                        Sender: "Interface Engine",
                        Receiver: "EHR (Registration)",
                        Summary: "Immediate MLLP ACK^A01 (AA)",
                        Protocol: "MLLP over TCP:2575",
                        ProtocolDetails: "Synchronous TCP socket reply",
                        Payload: "MSH|^~\\&|ENGINE|METRO|EHR_ADMIT|METRO|20261012104501||ACK^A01|ACK901|P|2.5\rMSA|AA|MSG901|Admission message received and queued",
                        Explanation: "The interface engine immediately replies with MSA|AA (Application Accept) within milliseconds before dispatching downstream.",
                        KeyTakeaway: "If the engine does not reply within the TCP timeout window (typically 5-10s), the EHR will retry or alert."
                    ),
                    new StepItem(
                        Sender: "Interface Engine",
                        Receiver: "LIS / Lab System",
                        Summary: "Fan-out Broadcast ADT^A01 to Laboratory",
                        Protocol: "MLLP over TCP:2576",
                        ProtocolDetails: "Downstream socket connection to LIS",
                        Payload: "MSH|^~\\&|ENGINE|METRO|LIS_ROCHE|METRO|20261012104502||ADT^A01|MSG902|P|2.5\rPID|1||MRN450192^^^METRO^MR||Vance^Marcus^T||19720325|M\rPV1|1|I|ICU_CARDIO^ROOM_402^BED_B",
                        Explanation: "The interface engine forwards the patient identity and room location to the LIS so future blood samples can be verified against an admitted patient.",
                        KeyTakeaway: "Without ADT fan-out, lab analyzers will reject tubes as 'Unknown Patient'."
                    ),
                    new StepItem(
                        Sender: "Interface Engine",
                        Receiver: "FHIR Gateway",
                        Summary: "Translate v2 ADT to FHIR Encounter & Patient Resource",
                        Protocol: "HTTPS REST POST /Encounter",
                        ProtocolDetails: "HTTP 201 Created with JSON Body",
                        Payload: "POST /Encounter HTTP/1.1\r\nContent-Type: application/fhir+json\r\n\r\n{\"resourceType\":\"Encounter\",\"status\":\"in-progress\",\"class\":{\"code\":\"IMP\"},\"subject\":{\"reference\":\"Patient/MRN450192\"}}",
                        Explanation: "The engine transforms the PV1 segment into a FHIR R4 Encounter resource and persists it into the enterprise FHIR clinical data repository.",
                        KeyTakeaway: "Modern hospitals use the interface engine as a live bridge between 1989 ER7 socket feeds and cloud FHIR REST APIs."
                    )
                }
            ),
            new FlowScenario(
                Id: "lab_order_result",
                Title: "2. Lab Order (ORM) & Result (ORU)",
                Icon: "bi-eyedropper",
                Description: "Physician orders a Cardiac Troponin blood test; LIS analyzer processes blood and returns elevated results.",
                Steps: new List<StepItem>
                {
                    new StepItem(
                        Sender: "EHR (Physician Order)",
                        Receiver: "Interface Engine",
                        Summary: "Send ORM^O01 Diagnostic Order",
                        Protocol: "MLLP over TCP:2575",
                        ProtocolDetails: "Order Placed (ORC-1=NW)",
                        Payload: "MSH|^~\\&|EHR_CPOE|METRO|ENGINE|METRO|20261012110000||ORM^O01|ORD101|P|2.5\rPID|1||MRN450192^^^METRO^MR||Vance^Marcus\rORC|NW|ORD-2026-991|||||STAT\rOBR|1|ORD-2026-991||49563-0^Cardiac Troponin I^LN||||||||||||DOC881^Cardio^Sarah",
                        Explanation: "Doctor places a STAT Troponin order. ORC-1='NW' means New Order. OBR-4 contains the LOINC test code 49563-0.",
                        KeyTakeaway: "The Placer Order Number (ORD-2026-991) allows all systems to track this specific blood draw."
                    ),
                    new StepItem(
                        Sender: "Interface Engine",
                        Receiver: "LIS Analyzer",
                        Summary: "Route ORM^O01 to Roche Cobas Lab Instrument",
                        Protocol: "MLLP over TCP:2580",
                        ProtocolDetails: "Barcode scan & analyzer queue",
                        Payload: "MSH|^~\\&|ENGINE|METRO|ROCHE_COBAS|METRO|20261012110001||ORM^O01|ORD102|P|2.5\rPID|1||MRN450192^^^METRO^MR\rORC|NW|ORD-2026-991\rOBR|1|ORD-2026-991||49563-0^Cardiac Troponin I^LN",
                        Explanation: "The analyzer prints a barcoded tube label matching the placer order number.",
                        KeyTakeaway: "Phlebotomists draw blood, slap the barcode on the tube, and insert it into the centrifuge/analyzer."
                    ),
                    new StepItem(
                        Sender: "LIS Analyzer",
                        Receiver: "Interface Engine",
                        Summary: "Analyzer reports ORU^R01 Final Result",
                        Protocol: "MLLP over TCP:2575",
                        ProtocolDetails: "Observation Result Unsolicited (OBX Segment)",
                        Payload: "MSH|^~\\&|ROCHE_COBAS|METRO|ENGINE|METRO|20261012112200||ORU^R01|RES501|P|2.5\rPID|1||MRN450192^^^METRO^MR\rOBR|1|ORD-2026-991|FIL-771|49563-0^Cardiac Troponin I^LN|||||||||||||F\rOBX|1|NM|49563-0^Cardiac Troponin I^LN||0.82|ng/mL|0.00-0.04|H|||F",
                        Explanation: "The lab analyzer finishes chemistry analysis. OBX-5 is 0.82 ng/mL (High flag 'H' in OBX-8, critical cardiac threshold exceeded).",
                        KeyTakeaway: "OBR-25='F' flags that this is a Finalized result, not a preliminary test."
                    ),
                    new StepItem(
                        Sender: "Interface Engine",
                        Receiver: "FHIR Gateway",
                        Summary: "Persist FHIR Observation with Critical High Flag",
                        Protocol: "HTTPS REST POST /Observation",
                        ProtocolDetails: "Firely JSON with UCUM unit ng/mL",
                        Payload: "POST /Observation HTTP/1.1\r\nContent-Type: application/fhir+json\r\n\r\n{\"resourceType\":\"Observation\",\"status\":\"final\",\"code\":{\"coding\":[{\"system\":\"http://loinc.org\",\"code\":\"49563-0\"}]},\"valueQuantity\":{\"value\":0.82,\"unit\":\"ng/mL\"},\"interpretation\":[{\"coding\":[{\"code\":\"H\"}]}]}",
                        Explanation: "The interface engine pushes the Observation to the FHIR server, triggering immediate push notification to the cardiologist's smartphone.",
                        KeyTakeaway: "FHIR enables modern mobile notifications for critical clinical flags in sub-seconds."
                    )
                }
            ),
            new FlowScenario(
                Id: "smart_app_query",
                Title: "3. Patient App Queries FHIR Server",
                Icon: "bi-phone-fill",
                Description: "Patient opens their mobile health portal (Apple Health / Epic MyChart) to view their lab results.",
                Steps: new List<StepItem>
                {
                    new StepItem(
                        Sender: "FHIR Gateway & App",
                        Receiver: "EHR Auth Server",
                        Summary: "OAuth2 Authorization with SMART on FHIR Token",
                        Protocol: "HTTPS POST /oauth/token",
                        ProtocolDetails: "Bearer JWT with scope 'patient/Observation.read'",
                        Payload: "POST /oauth/token HTTP/1.1\r\nHost: fhir.hospital.org\r\n\r\ngrant_type=authorization_code&code=spl964&client_id=my_health_app",
                        Explanation: "The mobile app requests a delegated access token using the patient's authenticated biometric login.",
                        KeyTakeaway: "Unlike HL7 v2 which lacks authorization headers, FHIR mandates standard OAuth2 access tokens."
                    ),
                    new StepItem(
                        Sender: "FHIR Gateway & App",
                        Receiver: "FHIR Gateway",
                        Summary: "GET /Observation?subject=MRN450192&_sort=-date",
                        Protocol: "HTTPS GET /Observation",
                        ProtocolDetails: "RESTful JSON query with sorting & pagination",
                        Payload: "GET /Observation?subject=Patient/MRN450192&code=49563-0&_count=5 HTTP/1.1\r\nAuthorization: Bearer eyJhbGci...\r\nAccept: application/fhir+json",
                        Explanation: "The app asks for the patient's most recent cardiac lab results.",
                        KeyTakeaway: "REST enables precise URL querying without needing full message socket connections."
                    ),
                    new StepItem(
                        Sender: "FHIR Gateway",
                        Receiver: "FHIR Gateway & App",
                        Summary: "Return FHIR Bundle (Searchset)",
                        Protocol: "HTTPS 200 OK",
                        ProtocolDetails: "FHIR Bundle containing matched Observations",
                        Payload: "HTTP/1.1 200 OK\r\nContent-Type: application/fhir+json\r\n\r\n{\"resourceType\":\"Bundle\",\"type\":\"searchset\",\"total\":1,\"entry\":[{\"resource\":{\"resourceType\":\"Observation\",\"valueQuantity\":{\"value\":0.82,\"unit\":\"ng/mL\"}}}]}",
                        Explanation: "The server returns a JSON Bundle. The mobile app renders an easy-to-read graph showing the patient's elevated troponin reading.",
                        KeyTakeaway: "This completes the full cycle: from 1989 ER7 on hospital wires to 2026 mobile apps on patients' phones."
                    )
                }
            )
        };

        currentFlow = ScenarioFlows[0];
    }

    private void SelectFlow(FlowScenario flow)
    {
        currentFlow = flow;
        activeStepIndex = 0;
    }

    private void NextStep()
    {
        if (activeStepIndex < currentFlow.Steps.Count - 1)
        {
            activeStepIndex++;
        }
    }

    private void ResetStep()
    {
        activeStepIndex = 0;
    }

    private string GetNodeClass(string nodeName)
    {
        var step = currentFlow.Steps[activeStepIndex];
        bool isActive = (nodeName == "EHR" && (step.Sender.Contains("EHR") || step.Receiver.Contains("EHR"))) ||
                       (nodeName == "Engine" && (step.Sender.Contains("Engine") || step.Receiver.Contains("Engine"))) ||
                       (nodeName == "LIS" && (step.Sender.Contains("LIS") || step.Receiver.Contains("LIS"))) ||
                       (nodeName == "FHIR" && (step.Sender.Contains("FHIR") || step.Receiver.Contains("FHIR")));

        return isActive
            ? "border-warning border-3 bg-primary text-white shadow"
            : "border-secondary bg-dark-subtle text-light opacity-75";
    }
}
