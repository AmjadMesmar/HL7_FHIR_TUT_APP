    private IEnumerable<TerminologyEntry> FilteredEntries => AllEntries
        .Where(e => activeCategory == "All" || e.Category == activeCategory)
        .Where(e => string.IsNullOrWhiteSpace(searchTerm) ||
                    e.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    e.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (e.NameAr != null && e.NameAr.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    e.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (e.DescriptionAr != null && e.DescriptionAr.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    e.ClinicalDetails.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private string GetCategoryBadge(string category) => category switch
    {
        "LOINC" => "bg-primary",
        "ICD-10" => "bg-danger",
        _ => "bg-warning text-dark"
    };

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
