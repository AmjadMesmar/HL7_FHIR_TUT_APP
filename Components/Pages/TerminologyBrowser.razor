@page "/terminology"
@rendermode InteractiveServer
@implements IDisposable
@inject LanguageService Lang

<PageTitle>@(Lang.IsRtl ? "مستعرض المصطلحات السريرية - LOINC و ICD-10 وجداول HL7" : "Clinical Terminology Browser - LOINC, ICD-10 & HL7 Tables")</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #491217 0%, #d63384 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-light text-dark mb-2 px-3 py-1 fw-semibold">
                    @(Lang.IsRtl ? "المعاجم والمصطلحات السريرية القياسية" : "Clinical Vocabularies")
                </span>
                <h1 class="h2 fw-bold mb-1">
                    @(Lang.IsRtl ? "مستعرض المصطلحات السريرية وجداول HL7 القياسية" : "Clinical Terminology & Standard Tables Browser")
                </h1>
                <p class="mb-0 text-white-50">
                    @(Lang.IsRtl ? "بحث فوري سريع عن رموز تحاليل LOINC المخبرية، وتشخيصات ICD-10، وجداول معايير HL7 الدولية."
                                 : "Rapid in-app lookup for LOINC laboratory test codes, ICD-10 diagnoses, and HL7 standard tables.")
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-white text-dark align-self-center px-3 py-2 fw-semibold">
                    <i class="bi bi-search me-1"></i> @(Lang.IsRtl ? "مرجع سريع" : "Quick Reference")
                </span>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card shadow-sm mb-3 border">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-7">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" 
                               placeholder="@(Lang.IsRtl ? "ابحث بالاسم أو الرمز أو الوصف (مثل Glucose، سكر، I21.0، تنويم، 2345-7)..." : "Search by name, code, or description (e.g. Glucose, I21.0, Inpatient, 2345-7)...")" 
                               @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="btn-group btn-group-sm w-100">
                        <button class="btn @(activeCategory == "All" ? "btn-dark" : "btn-outline-secondary")" @onclick='() => activeCategory = "All"'>
                            @(Lang.IsRtl ? "الكل" : "All")
                        </button>
                        <button class="btn @(activeCategory == "LOINC" ? "btn-primary" : "btn-outline-primary")" @onclick='() => activeCategory = "LOINC"'>
                            LOINC @(Lang.IsRtl ? "(المختبرات)" : "(Labs)")
                        </button>
                        <button class="btn @(activeCategory == "ICD-10" ? "btn-danger" : "btn-outline-danger")" @onclick='() => activeCategory = "ICD-10"'>
                            ICD-10 @(Lang.IsRtl ? "(التشخيصات)" : "(Diagnoses)")
                        </button>
                        <button class="btn @(activeCategory == "HL7 Tables" ? "btn-warning text-dark" : "btn-outline-warning")" @onclick='() => activeCategory = "HL7 Tables"'>
                            @(Lang.IsRtl ? "جداول HL7" : "HL7 Tables")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card shadow-sm border mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold small">
                @(Lang.IsRtl ? $"عرض {FilteredEntries.Count()} مدخلاً من المعاجم السريرية" : $"Showing {FilteredEntries.Count()} Terminology Entries")
            </span>
            <span class="badge bg-secondary">@(Lang.IsRtl ? "معاجم عالمية موحدة" : "Universal Vocabularies")</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0 small text-nowrap">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%;">@(Lang.IsRtl ? "الرمز القياسي" : "Standard Code")</th>
                        <th style="width: 15%;">@(Lang.IsRtl ? "الفئة" : "Category")</th>
                        <th style="width: 35%;">@(Lang.IsRtl ? "الاسم الرسمي والمعنى" : "Official Name / Meaning")</th>
                        <th style="width: 35%;">@(Lang.IsRtl ? "السياق السريري والوحدات والمدى" : "Clinical Context / Units / Reference")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in FilteredEntries)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-primary" style="direction: ltr !important; unicode-bidi: isolate;">@item.Code</td>
                            <td><span class="badge @GetCategoryBadge(item.Category)">@item.Category</span></td>
                            <td class="text-wrap" style="max-width: 320px;">
                                <strong class="text-dark">@(Lang.IsRtl && !string.IsNullOrEmpty(item.NameAr) ? item.NameAr : item.Name)</strong>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="text-muted" style="font-size: 0.78rem;">
                                        @(Lang.IsRtl && !string.IsNullOrEmpty(item.DescriptionAr) ? item.DescriptionAr : item.Description)
                                    </div>
                                }
                            </td>
                            <td class="text-wrap text-muted" style="max-width: 320px;">
                                @(Lang.IsRtl && !string.IsNullOrEmpty(item.ClinicalDetailsAr) ? item.ClinicalDetailsAr : item.ClinicalDetails)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
