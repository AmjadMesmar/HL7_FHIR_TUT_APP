@page "/war-room"
@rendermode InteractiveServer
@implements IDisposable
@inject LanguageService Lang

<PageTitle>@(Lang.IsRtl ? "غرفة عمليات الإنتاج - محاكي أعطال الأنظمة الصحية" : "Production War Room - Healthcare Bug Simulator")</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #842029 0%, #343a40 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-danger mb-2 px-3 py-1 fw-semibold">
                    @(Lang.IsRtl ? "محاكي استكشاف وإصلاح أعطال المناوبة الطارئة" : "On-Call Troubleshooting Simulator")
                </span>
                <h1 class="h2 fw-bold mb-1">
                    @(Lang.IsRtl ? "غرفة عمليات الإنتاج (مختبر كشف وإصلاح الأخطاء السريرية)" : "The Production War Room (Break & Fix Lab)")
                </h1>
                <p class="mb-0 text-white-50">
                    @(Lang.IsRtl ? "حوادث مستشفيات حقيقية، وكوارث تكامل الأنظمة، والحالات النادرة التي تحدث في بيئات الإنتاج الحية."
                                 : "Real hospital incidents, integration disasters, and weird edge cases that happen in live production systems.")
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-warning text-dark align-self-center px-3 py-2 fw-semibold">
                    <i class="bi bi-shield-slash-fill me-1"></i> @(Lang.IsRtl ? "قصص واقعية من المستشفيات" : "Real War Stories")
                </span>
            </div>
        </div>
    </div>

    <!-- Mode Switcher -->
    <div class="card shadow-sm border mb-3 bg-light">
        <div class="card-body p-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="btn-group btn-group-sm">
                <button class="btn @(warRoomMode == "stories" ? "btn-danger fw-bold" : "btn-outline-secondary")" @onclick='() => warRoomMode = "stories"'>
                    <i class="bi bi-book me-1"></i> @(Lang.IsRtl ? "حوادث واقعية (5 قصص موثقة)" : "Real War Incidents (5 Stories)")
                </button>
                <button class="btn @(warRoomMode == "challenges" ? "btn-danger fw-bold" : "btn-outline-secondary")" @onclick='() => warRoomMode = "challenges"'>
                    <i class="bi bi-controller me-1"></i> @(Lang.IsRtl ? $"حلبة تحديات إصلاح الأخطاء ({SolvedCount}/{Challenges.Count} منجز)" : $"Fix-The-Bug Challenge Arena ({SolvedCount}/{Challenges.Count} Solved)")
                </button>
            </div>
            <span class="badge bg-dark">@(Lang.IsRtl ? "محاكي تفاعلي لاستكشاف الأعطال" : "Interactive Debugging Simulator")</span>
        </div>
    </div>

    @if (warRoomMode == "stories")
    {
        <!-- Incident Selector Buttons -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            @for (int b = 0; b < Incidents.Count; b++)
            {
                var idx = b;
                var inc = Incidents[idx];
                <button class="btn btn-sm @(selectedIncidentIndex == idx ? "btn-danger fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                        @onclick="() => { selectedIncidentIndex = idx; showFixedVersion = false; }">
                    <span class="badge bg-dark me-1">#@(idx + 1)</span> @(Lang.IsRtl && !string.IsNullOrEmpty(inc.ShortTitleAr) ? inc.ShortTitleAr : inc.ShortTitle)
                </button>
            }
        </div>

        <!-- Active Incident Card -->
        <div class="card shadow-sm border-danger border-top border-3">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
                <div>
                    <span class="badge bg-danger me-2">@(Lang.IsRtl ? $"حادثة #{selectedIncidentIndex + 1}" : $"Incident #{selectedIncidentIndex + 1}")</span>
                    <strong class="text-dark">@(Lang.IsRtl && !string.IsNullOrEmpty(curInc.FullTitleAr) ? curInc.FullTitleAr : curInc.FullTitle)</strong>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-dark">@(Lang.IsRtl ? "الفئة:" : "Category:") @(Lang.IsRtl && !string.IsNullOrEmpty(curInc.CategoryAr) ? curInc.CategoryAr : curInc.Category)</span>
                    <button class="btn btn-sm @(showFixedVersion ? "btn-success" : "btn-outline-danger") fw-semibold"
                            @onclick="() => showFixedVersion = !showFixedVersion">
                        <i class="bi @(showFixedVersion ? "bi-check-circle-fill" : "bi-wrench-adjustable") me-1"></i>
                        @(showFixedVersion 
                            ? (Lang.IsRtl ? "معاينة: النسخة المصححة" : "Showing: FIXED Version") 
                            : (Lang.IsRtl ? "انقر لعرض الحل" : "Click to View FIX"))
                    </button>
                </div>
            </div>
            <div class="card-body p-3">
                <!-- Clinical Hazard Alert -->
                <div class="alert alert-danger py-2 px-3 small mb-3">
                    <div class="fw-bold mb-1">
                        <i class="bi bi-exclamation-octagon-fill text-danger me-1"></i> 
                        @(Lang.IsRtl ? "الخطر السريري وتأثيره المباشر على رعاية المرضى:" : "Clinical Hazard & Business Impact:")
                    </div>
                    <div>@(Lang.IsRtl && !string.IsNullOrEmpty(curInc.HazardExplanationAr) ? curInc.HazardExplanationAr : curInc.HazardExplanation)</div>
                </div>

                <!-- Code Comparison View -->
                <div class="row g-3 mb-3">
                    <div class="col-lg-6">
                        <div class="card border-danger h-100">
                            <div class="card-header bg-danger-subtle text-danger py-1 fw-bold small">
                                <i class="bi bi-x-circle-fill me-1"></i> @(Lang.IsRtl ? "الحمولة المعطوبة (الخطأ البرمجي)" : "Broken Payload (The Bug)")
                            </div>
                            <div class="card-body p-2 bg-dark text-light font-monospace small" style="direction: ltr !important; text-align: left !important; unicode-bidi: isolate;">
                                <pre class="m-0 text-danger-emphasis overflow-auto" style="white-space: pre-wrap; word-break: break-all; max-height: 200px;"><code>@curInc.BrokenPayload</code></pre>
                            </div>
                            <div class="card-footer bg-light p-2 small text-danger">
                                <strong>@(Lang.IsRtl ? "سبب الفشل الهندسي:" : "Why it fails:")</strong> 
                                @(Lang.IsRtl && !string.IsNullOrEmpty(curInc.FailureRootCauseAr) ? curInc.FailureRootCauseAr : curInc.FailureRootCause)
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="card border-success h-100">
                            <div class="card-header bg-success-subtle text-success py-1 fw-bold small">
                                <i class="bi bi-check-circle-fill me-1"></i> @(Lang.IsRtl ? "الحمولة المصححة (الحل المعتمد)" : "Corrected Payload (The Fix)")
                            </div>
                            <div class="card-body p-2 bg-dark text-light font-monospace small" style="direction: ltr !important; text-align: left !important; unicode-bidi: isolate;">
                                <pre class="m-0 text-success-emphasis overflow-auto" style="white-space: pre-wrap; word-break: break-all; max-height: 200px;"><code>@curInc.FixedPayload</code></pre>
                            </div>
                            <div class="card-footer bg-light p-2 small text-success">
                                <strong>@(Lang.IsRtl ? "الحل الهندسي المعتمد:" : "The Engineering Solution:")</strong> 
                                @(Lang.IsRtl && !string.IsNullOrEmpty(curInc.FixExplanationAr) ? curInc.FixExplanationAr : curInc.FixExplanation)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Production Best Practice Recommendation -->
                <div class="card bg-light border">
                    <div class="card-body p-2 small">
                        <strong class="text-primary">
                            <i class="bi bi-lightbulb-fill text-warning me-1"></i> 
                            @(Lang.IsRtl ? "القاعدة الوقائية الإلزامية لفريقك في بيئة الإنتاج:" : "Production Guardrail Rule for Your Team:")
                        </strong>
                        <div class="text-muted mt-1">
                            @(Lang.IsRtl && !string.IsNullOrEmpty(curInc.GuardrailRuleAr) ? curInc.GuardrailRuleAr : curInc.GuardrailRule)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- CHALLENGE ARENA VIEW -->
        <div class="row g-3">
            <!-- Left Challenge List -->
            <div class="col-lg-4">
                <div class="card shadow-sm border mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <strong class="small text-dark">
                            <i class="bi bi-list-check text-primary me-1"></i> 
                            @(Lang.IsRtl ? "الألغاز والتحديات التفاعلية" : "Interactive Puzzles")
                        </strong>
                        <span class="badge bg-success">@SolvedCount / @Challenges.Count @(Lang.IsRtl ? "مكتمل" : "Solved")</span>
                    </div>
                    <div class="list-group list-group-flush small">
                        @for (int c = 0; c < Challenges.Count; c++)
                        {
                            var cIdx = c;
                            var ch = Challenges[cIdx];
                            <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 @(selectedChallengeIndex == cIdx ? "bg-primary-subtle fw-bold" : "")"
                               @onclick="() => SelectChallenge(cIdx)">
                                <div>
                                    <span class="badge @(ch.IsSolved ? "bg-success" : "bg-secondary") me-2">
                                        <i class="bi @(ch.IsSolved ? "bi-check-lg" : "bi-puzzle")"></i>
                                    </span>
                                    <span>#@(cIdx + 1) @(Lang.IsRtl && !string.IsNullOrEmpty(ch.TitleAr) ? ch.TitleAr : ch.Title)</span>
                                </div>
                                @if (ch.IsSolved)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">@(Lang.IsRtl ? "محلول" : "SOLVED")</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small">
                    <strong><i class="bi bi-lightbulb me-1"></i> @(Lang.IsRtl ? "كيف تعمل الحلبة:" : "How It Works:")</strong>
                    @(Lang.IsRtl ? "اقرأ سيناريو الخطأ في المستشفى، افحص الشفرة المعطوبة، أصلح البنية النحوية في المحرر، وانقر على 'تحقق من الحل'!"
                                 : "Read the hospital error scenario, inspect the broken code, fix the syntax in the editor, and click Verify Solution!")
                </div>
            </div>

            <!-- Right Interactive Puzzle Workspace -->
            <div class="col-lg-8">
                <div class="card shadow-sm border h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
                        <div>
                            <span class="badge bg-danger me-2">@(Lang.IsRtl ? $"تحدي #{selectedChallengeIndex + 1}" : $"Challenge #{selectedChallengeIndex + 1}")</span>
                            <strong class="text-dark">@(Lang.IsRtl && !string.IsNullOrEmpty(curCh.TitleAr) ? curCh.TitleAr : curCh.Title)</strong>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetChallenge">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> @(Lang.IsRtl ? "إعادة ضبط الشفرة" : "Reset Code")
                            </button>
                            <button class="btn btn-success btn-sm fw-bold px-3" @onclick="VerifyCurrentChallenge">
                                <i class="bi bi-play-fill me-1"></i> @(Lang.IsRtl ? "تحقق من الحل" : "Verify Solution")
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <!-- Problem Description -->
                        <div class="alert alert-warning py-2 px-3 small mb-2">
                            <strong><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> @(Lang.IsRtl ? "المشكلة:" : "Problem:")</strong>
                            <div>@(Lang.IsRtl && !string.IsNullOrEmpty(curCh.DescriptionAr) ? curCh.DescriptionAr : curCh.Description)</div>
                        </div>

                        <!-- Verification Result Alert -->
                        @if (curCh.VerificationStatus != null)
                        {
                            <div class="alert @(curCh.IsSolved ? "alert-success" : "alert-danger") py-2 px-3 small mb-2 d-flex align-items-center gap-2">
                                <i class="bi @(curCh.IsSolved ? "bi-check-circle-fill text-success fs-5" : "bi-x-circle-fill text-danger fs-5")"></i>
                                <div>@curCh.VerificationStatus</div>
                            </div>
                        }

                        <label class="form-label small fw-semibold text-muted mb-1">@(Lang.IsRtl ? "محرر الشفرة التفاعلي:" : "Interactive Code Editor:")</label>
                        <textarea class="form-control font-monospace small flex-grow-1 mb-2" 
                                  style="min-height: 160px; resize: vertical; direction: ltr !important; text-align: left !important; unicode-bidi: isolate;" 
                                  @bind="curCh.CurrentCode"></textarea>

                        <!-- Collapsible Hint -->
                        <div class="p-2 bg-light rounded border small">
                            <div class="d-flex justify-content-between align-items-center cursor-pointer" @onclick="() => showHint = !showHint">
                                <span class="fw-semibold text-primary">
                                    <i class="bi bi-info-circle me-1"></i> 
                                    @(Lang.IsRtl ? "هل تحتاج إلى تلميح؟ انقر هنا" : "Need a Hint? Click Here")
                                </span>
                                <i class="bi @(showHint ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </div>
                            @if (showHint)
                            {
                                <div class="mt-2 text-muted border-top pt-2" style="font-size: 0.8rem;">
                                    @(Lang.IsRtl && !string.IsNullOrEmpty(curCh.HintAr) ? curCh.HintAr : curCh.Hint)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string warRoomMode = "stories";
    private int selectedIncidentIndex = 0;
    private bool showFixedVersion = false;
    private WarIncident curInc => Incidents[selectedIncidentIndex];

    private int selectedChallengeIndex = 0;
    private bool showHint = false;
    private BugChallenge curCh => Challenges.Count > 0 ? Challenges[selectedChallengeIndex] : null!;

    private class BugChallenge
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string InitialCode { get; set; } = "";
        public string CurrentCode { get; set; } = "";
        public string Hint { get; set; } = "";
        public string? TitleAr { get; set; }
        public string? DescriptionAr { get; set; }
        public string? HintAr { get; set; }
        public bool IsSolved { get; set; }
        public string? VerificationStatus { get; set; }
        public Func<string, (bool Passed, string Message)> Validator { get; set; } = null!;
    }

    private List<BugChallenge> Challenges = new();
    private int SolvedCount => Challenges.Count(c => c.IsSolved);

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        Challenges = new List<BugChallenge>
        {
            new BugChallenge
            {
                Title = "Fix Truncated MSH-7 Timestamp",
                TitleAr = "إصلاح ختم MSH-7 الزمني المبتور",
                Description = "A chemistry analyzer transmitted MSH-7 as '2026101112' (only 10 digits without minutes and seconds). The hospital engine rejected the packet. Fix MSH-7 to be a valid 14-digit HL7 timestamp (e.g. 20261011123000).",
                DescriptionAr = "أرسل جهاز تحليل كيمياء الدم ختم MSH-7 كـ '2026101112' (10 أرقام فقط دون دقائق وثوانٍ). رفض محرك المستشفى الرسالة. أصلح MSH-7 ليصبح ختماً زمنياً صحيحاً من 14 رقماً (مثل 20261011123000).",
                InitialCode = "MSH|^~\\&|ROCHE|HOSP_A|EHR|HOSP_A|2026101112||ORU^R01|MSG901|P|2.5\r\nPID|1||MRN1002||Smith^Eleanor||19850614|F",
                CurrentCode = "MSH|^~\\&|ROCHE|HOSP_A|EHR|HOSP_A|2026101112||ORU^R01|MSG901|P|2.5\r\nPID|1||MRN1002||Smith^Eleanor||19850614|F",
                Hint = "In HL7 v2, timestamps in MSH-7 require at least YYYYMMDDHHMMSS format (14 digits: 4 year + 2 month + 2 day + 2 hour + 2 min + 2 sec). Replace '2026101112' with '20261011123000'.",
                HintAr = "يتطلب معيار HL7 v2 في MSH-7 صياغة YYYYMMDDHHMMSS على الأقل (14 رقماً: 4 سنة + 2 شهر + 2 يوم + 2 ساعة + 2 دقيقة + 2 ثانية). استبدل '2026101112' بـ '20261011123000'.",
                Validator = code =>
                {
                    var lines = code.Split('\n');
                    var msh = lines.FirstOrDefault(l => l.Trim().StartsWith("MSH"));
                    if (msh == null) return (false, Lang.IsRtl ? "مقطع MSH مفقود." : "MSH segment missing.");
                    var parts = msh.Trim().Split('|');
                    if (parts.Length < 8) return (false, Lang.IsRtl ? "مقطع MSH لا يحتوي على حقول كافية." : "MSH segment does not have enough fields.");
                    var ts = parts[6].Trim();
                    if (ts.Length >= 14 && ts.All(char.IsDigit)) return (true, Lang.IsRtl ? "ممتاز! الختم الزمني الآن مكتمل ومطابق من 14 رقماً." : "Excellent! Timestamp is now valid YYYYMMDDHHMMSS (14 digits).");
                    return (false, Lang.IsRtl ? $"قيمة MSH-7 '{ts}' تحتوي {ts.Length} أرقام فقط. يجب أن تكون 14 رقماً على الأقل." : $"MSH-7 value '{ts}' is only {ts.Length} digits. It must be at least 14 digits (YYYYMMDDHHMMSS).");
                }
            },
            new BugChallenge
            {
                Title = "Fix Illegal Gender Code in PID-8",
                TitleAr = "إصلاح رمز الجنس غير القانوني في PID-8",
                Description = "A vendor billing interface sent 'PID-8' as 'MALE'. HL7 Table 0001 only permits single-character codes: 'M' (Male), 'F' (Female), 'O' (Other), or 'U' (Unknown). Fix the field to prevent EHR parse crash.",
                DescriptionAr = "أرسلت واجهة فوترة خارجية حقل 'PID-8' كـ 'MALE'. يسمح جدول HL7 0001 برمز حرفي واحد فقط: M أو F أو O أو U. أصلح الحقل لمنع تعطل المحلل السريري.",
                InitialCode = "PID|1||MRN401^^^METRO^MR||Johnson^Robert||19750420|MALE||124 Main St^^Austin^TX^78701",
                CurrentCode = "PID|1||MRN401^^^METRO^MR||Johnson^Robert||19750420|MALE||124 Main St^^Austin^TX^78701",
                Hint = "Change 'MALE' in PID-8 to 'M'. Field 8 is between the birthdate (PID-7) and patient alias (PID-9).",
                HintAr = "غير كلمة 'MALE' في PID-8 إلى الحرف 'M'. الحقل الثامن يقع بين تاريخ الميلاد (PID-7) ومحدد المريض الإضافي.",
                Validator = code =>
                {
                    var lines = code.Split('\n');
                    var pid = lines.FirstOrDefault(l => l.Trim().StartsWith("PID"));
                    if (pid == null) return (false, Lang.IsRtl ? "مقطع PID مفقود." : "PID segment missing.");
                    var parts = pid.Trim().Split('|');
                    if (parts.Length < 9) return (false, Lang.IsRtl ? "مقطع PID لا يحتوي على حقول كافية." : "PID segment does not have enough fields.");
                    var gender = parts[8].Trim().ToUpperInvariant();
                    if (gender is "M" or "F" or "O" or "U") return (true, Lang.IsRtl ? $"نجاح رائع! الرمز '{gender}' معتمد وصحيح وفق جدول HL7 0001." : $"Success! '{gender}' is a valid HL7 Table 0001 administrative sex code.");
                    return (false, Lang.IsRtl ? $"الرمز '{parts[8]}' غير معتمد. يجب أن يكون M أو F أو O أو U." : $"'{parts[8]}' is not a valid HL7 Table 0001 code. Must be M, F, O, or U.");
                }
            },
            new BugChallenge
            {
                Title = "Escape Literal Pipe in Patient Address",
                TitleAr = "حماية فاصل الأنابيب الصريح في عنوان المريض",
                Description = "A registration clerk typed '100 Elm St | Suite 4' into the street address. The unescaped pipe '|' split the address across two fields, corrupting City, State, and Zip coordinates! Replace the raw pipe with the proper HL7 escape operator.",
                DescriptionAr = "أدخل موظف الاستقبال النص '100 Elm St | Suite 4' في عنوان الشارع. أدى الفاصل غير المحمي '|' إلى كسر العنوان عبر حقلين وتدمير إحداثيات المدينة والرمز البريدي! استبدله بمحرف الهروب المعياري.",
                InitialCode = "PID|1||MRN778||Davis^Alice||19910812|F||100 Elm St | Suite 4^^Denver^CO^80203",
                CurrentCode = "PID|1||MRN778||Davis^Alice||19910812|F||100 Elm St | Suite 4^^Denver^CO^80203",
                Hint = "In HL7 v2, a literal pipe must be escaped as '\\F\\'. Replace '|' inside '100 Elm St | Suite 4' with '\\F\\'.",
                HintAr = "في HL7 v2، يجب ترميز الفاصل الصريح كـ '\\F\\'. استبدل '|' داخل العنوان بـ '\\F\\'.",
                Validator = code =>
                {
                    if (code.Contains(@"\F\")) return (true, Lang.IsRtl ? "عمل متقن! الترميز '\\F\\' يحمي الفاصل ويمنع كسر المقطع." : "Great job! '\\F\\' safely encodes the pipe character without splitting the segment.");
                    return (false, Lang.IsRtl ? "لم يتم تحويل الفاصل. استخدم '\\F\\' بدلاً من رمز الأنبوب داخل النص." : "The raw pipe was not escaped. Use '\\F\\' in place of the inner pipe character.");
                }
            },
            new BugChallenge
            {
                Title = "Add Missing MLLP Framing Envelopes",
                TitleAr = "إضافة بايتات تأطير MLLP المفقودة",
                Description = "A new hospital TCP socket listener failed because the payload was sent as bare text without Minimal Lower Layer Protocol (MLLP) framing delimiters. Add '<0x0B>' at the beginning and '<0x1C><0x0D>' at the end.",
                DescriptionAr = "فشل مستقبل مقبس TCP الجديد في المستشفى لأن الحمولة أرسلت كنص خام دون مغلف MLLP. أضف '<0x0B>' في البداية و '<0x1C><0x0D>' في النهاية.",
                InitialCode = "MSH|^~\\&|PAS|METRO|EHR|METRO|20261012100000||ADT^A01|MSG55|P|2.5\r\nPID|1||9001||Lee^David",
                CurrentCode = "MSH|^~\\&|PAS|METRO|EHR|METRO|20261012100000||ADT^A01|MSG55|P|2.5\r\nPID|1||9001||Lee^David",
                Hint = "Wrap the message so it starts with '<0x0B>' and ends with '<0x1C><0x0D>' (or '\\x0B' and '\\x1C\\x0D').",
                HintAr = "غلف الرسالة بحيث تبدأ بـ '<0x0B>' وتنتهي بـ '<0x1C><0x0D>'.",
                Validator = code =>
                {
                    var trimmed = code.Trim();
                    bool hasStart = trimmed.StartsWith("<0x0B>") || trimmed.StartsWith("\x0B") || trimmed.StartsWith("0x0B");
                    bool hasEnd = trimmed.EndsWith("<0x1C><0x0D>") || trimmed.EndsWith("\x1C\x0D") || trimmed.EndsWith("0x1C 0x0D");
                    if (hasStart && hasEnd) return (true, Lang.IsRtl ? "تم تأطير الحزمة بنجاح! سيتعرف خادم MLLP على المنفذ 2575 على حدود الإرسال." : "Packet framed! MLLP receivers on port 2575 will now recognize start and end of transmission.");
                    return (false, Lang.IsRtl ? "يجب أن تبدأ الرسالة بـ '<0x0B>' وتنتهي بـ '<0x1C><0x0D>'." : "Message must begin with '<0x0B>' (Start Block) and terminate with '<0x1C><0x0D>' (End Block + Carriage Return).");
                }
            },
            new BugChallenge
            {
                Title = "Add Missing Required FHIR Observation Status",
                TitleAr = "إضافة حالة الملاحظة الإلزامية في مورد FHIR",
                Description = "A laboratory script pushed a JSON Observation to HAPI FHIR, but the server rejected it with HTTP 422: 'Missing required 1..1 element: status'. Add the required status property with value 'final'.",
                DescriptionAr = "أرسل برنامج مخبري كائن Observation بصيغة JSON إلى خادم HAPI FHIR، لكن الخادم رفضه بالخطأ HTTP 422: 'العنصر الإلزامي status مفقود (1..1)'. أضف خاصية status بالقيمة 'final'.",
                InitialCode = "{\r\n  \"resourceType\": \"Observation\",\r\n  \"code\": {\r\n    \"text\": \"Blood Glucose\"\r\n  },\r\n  \"valueQuantity\": {\r\n    \"value\": 105,\r\n    \"unit\": \"mg/dL\"\r\n  }\r\n}",
                CurrentCode = "{\r\n  \"resourceType\": \"Observation\",\r\n  \"code\": {\r\n    \"text\": \"Blood Glucose\"\r\n  },\r\n  \"valueQuantity\": {\r\n    \"value\": 105,\r\n    \"unit\": \"mg/dL\"\r\n  }\r\n}",
                Hint = "Add '\"status\": \"final\",' right below '\"resourceType\": \"Observation\",'.",
                HintAr = "أضف '\"status\": \"final\",' مباشرة أسفل سطر '\"resourceType\": \"Observation\",'.",
                Validator = code =>
                {
                    if (code.Contains("\"status\"") && (code.Contains("\"final\"") || code.Contains("\"preliminary\"")))
                    {
                        return (true, Lang.IsRtl ? "تم التحقق بنجاح! الخاصية 'status: final' تلبي شرط الإلزام الصارم (1..1) في معيار FHIR R4." : "Verified! 'status: final' satisfies the mandatory FHIR R4 Observation cardinality (1..1).");
                    }
                    return (false, Lang.IsRtl ? "المورد لا يزال يفتقر إلى 'status': 'final'. أضف الخاصية الإلزامية." : "Observation is still missing 'status': 'final'. Add the mandatory status attribute.");
                }
            }
        };
    }

    private void SelectChallenge(int index)
    {
        selectedChallengeIndex = index;
        showHint = false;
    }

    private void ResetChallenge()
    {
        var ch = Challenges[selectedChallengeIndex];
        ch.CurrentCode = ch.InitialCode;
        ch.VerificationStatus = null;
        ch.IsSolved = false;
    }

    private void VerifyCurrentChallenge()
    {
        var ch = Challenges[selectedChallengeIndex];
        var result = ch.Validator(ch.CurrentCode);
        ch.IsSolved = result.Passed;
        ch.VerificationStatus = result.Message;
    }

