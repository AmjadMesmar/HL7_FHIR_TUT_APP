@page "/war-room"
@rendermode InteractiveServer

<PageTitle>Production War Room - Healthcare Bug Simulator</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #842029 0%, #343a40 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-danger mb-2 px-3 py-1 fw-semibold">On-Call Troubleshooting Simulator</span>
                <h1 class="h2 fw-bold mb-1">The Production War Room (Break &amp; Fix Lab)</h1>
                <p class="mb-0 text-white-50">
                    Real hospital incidents, integration disasters, and weird edge cases that happen in live production systems.
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-warning text-dark align-self-center px-3 py-2 fw-semibold">
                    <i class="bi bi-shield-slash-fill me-1"></i> Real War Stories
                </span>
            </div>
        </div>
    </div>

    <!-- Incident Selector Buttons -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        @for (int b = 0; b < Incidents.Count; b++)
        {
            var idx = b;
            var inc = Incidents[idx];
            <button class="btn btn-sm @(selectedIncidentIndex == idx ? "btn-danger fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                    @onclick="() => { selectedIncidentIndex = idx; showFixedVersion = false; }">
                <span class="badge bg-dark me-1">#@(idx + 1)</span> @inc.ShortTitle
            </button>
        }
    </div>

    <!-- Active Incident Card -->
    @{
        var curInc = Incidents[selectedIncidentIndex];
    }
    <div class="card shadow-sm border-danger border-top border-3">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
            <div>
                <span class="badge bg-danger me-2">Incident #@(selectedIncidentIndex + 1)</span>
                <strong class="text-dark">@curInc.FullTitle</strong>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-dark">Category: @curInc.Category</span>
                <button class="btn btn-sm @(showFixedVersion ? "btn-success" : "btn-outline-danger") fw-semibold"
                        @onclick="() => showFixedVersion = !showFixedVersion">
                    <i class="bi @(showFixedVersion ? "bi-check-circle-fill" : "bi-wrench-adjustable") me-1"></i>
                    @(showFixedVersion ? "Showing: FIXED Version" : "Click to View FIX")
                </button>
            </div>
        </div>
        <div class="card-body p-3">
            <!-- Clinical Hazard Alert -->
            <div class="alert alert-danger py-2 px-3 small mb-3">
                <div class="fw-bold mb-1"><i class="bi bi-exclamation-octagon-fill text-danger me-1"></i> Clinical Hazard &amp; Business Impact:</div>
                <div>@curInc.HazardExplanation</div>
            </div>

            <!-- Code Comparison View -->
            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="card border-danger h-100">
                        <div class="card-header bg-danger-subtle text-danger py-1 fw-bold small">
                            <i class="bi bi-x-circle-fill me-1"></i> Broken Payload (The Bug)
                        </div>
                        <div class="card-body p-2 bg-dark text-light font-monospace small">
                            <pre class="m-0 text-danger-emphasis overflow-auto" style="white-space: pre-wrap; word-break: break-all; max-height: 200px;"><code>@curInc.BrokenPayload</code></pre>
                        </div>
                        <div class="card-footer bg-light p-2 small text-danger">
                            <strong>Why it fails:</strong> @curInc.FailureRootCause
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card border-success h-100">
                        <div class="card-header bg-success-subtle text-success py-1 fw-bold small">
                            <i class="bi bi-check-circle-fill me-1"></i> Corrected Payload (The Fix)
                        </div>
                        <div class="card-body p-2 bg-dark text-light font-monospace small">
                            <pre class="m-0 text-success-emphasis overflow-auto" style="white-space: pre-wrap; word-break: break-all; max-height: 200px;"><code>@curInc.FixedPayload</code></pre>
                        </div>
                        <div class="card-footer bg-light p-2 small text-success">
                            <strong>The Engineering Solution:</strong> @curInc.FixExplanation
                        </div>
                    </div>
                </div>
            </div>

            <!-- Production Best Practice Recommendation -->
            <div class="card bg-light border">
                <div class="card-body p-2 small">
                    <strong class="text-primary"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Production Guardrail Rule for Your Team:</strong>
                    <div class="text-muted mt-1">@curInc.GuardrailRule</div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int selectedIncidentIndex = 0;
    private bool showFixedVersion = false;

    private record WarIncident(
        string ShortTitle,
        string FullTitle,
        string Category,
        string HazardExplanation,
        string BrokenPayload,
        string FailureRootCause,
        string FixedPayload,
        string FixExplanation,
        string GuardrailRule
    );

    private static readonly List<WarIncident> Incidents = new()
    {
        // 1. MPI Collision
        new(
            ShortTitle: "Duplicate Chart Collision",
            FullTitle: "The Master Patient Index (MPI) Identifier Collision",
            Category: "Patient Identity / MPI",
            HazardExplanation: "Two regional clinics merge into one hospital network. Both clinics happened to issue patient ID '10042'. Because the interface team omitted PID-3.4 (Assigning Authority), clinic A's chemotherapy plan accidentally linked to a pregnant woman from clinic B!",
            BrokenPayload:
@"PID|1||10042||Miller^Robert||19600101|M
...
PID|1||10042||Johnson^Alice||19920510|F",
            FailureRootCause: "Both patients share ID '10042'. Without an assigning authority namespace, the enterprise MPI treats them as the same human record.",
            FixedPayload:
@"PID|1||10042^^^CLINIC_NORTH^MR||Miller^Robert||19600101|M
...
PID|1||10042^^^CLINIC_SOUTH^MR||Johnson^Alice||19920510|F",
            FixExplanation: "Component 4 (Assigning Authority) provides namespacing. In FHIR, this maps to distinct system URIs: 'http://clinic-north.org/mrn' vs 'http://clinic-south.org/mrn'.",
            GuardrailRule: "Never accept raw patient IDs without an Assigning Authority (PID-3.4) in v2, or a valid 'system' URI in FHIR."
        ),

        // 2. Unescaped Delimiter Crash
        new(
            ShortTitle: "Unescaped Delimiter Crash",
            FullTitle: "Unescaped Pipe Character Crashing the Downstream Parser",
            Category: "Wire Protocol / Syntax",
            HazardExplanation: "A doctor notes: 'Diagnosis: Acute pain | Suspected kidney stone'. The interface sends the note with a literal pipe '|'. The receiving lab system misinterprets the pipe as a field boundary, shifts all subsequent segments, and drops the patient's billing data.",
            BrokenPayload:
@"OBX|1|TX|NOTE^Clinical Note||Pain: Severe | Patient drowsy||||||F",
            FailureRootCause: "The pipe '|' inside 'Severe | Patient' is treated as a field delimiter. The parser looks for Units in OBX-6 and finds 'Patient drowsy', crashing the schema validator.",
            FixedPayload:
@"OBX|1|TX|NOTE^Clinical Note||Pain: Severe \F\ Patient drowsy||||||F",
            FixExplanation: "Using '\\F\\' escapes the pipe so parsers know it is textual content rather than a structural delimiter.",
            GuardrailRule: "Always run outgoing HL7 v2 messages through an escape sanitizer that automatically replaces bare '|', '^', and '~' characters in user inputs."
        ),

        // 3. Timezone Shift
        new(
            ShortTitle: "Timezone Shift Ghost Bug",
            FullTitle: "Birthdate Shifting by One Day Due to Naive UTC Conversion",
            Category: "Data Types & Datetime",
            HazardExplanation: "HL7 v2 sends Eleanor's birthdate as '19850614' (June 14). A developer converts this string into UTC DateTimeOffset (00:00:00 UTC). When a US Pacific clinic opens the chart (UTC-8), the date displays as June 13, 1985 at 16:00! Insurance rejects all pediatric claims due to mismatched DOB.",
            BrokenPayload:
@"// Bad C# converter:
DateTime dt = DateTime.Parse(""19850614"");
patient.BirthDate = dt.ToUniversalTime().ToString(""yyyy-MM-dd"");
// In Pacific Time: outputs '1985-06-13' (OFF BY ONE DAY!)",
            FailureRootCause: "Birth dates are calendar dates, not timestamps! Converting a date-only string through timezones shifts the day boundary.",
            FixedPayload:
@"// Correct C# converter:
// Keep date-only as ISO-8601 string without applying time offsets!
patient.BirthDate = rawDate.Substring(0, 4) + ""-"" + 
                    rawDate.Substring(4, 2) + ""-"" + 
                    rawDate.Substring(6, 2); // '1985-06-14'",
            FixExplanation: "FHIR allows Date strings ('YYYY-MM-DD') without time components. Never append '00:00:00' to a date of birth.",
            GuardrailRule: "Never convert Date of Birth through a UTC DateTime converter. Treat birth dates as timezone-agnostic calendar strings."
        ),

        // 4. Non-Numeric in NM Type
        new(
            ShortTitle: "Non-Numeric in NM Trap",
            FullTitle: "Lab Sending '< 0.01' in a Numeric (NM) OBX Field",
            Category: "Laboratory / OBX",
            HazardExplanation: "A microbiology PCR test returns '< 0.01'. The lab analyzer formats this in an OBX segment with value type 'NM' (Numeric). The receiving EHR executes decimal.Parse('< 0.01'), throws an unhandled System.FormatException, and drops the entire lab result batch!",
            BrokenPayload:
@"OBX|1|NM|1234-5^Viral Load^LN||< 0.01|copies/mL|0-100|N|||F",
            FailureRootCause: "OBX-2 says 'NM' (Numeric), but '< 0.01' is a string comparator, not a pure floating-point number.",
            FixedPayload:
@"// In v2: Send value as String (ST) when comparators exist:
OBX|1|ST|1234-5^Viral Load^LN||< 0.01|copies/mL|0-100|N|||F

// In FHIR: Use Quantity.comparator ('<'):
{
  ""valueQuantity"": {
    ""value"": 0.01,
    ""comparator"": ""<"",
    ""unit"": ""copies/mL""
  }
}",
            FixExplanation: "In FHIR, the Quantity data type provides a dedicated 'comparator' field ('<', '<=', '>=', '>'), preserving both the numeric value and the qualifier cleanly.",
            GuardrailRule: "When parsing OBX-5 with type NM, always use decimal.TryParse() with a regex fallback to extract comparators ('<', '>')."
        ),

        // 5. Missing Trigger Event
        new(
            ShortTitle: "Missing Trigger Event",
            FullTitle: "Sender Transmitting 'ADT' Instead of 'ADT^A01'",
            Category: "Interface Engine Routing",
            HazardExplanation: "A vendor sends 'ADT' in MSH-9 without the component delimiter and trigger event ('ADT^A01'). The hospital interface engine (Mirth) routes by trigger event, doesn't match any rules, and drops the message into an unmonitored dead-letter queue. The patient waits in the ER for 4 hours because the nursing station never received the admit notice.",
            BrokenPayload:
@"MSH|^~\&|OLD_PAS|HOSP|EHR|HOSP|202610111000||ADT|CTRL_001|P|2.3
PID|1||99102||Baker^Tom...",
            FailureRootCause: "MSH-9 must be a CM_MSG composite: MessageType^TriggerEvent (e.g. ADT^A01). Without the trigger event, automated routers cannot determine clinical intent.",
            FixedPayload:
@"MSH|^~\&|OLD_PAS|HOSP|EHR|HOSP|202610111000||ADT^A01|CTRL_001|P|2.3
PID|1||99102||Baker^Tom...",
            FixExplanation: "Adding the trigger event '^A01' allows interface engine filters to route the patient to bed census systems immediately.",
            GuardrailRule: "Validate MSH-9 in your ingestion middleware; if MSH-9.2 is empty, fail-fast and reject the message with an explicit NACK before it gets lost."
        )
    };
}
