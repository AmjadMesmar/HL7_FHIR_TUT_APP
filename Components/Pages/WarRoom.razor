@page "/war-room"
@rendermode InteractiveServer

<PageTitle>Production War Room - Healthcare Bug Simulator</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #842029 0%, #343a40 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-danger mb-2 px-3 py-1 fw-semibold">On-Call Troubleshooting Simulator</span>
                <h1 class="h2 fw-bold mb-1">The Production War Room (Break &amp; Fix Lab)</h1>
                <p class="mb-0 text-white-50">
                    Real hospital incidents, integration disasters, and weird edge cases that happen in live production systems.
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-warning text-dark align-self-center px-3 py-2 fw-semibold">
                    <i class="bi bi-shield-slash-fill me-1"></i> Real War Stories
                </span>
            </div>
        </div>
    </div>

    <!-- Mode Switcher -->
    <div class="card shadow-sm border mb-3 bg-light">
        <div class="card-body p-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="btn-group btn-group-sm">
                <button class="btn @(warRoomMode == "stories" ? "btn-danger fw-bold" : "btn-outline-secondary")" @onclick='() => warRoomMode = "stories"'>
                    <i class="bi bi-book me-1"></i> Real War Incidents (5 Stories)
                </button>
                <button class="btn @(warRoomMode == "challenges" ? "btn-danger fw-bold" : "btn-outline-secondary")" @onclick='() => warRoomMode = "challenges"'>
                    <i class="bi bi-controller me-1"></i> Fix-The-Bug Challenge Arena (@SolvedCount/@Challenges.Count Solved)
                </button>
            </div>
            <span class="badge bg-dark">Interactive Debugging Simulator</span>
        </div>
    </div>

    @if (warRoomMode == "stories")
    {
        <!-- Incident Selector Buttons -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            @for (int b = 0; b < Incidents.Count; b++)
            {
                var idx = b;
                var inc = Incidents[idx];
                <button class="btn btn-sm @(selectedIncidentIndex == idx ? "btn-danger fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                        @onclick="() => { selectedIncidentIndex = idx; showFixedVersion = false; }">
                    <span class="badge bg-dark me-1">#@(idx + 1)</span> @inc.ShortTitle
                </button>
            }
        </div>

        <!-- Active Incident Card -->
        <div class="card shadow-sm border-danger border-top border-3">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
                <div>
                    <span class="badge bg-danger me-2">Incident #@(selectedIncidentIndex + 1)</span>
                <strong class="text-dark">@curInc.FullTitle</strong>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-dark">Category: @curInc.Category</span>
                <button class="btn btn-sm @(showFixedVersion ? "btn-success" : "btn-outline-danger") fw-semibold"
                        @onclick="() => showFixedVersion = !showFixedVersion">
                    <i class="bi @(showFixedVersion ? "bi-check-circle-fill" : "bi-wrench-adjustable") me-1"></i>
                    @(showFixedVersion ? "Showing: FIXED Version" : "Click to View FIX")
                </button>
            </div>
        </div>
        <div class="card-body p-3">
            <!-- Clinical Hazard Alert -->
            <div class="alert alert-danger py-2 px-3 small mb-3">
                <div class="fw-bold mb-1"><i class="bi bi-exclamation-octagon-fill text-danger me-1"></i> Clinical Hazard &amp; Business Impact:</div>
                <div>@curInc.HazardExplanation</div>
            </div>

            <!-- Code Comparison View -->
            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="card border-danger h-100">
                        <div class="card-header bg-danger-subtle text-danger py-1 fw-bold small">
                            <i class="bi bi-x-circle-fill me-1"></i> Broken Payload (The Bug)
                        </div>
                        <div class="card-body p-2 bg-dark text-light font-monospace small">
                            <pre class="m-0 text-danger-emphasis overflow-auto" style="white-space: pre-wrap; word-break: break-all; max-height: 200px;"><code>@curInc.BrokenPayload</code></pre>
                        </div>
                        <div class="card-footer bg-light p-2 small text-danger">
                            <strong>Why it fails:</strong> @curInc.FailureRootCause
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card border-success h-100">
                        <div class="card-header bg-success-subtle text-success py-1 fw-bold small">
                            <i class="bi bi-check-circle-fill me-1"></i> Corrected Payload (The Fix)
                        </div>
                        <div class="card-body p-2 bg-dark text-light font-monospace small">
                            <pre class="m-0 text-success-emphasis overflow-auto" style="white-space: pre-wrap; word-break: break-all; max-height: 200px;"><code>@curInc.FixedPayload</code></pre>
                        </div>
                        <div class="card-footer bg-light p-2 small text-success">
                            <strong>The Engineering Solution:</strong> @curInc.FixExplanation
                        </div>
                    </div>
                </div>
            </div>

            <!-- Production Best Practice Recommendation -->
            <div class="card bg-light border">
                <div class="card-body p-2 small">
                    <strong class="text-primary"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Production Guardrail Rule for Your Team:</strong>
                    <div class="text-muted mt-1">@curInc.GuardrailRule</div>
                </div>
            </div>
        </div>
    </div>
    }
    else
    {
        <!-- CHALLENGE ARENA VIEW -->
        <div class="row g-3">
            <!-- Left Challenge List -->
            <div class="col-lg-4">
                <div class="card shadow-sm border mb-3">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <strong class="small text-dark"><i class="bi bi-list-check text-primary me-1"></i> Interactive Puzzles</strong>
                        <span class="badge bg-success">@SolvedCount / @Challenges.Count Solved</span>
                    </div>
                    <div class="list-group list-group-flush small">
                        @for (int c = 0; c < Challenges.Count; c++)
                        {
                            var cIdx = c;
                            var ch = Challenges[cIdx];
                            <a href="javascript:void(0)" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 @(selectedChallengeIndex == cIdx ? "bg-primary-subtle fw-bold" : "")"
                               @onclick="() => SelectChallenge(cIdx)">
                                <div>
                                    <span class="badge @(ch.IsSolved ? "bg-success" : "bg-secondary") me-2">
                                        <i class="bi @(ch.IsSolved ? "bi-check-lg" : "bi-puzzle")"></i>
                                    </span>
                                    <span>#@(cIdx + 1) @ch.Title</span>
                                </div>
                                @if (ch.IsSolved)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">SOLVED</span>
                                }
                            </a>
                        }
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small">
                    <strong><i class="bi bi-lightbulb"></i> How It Works:</strong>
                    Read the hospital error scenario, inspect the broken code, fix the syntax in the editor, and click <strong>Verify Solution</strong>!
                </div>
            </div>

            <!-- Right Interactive Puzzle Workspace -->
            <div class="col-lg-8">
                <div class="card shadow-sm border h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
                        <div>
                            <span class="badge bg-danger me-2">Challenge #@(selectedChallengeIndex + 1)</span>
                            <strong class="text-dark">@curCh.Title</strong>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetChallenge">
                                <i class="bi bi-arrow-counterclockwise"></i> Reset Code
                            </button>
                            <button class="btn btn-success btn-sm fw-bold px-3" @onclick="VerifyCurrentChallenge">
                                <i class="bi bi-play-fill me-1"></i> Verify Solution
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <!-- Problem Description -->
                        <div class="alert alert-warning py-2 px-3 small mb-2">
                            <strong><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> Problem:</strong>
                            <div>@curCh.Description</div>
                        </div>

                        <!-- Verification Result Alert -->
                        @if (curCh.VerificationStatus != null)
                        {
                            <div class="alert @(curCh.IsSolved ? "alert-success" : "alert-danger") py-2 px-3 small mb-2 d-flex align-items-center gap-2">
                                <i class="bi @(curCh.IsSolved ? "bi-check-circle-fill text-success fs-5" : "bi-x-circle-fill text-danger fs-5")"></i>
                                <div>@curCh.VerificationStatus</div>
                            </div>
                        }

                        <label class="form-label small fw-semibold text-muted mb-1">Interactive Code Editor:</label>
                        <textarea class="form-control font-monospace small flex-grow-1 mb-2" 
                                  style="min-height: 160px; resize: vertical;" 
                                  @bind="curCh.CurrentCode"></textarea>

                        <!-- Collapsible Hint -->
                        <div class="p-2 bg-light rounded border small">
                            <div class="d-flex justify-content-between align-items-center cursor-pointer" @onclick="() => showHint = !showHint">
                                <span class="fw-semibold text-primary"><i class="bi bi-info-circle me-1"></i> Need a Hint? Click Here</span>
                                <i class="bi @(showHint ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            </div>
                            @if (showHint)
                            {
                                <div class="mt-2 text-muted border-top pt-2" style="font-size: 0.8rem;">
                                    @curCh.Hint
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string warRoomMode = "stories";
    private int selectedIncidentIndex = 0;
    private bool showFixedVersion = false;
    private WarIncident curInc => Incidents[selectedIncidentIndex];

    private int selectedChallengeIndex = 0;
    private bool showHint = false;
    private BugChallenge curCh => Challenges.Count > 0 ? Challenges[selectedChallengeIndex] : null!;

    private class BugChallenge
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string InitialCode { get; set; } = "";
        public string CurrentCode { get; set; } = "";
        public string Hint { get; set; } = "";
        public bool IsSolved { get; set; }
        public string? VerificationStatus { get; set; }
        public Func<string, (bool Passed, string Message)> Validator { get; set; } = null!;
    }

    private List<BugChallenge> Challenges = new();
    private int SolvedCount => Challenges.Count(c => c.IsSolved);

    protected override void OnInitialized()
    {
        Challenges = new List<BugChallenge>
        {
            new BugChallenge
            {
                Title = "Fix Truncated MSH-7 Timestamp",
                Description = "A chemistry analyzer transmitted MSH-7 as '2026101112' (only 10 digits without minutes and seconds). The hospital engine rejected the packet. Fix MSH-7 to be a valid 14-digit HL7 timestamp (e.g. 20261011123000).",
                InitialCode = "MSH|^~\\&|ROCHE|HOSP_A|EHR|HOSP_A|2026101112||ORU^R01|MSG901|P|2.5\r\nPID|1||MRN1002||Smith^Eleanor||19850614|F",
                CurrentCode = "MSH|^~\\&|ROCHE|HOSP_A|EHR|HOSP_A|2026101112||ORU^R01|MSG901|P|2.5\r\nPID|1||MRN1002||Smith^Eleanor||19850614|F",
                Hint = "In HL7 v2, timestamps in MSH-7 require at least YYYYMMDDHHMMSS format (14 digits: 4 year + 2 month + 2 day + 2 hour + 2 min + 2 sec). Replace '2026101112' with '20261011123000'.",
                Validator = code =>
                {
                    var lines = code.Split('\n');
                    var msh = lines.FirstOrDefault(l => l.Trim().StartsWith("MSH"));
                    if (msh == null) return (false, "MSH segment missing.");
                    var parts = msh.Trim().Split('|');
                    if (parts.Length < 8) return (false, "MSH segment does not have enough fields.");
                    var ts = parts[6].Trim();
                    if (ts.Length >= 14 && ts.All(char.IsDigit)) return (true, "Excellent! Timestamp is now valid YYYYMMDDHHMMSS (14 digits).");
                    return (false, $"MSH-7 value '{ts}' is only {ts.Length} digits. It must be at least 14 digits (YYYYMMDDHHMMSS).");
                }
            },
            new BugChallenge
            {
                Title = "Fix Illegal Gender Code in PID-8",
                Description = "A vendor billing interface sent 'PID-8' as 'MALE'. HL7 Table 0001 only permits single-character codes: 'M' (Male), 'F' (Female), 'O' (Other), or 'U' (Unknown). Fix the field to prevent EHR parse crash.",
                InitialCode = "PID|1||MRN401^^^METRO^MR||Johnson^Robert||19750420|MALE||124 Main St^^Austin^TX^78701",
                CurrentCode = "PID|1||MRN401^^^METRO^MR||Johnson^Robert||19750420|MALE||124 Main St^^Austin^TX^78701",
                Hint = "Change 'MALE' in PID-8 to 'M'. Field 8 is between the birthdate (PID-7) and patient alias (PID-9).",
                Validator = code =>
                {
                    var lines = code.Split('\n');
                    var pid = lines.FirstOrDefault(l => l.Trim().StartsWith("PID"));
                    if (pid == null) return (false, "PID segment missing.");
                    var parts = pid.Trim().Split('|');
                    if (parts.Length < 9) return (false, "PID segment does not have enough fields.");
                    var gender = parts[8].Trim().ToUpperInvariant();
                    if (gender is "M" or "F" or "O" or "U") return (true, $"Success! '{gender}' is a valid HL7 Table 0001 administrative sex code.");
                    return (false, $"'{parts[8]}' is not a valid HL7 Table 0001 code. Must be M, F, O, or U.");
                }
            },
            new BugChallenge
            {
                Title = "Escape Literal Pipe in Patient Address",
                Description = "A registration clerk typed '100 Elm St | Suite 4' into the street address. The unescaped pipe '|' split the address across two fields, corrupting City, State, and Zip coordinates! Replace the raw pipe with the proper HL7 escape operator.",
                InitialCode = "PID|1||MRN778||Davis^Alice||19910812|F||100 Elm St | Suite 4^^Denver^CO^80203",
                CurrentCode = "PID|1||MRN778||Davis^Alice||19910812|F||100 Elm St | Suite 4^^Denver^CO^80203",
                Hint = "In HL7 v2, a literal pipe must be escaped as '\\F\\'. Replace '|' inside '100 Elm St | Suite 4' with '\\F\\'.",
                Validator = code =>
                {
                    if (code.Contains(@"\F\")) return (true, "Great job! '\\F\\' safely encodes the pipe character without splitting the segment.");
                    return (false, "The raw pipe was not escaped. Use '\\F\\' in place of the inner pipe character.");
                }
            },
            new BugChallenge
            {
                Title = "Add Missing MLLP Framing Envelopes",
                Description = "A new hospital TCP socket listener failed because the payload was sent as bare text without Minimal Lower Layer Protocol (MLLP) framing delimiters. Add '<0x0B>' at the beginning and '<0x1C><0x0D>' at the end.",
                InitialCode = "MSH|^~\\&|PAS|METRO|EHR|METRO|20261012100000||ADT^A01|MSG55|P|2.5\r\nPID|1||9001||Lee^David",
                CurrentCode = "MSH|^~\\&|PAS|METRO|EHR|METRO|20261012100000||ADT^A01|MSG55|P|2.5\r\nPID|1||9001||Lee^David",
                Hint = "Wrap the message so it starts with '<0x0B>' and ends with '<0x1C><0x0D>' (or '\\x0B' and '\\x1C\\x0D').",
                Validator = code =>
                {
                    var trimmed = code.Trim();
                    bool hasStart = trimmed.StartsWith("<0x0B>") || trimmed.StartsWith("\x0B") || trimmed.StartsWith("0x0B");
                    bool hasEnd = trimmed.EndsWith("<0x1C><0x0D>") || trimmed.EndsWith("\x1C\x0D") || trimmed.EndsWith("0x1C 0x0D");
                    if (hasStart && hasEnd) return (true, "Packet framed! MLLP receivers on port 2575 will now recognize start and end of transmission.");
                    return (false, "Message must begin with '<0x0B>' (Start Block) and terminate with '<0x1C><0x0D>' (End Block + Carriage Return).");
                }
            },
            new BugChallenge
            {
                Title = "Add Missing Required FHIR Observation Status",
                Description = "A laboratory script pushed a JSON Observation to HAPI FHIR, but the server rejected it with HTTP 422: 'Missing required 1..1 element: status'. Add the required status property with value 'final'.",
                InitialCode = "{\r\n  \"resourceType\": \"Observation\",\r\n  \"code\": {\r\n    \"text\": \"Blood Glucose\"\r\n  },\r\n  \"valueQuantity\": {\r\n    \"value\": 105,\r\n    \"unit\": \"mg/dL\"\r\n  }\r\n}",
                CurrentCode = "{\r\n  \"resourceType\": \"Observation\",\r\n  \"code\": {\r\n    \"text\": \"Blood Glucose\"\r\n  },\r\n  \"valueQuantity\": {\r\n    \"value\": 105,\r\n    \"unit\": \"mg/dL\"\r\n  }\r\n}",
                Hint = "Add '\"status\": \"final\",' right below '\"resourceType\": \"Observation\",'.",
                Validator = code =>
                {
                    if (code.Contains("\"status\"") && (code.Contains("\"final\"") || code.Contains("\"preliminary\"")))
                    {
                        return (true, "Verified! 'status: final' satisfies the mandatory FHIR R4 Observation cardinality (1..1).");
                    }
                    return (false, "Observation is still missing 'status': 'final'. Add the mandatory status attribute.");
                }
            }
        };
    }

    private void SelectChallenge(int index)
    {
        selectedChallengeIndex = index;
        showHint = false;
    }

    private void ResetChallenge()
    {
        var ch = Challenges[selectedChallengeIndex];
        ch.CurrentCode = ch.InitialCode;
        ch.VerificationStatus = null;
        ch.IsSolved = false;
    }

    private void VerifyCurrentChallenge()
    {
        var ch = Challenges[selectedChallengeIndex];
        var result = ch.Validator(ch.CurrentCode);
        ch.IsSolved = result.Passed;
        ch.VerificationStatus = result.Message;
    }

    private record WarIncident(
        string ShortTitle,
        string FullTitle,
        string Category,
        string HazardExplanation,
        string BrokenPayload,
        string FailureRootCause,
        string FixedPayload,
        string FixExplanation,
        string GuardrailRule
    );

    private static readonly List<WarIncident> Incidents = new()
    {
        // 1. MPI Collision
        new(
            ShortTitle: "Duplicate Chart Collision",
            FullTitle: "The Master Patient Index (MPI) Identifier Collision",
            Category: "Patient Identity / MPI",
            HazardExplanation: "Two regional clinics merge into one hospital network. Both clinics happened to issue patient ID '10042'. Because the interface team omitted PID-3.4 (Assigning Authority), clinic A's chemotherapy plan accidentally linked to a pregnant woman from clinic B!",
            BrokenPayload:
@"PID|1||10042||Miller^Robert||19600101|M
...
PID|1||10042||Johnson^Alice||19920510|F",
            FailureRootCause: "Both patients share ID '10042'. Without an assigning authority namespace, the enterprise MPI treats them as the same human record.",
            FixedPayload:
@"PID|1||10042^^^CLINIC_NORTH^MR||Miller^Robert||19600101|M
...
PID|1||10042^^^CLINIC_SOUTH^MR||Johnson^Alice||19920510|F",
            FixExplanation: "Component 4 (Assigning Authority) provides namespacing. In FHIR, this maps to distinct system URIs: 'http://clinic-north.org/mrn' vs 'http://clinic-south.org/mrn'.",
            GuardrailRule: "Never accept raw patient IDs without an Assigning Authority (PID-3.4) in v2, or a valid 'system' URI in FHIR."
        ),

        // 2. Unescaped Delimiter Crash
        new(
            ShortTitle: "Unescaped Delimiter Crash",
            FullTitle: "Unescaped Pipe Character Crashing the Downstream Parser",
            Category: "Wire Protocol / Syntax",
            HazardExplanation: "A doctor notes: 'Diagnosis: Acute pain | Suspected kidney stone'. The interface sends the note with a literal pipe '|'. The receiving lab system misinterprets the pipe as a field boundary, shifts all subsequent segments, and drops the patient's billing data.",
            BrokenPayload:
@"OBX|1|TX|NOTE^Clinical Note||Pain: Severe | Patient drowsy||||||F",
            FailureRootCause: "The pipe '|' inside 'Severe | Patient' is treated as a field delimiter. The parser looks for Units in OBX-6 and finds 'Patient drowsy', crashing the schema validator.",
            FixedPayload:
@"OBX|1|TX|NOTE^Clinical Note||Pain: Severe \F\ Patient drowsy||||||F",
            FixExplanation: "Using '\\F\\' escapes the pipe so parsers know it is textual content rather than a structural delimiter.",
            GuardrailRule: "Always run outgoing HL7 v2 messages through an escape sanitizer that automatically replaces bare '|', '^', and '~' characters in user inputs."
        ),

        // 3. Timezone Shift
        new(
            ShortTitle: "Timezone Shift Ghost Bug",
            FullTitle: "Birthdate Shifting by One Day Due to Naive UTC Conversion",
            Category: "Data Types & Datetime",
            HazardExplanation: "HL7 v2 sends Eleanor's birthdate as '19850614' (June 14). A developer converts this string into UTC DateTimeOffset (00:00:00 UTC). When a US Pacific clinic opens the chart (UTC-8), the date displays as June 13, 1985 at 16:00! Insurance rejects all pediatric claims due to mismatched DOB.",
            BrokenPayload:
@"// Bad C# converter:
DateTime dt = DateTime.Parse(""19850614"");
patient.BirthDate = dt.ToUniversalTime().ToString(""yyyy-MM-dd"");
// In Pacific Time: outputs '1985-06-13' (OFF BY ONE DAY!)",
            FailureRootCause: "Birth dates are calendar dates, not timestamps! Converting a date-only string through timezones shifts the day boundary.",
            FixedPayload:
@"// Correct C# converter:
// Keep date-only as ISO-8601 string without applying time offsets!
patient.BirthDate = rawDate.Substring(0, 4) + ""-"" + 
                    rawDate.Substring(4, 2) + ""-"" + 
                    rawDate.Substring(6, 2); // '1985-06-14'",
            FixExplanation: "FHIR allows Date strings ('YYYY-MM-DD') without time components. Never append '00:00:00' to a date of birth.",
            GuardrailRule: "Never convert Date of Birth through a UTC DateTime converter. Treat birth dates as timezone-agnostic calendar strings."
        ),

        // 4. Non-Numeric in NM Type
        new(
            ShortTitle: "Non-Numeric in NM Trap",
            FullTitle: "Lab Sending '< 0.01' in a Numeric (NM) OBX Field",
            Category: "Laboratory / OBX",
            HazardExplanation: "A microbiology PCR test returns '< 0.01'. The lab analyzer formats this in an OBX segment with value type 'NM' (Numeric). The receiving EHR executes decimal.Parse('< 0.01'), throws an unhandled System.FormatException, and drops the entire lab result batch!",
            BrokenPayload:
@"OBX|1|NM|1234-5^Viral Load^LN||< 0.01|copies/mL|0-100|N|||F",
            FailureRootCause: "OBX-2 says 'NM' (Numeric), but '< 0.01' is a string comparator, not a pure floating-point number.",
            FixedPayload:
@"// In v2: Send value as String (ST) when comparators exist:
OBX|1|ST|1234-5^Viral Load^LN||< 0.01|copies/mL|0-100|N|||F

// In FHIR: Use Quantity.comparator ('<'):
{
  ""valueQuantity"": {
    ""value"": 0.01,
    ""comparator"": ""<"",
    ""unit"": ""copies/mL""
  }
}",
            FixExplanation: "In FHIR, the Quantity data type provides a dedicated 'comparator' field ('<', '<=', '>=', '>'), preserving both the numeric value and the qualifier cleanly.",
            GuardrailRule: "When parsing OBX-5 with type NM, always use decimal.TryParse() with a regex fallback to extract comparators ('<', '>')."
        ),

        // 5. Missing Trigger Event
        new(
            ShortTitle: "Missing Trigger Event",
            FullTitle: "Sender Transmitting 'ADT' Instead of 'ADT^A01'",
            Category: "Interface Engine Routing",
            HazardExplanation: "A vendor sends 'ADT' in MSH-9 without the component delimiter and trigger event ('ADT^A01'). The hospital interface engine (Mirth) routes by trigger event, doesn't match any rules, and drops the message into an unmonitored dead-letter queue. The patient waits in the ER for 4 hours because the nursing station never received the admit notice.",
            BrokenPayload:
@"MSH|^~\&|OLD_PAS|HOSP|EHR|HOSP|202610111000||ADT|CTRL_001|P|2.3
PID|1||99102||Baker^Tom...",
            FailureRootCause: "MSH-9 must be a CM_MSG composite: MessageType^TriggerEvent (e.g. ADT^A01). Without the trigger event, automated routers cannot determine clinical intent.",
            FixedPayload:
@"MSH|^~\&|OLD_PAS|HOSP|EHR|HOSP|202610111000||ADT^A01|CTRL_001|P|2.3
PID|1||99102||Baker^Tom...",
            FixExplanation: "Adding the trigger event '^A01' allows interface engine filters to route the patient to bed census systems immediately.",
            GuardrailRule: "Validate MSH-9 in your ingestion middleware; if MSH-9.2 is empty, fail-fast and reject the message with an explicit NACK before it gets lost."
