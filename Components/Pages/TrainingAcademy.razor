}
"""
        )
    };

    private record QuestionItem(
        string Question, string ArabicQuestion,
        string Tier,
        List<string> Options, List<string> ArabicOptions,
        int CorrectOptionIndex);

    private static readonly List<QuestionItem> Questions = new()
    {
        new(
            "In an HL7 v2 ER7 message, what character is the standard field separator?",
            "في رسالة HL7 v2 بنظام ER7، ما هو الرمز القياسي المستخدم كفاصل للحقول؟",
            "HL7 v2",
            new() { "Pipe (|)", "Caret (^)", "Tilde (~)", "Ampersand (&)" },
            new() { "الأنبوب (|)", "القبعة (^)", "المدّة (~)", "علامة (&)" },
            0
        ),
        new(
            "Which HL7 v2 segment contains the patient's MRN, legal name, and date of birth?",
            "أي قطاع في رسالة HL7 v2 يحتوي على الرقم الطبي للمريض، اسمه الرسمي، وتاريخ ميلاده؟",
            "HL7 v2",
            new() { "MSH", "PID", "PV1", "OBX" },
