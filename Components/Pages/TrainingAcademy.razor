    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    private void SelectAnswer(int questionIndex, int optionIndex)
    {
        userAnswers[questionIndex] = optionIndex;
    }

    private void ResetExam()
    {
        userAnswers.Clear();
        examSubmitted = false;
        correctCount = 0;
        scorePercentage = 0;
    }

    private void CalculateScore()
    {
        correctCount = 0;
        for (int i = 0; i < Questions.Count; i++)
        {
            if (userAnswers.TryGetValue(i, out var selected) && selected == Questions[i].CorrectOptionIndex)
            {
                correctCount++;
            }
        }
        scorePercentage = (int)Math.Round((double)correctCount / Questions.Count * 100);
        examSubmitted = true;
    }

    private async Task PrintCertificate()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task CopyText(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
