@page "/training-academy"
@rendermode InteractiveServer
@implements IDisposable
@inject LanguageService Lang
@inject IJSRuntime JS

<PageTitle>@(Lang.IsRtl ? "أكاديمية التدريب والشهادات المهنية - منصة HL7 و FHIR" : "Training Academy & Certification - HL7 & FHIR Workbench")</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1b6ec2 0%, #4c1d95 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-warning text-dark mb-2 px-3 py-1 fw-bold">
                    <i class="bi bi-mortarboard-fill me-1"></i> @(Lang.IsRtl ? "أكاديمية التميز السريري الرقمي" : "Clinical Interop Academy")
                </span>
                <h1 class="h2 fw-bold mb-1">
                    @(Lang.IsRtl ? "أكاديمية التدريب المهني والشهادات المعتمدة" : "Healthcare Interoperability Academy & Certification")
                </h1>
                <p class="mb-0 text-white-50">
                    @(Lang.IsRtl ? "تدريب عملي متقدم يحاكي سيناريو مريض حقيقي من الدخول إلى الخروج، واختبار كفاءة من 3 مستويات يمنحك شهادة إتقان قابلة للطباعة."
                                 : "Hands-on clinical workflow simulation, 3-tier competency assessment, and verifiable certificate of completion.")
                </p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-light text-dark align-self-center px-3 py-2 fw-semibold">
                    <i class="bi bi-award-fill text-warning me-1"></i> @(Lang.IsRtl ? "شهادة إتمام رقمية" : "Verifiable Certificate")
                </span>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "journey" ? "active" : "btn-outline-primary") fw-semibold"
                    @onclick='() => activeTab = "journey"'>
                <i class="bi bi-diagram-3-fill me-1"></i> @(Lang.IsRtl ? "1. رحلة المريض السريرية المتكاملة" : "1. Complete Patient Clinical Journey")
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "exam" ? "active" : "btn-outline-primary") fw-semibold"
                    @onclick='() => activeTab = "exam"'>
                <i class="bi bi-patch-check-fill me-1"></i> @(Lang.IsRtl ? "2. اختبار الكفاءة والشهادة" : "2. Competency Exam & Certificate")
            </button>
        </li>
    </ul>

    @if (activeTab == "journey")
    {
        <!-- Continuous Case Study: Acute Cardiac Emergency -->
        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-heart-pulse-fill text-danger me-2"></i>
                        @(Lang.IsRtl ? "دراسة حالة سريرية: متلازمة الشريان التاجي الحادة (Acute Cardiac STEMI)" : "Clinical Case Study: Acute Coronary Syndrome (STEMI Protocol)")
                    </h5>
                    <small class="text-white-50">
                        @(Lang.IsRtl ? "تتبع بيانات المريض عمر الفلاسي عبر 5 محطات سريرية، وشاهد التحول الفوري بين رسائل HL7 v2 وموارد FHIR R4."
                                     : "Follow patient Omar Al-Falasi across 5 clinical touchpoints; observe synchronous HL7 v2 and FHIR R4 representations.")
                    </small>
                </div>
                <span class="badge bg-danger">Critical Pathway</span>
            </div>
            <div class="card-body">
                <!-- Step Selector Stepper -->
                <div class="d-flex justify-content-between mb-4 flex-wrap gap-2">
                    @for (int i = 0; i < JourneySteps.Count; i++)
                    {
                        var stepIndex = i;
                        var step = JourneySteps[i];
                        <button class="btn @(currentStepIndex == stepIndex ? "btn-primary shadow" : "btn-outline-secondary") btn-sm text-start"
                                @onclick="() => currentStepIndex = stepIndex">
                            <span class="fw-bold">Step @(stepIndex + 1):</span> @(Lang.IsRtl ? step.ArabicTitle : step.Title)
                        </button>
                    }
                </div>

                <!-- Active Step Detail -->
                @{
                    var activeStep = JourneySteps[currentStepIndex];
                }
                <div class="alert alert-primary d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h6 class="fw-bold mb-1">
                            <i class="bi bi-activity me-1"></i> @(Lang.IsRtl ? activeStep.ArabicTitle : activeStep.Title)
                        </h6>
                        <small class="text-muted">@(Lang.IsRtl ? activeStep.ArabicDescription : activeStep.Description)</small>
                    </div>
                    <span class="badge bg-dark font-monospace fs-6">@activeStep.V2MessageType</span>
                </div>

                <div class="row g-3 mb-3">
                    <!-- HL7 v2 ER7 Payload -->
                    <div class="col-lg-6">
                        <div class="card h-100 border">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                                <span class="small fw-bold">
                                    <i class="bi bi-hdd-network text-warning me-1"></i> HL7 v2 Wire Message (@activeStep.V2MessageType)
                                </span>
                                <button class="btn btn-outline-light btn-sm py-0 px-2" @onclick="() => CopyText(activeStep.V2Message)">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                            <div class="card-body bg-light p-2">
                                <pre class="p-2 bg-dark text-warning rounded small font-monospace mb-0" style="white-space: pre-wrap; word-break: break-all; min-height: 220px;">@activeStep.V2Message</pre>
                            </div>
                        </div>
                    </div>

                    <!-- Corresponding FHIR R4 Resource Bundle -->
                    <div class="col-lg-6">
                        <div class="card h-100 border">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                                <span class="small fw-bold">
                                    <i class="bi bi-filetype-json text-success me-1"></i> FHIR R4 Target Resource (@activeStep.FhirResourceType)
                                </span>
                                <button class="btn btn-outline-light btn-sm py-0 px-2" @onclick="() => CopyText(activeStep.FhirJson)">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                            <div class="card-body bg-light p-2">
                                <pre class="p-2 bg-dark text-success rounded small font-monospace mb-0" style="max-height: 250px; overflow-y: auto;">@activeStep.FhirJson</pre>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <button class="btn btn-outline-secondary btn-sm" 
                            disabled="@(currentStepIndex == 0)"
                            @onclick="() => currentStepIndex--">
                        <i class="bi bi-arrow-left me-1"></i> @(Lang.IsRtl ? "المحطة السابقة" : "Previous Step")
                    </button>
                    <button class="btn btn-primary btn-sm" 
                            disabled="@(currentStepIndex == JourneySteps.Count - 1)"
                            @onclick="() => currentStepIndex++">
                        @(Lang.IsRtl ? "المحطة التالية" : "Next Step") <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Tiered Competency Exam & Certificate Generator -->
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm border mb-4">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-check2-circle text-info me-2"></i>
                            @(Lang.IsRtl ? "اختبار التقييم المهني الشامل (10 أسئلة معتمدة)" : "Healthcare Interoperability Competency Assessment")
                        </h5>
                        <span class="badge bg-info text-dark">3 Skill Tiers</span>
                    </div>
                    <div class="card-body">
                        @for (int qIdx = 0; qIdx < Questions.Count; qIdx++)
                        {
                            var q = Questions[qIdx];
                            var currentIdx = qIdx;
                            <div class="card mb-3 border">
                                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small">
                                        Q@(currentIdx + 1): @(Lang.IsRtl ? q.ArabicQuestion : q.Question)
                                    </span>
                                    <span class="badge @(q.Tier == "HL7 v2" ? "bg-warning text-dark" : q.Tier == "FHIR" ? "bg-success" : "bg-primary")">
                                        @q.Tier
                                    </span>
                                </div>
                                <div class="card-body p-2">
                                    <div class="list-group list-group-flush">
                                        @for (int optIdx = 0; optIdx < q.Options.Count; optIdx++)
                                        {
                                            var optionText = Lang.IsRtl ? q.ArabicOptions[optIdx] : q.Options[optIdx];
                                            var optIndex = optIdx;
                                            var isSelected = userAnswers.ContainsKey(currentIdx) && userAnswers[currentIdx] == optIndex;
                                            <button class="list-group-item list-group-item-action py-2 small @(isSelected ? "active" : "")"
                                                    @onclick="() => SelectAnswer(currentIdx, optIndex)">
                                                <i class="bi @(isSelected ? "bi-check-circle-fill" : "bi-circle") me-2"></i>
                                                @optionText
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ResetExam">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> @(Lang.IsRtl ? "إعادة الضبط" : "Reset Answers")
                            </button>
                            <button class="btn btn-success btn-sm px-4 fw-bold" @onclick="CalculateScore">
                                <i class="bi bi-award-fill me-1"></i> @(Lang.IsRtl ? "تصحيح الاختبار وإصدار الشهادة" : "Submit & Generate Certificate")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate Generator Panel -->
            <div class="col-lg-5">
                <div class="card shadow-sm border mb-4 sticky-top" style="top: 1rem;">
                    <div class="card-header bg-light py-3">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-award text-warning me-2"></i>
                            @(Lang.IsRtl ? "شهادة الإتمام والاعتماد المهني" : "Verifiable Completion Certificate")
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">@(Lang.IsRtl ? "اسم المتدرب / المهندس:" : "Candidate Name for Certificate:"):</label>
                            <input type="text" class="form-control" @bind="candidateName" placeholder="e.g. Amjad Mesmar" />
                        </div>

                        @if (examSubmitted)
                        {
                            <div class="alert @(scorePercentage >= 70 ? "alert-success" : "alert-warning") text-center py-3 mb-3">
                                <h5 class="fw-bold mb-1">
                                    @(scorePercentage >= 70 ? (Lang.IsRtl ? "🎉 مبروك! اجتزت الاختبار بنجاح" : "🎉 Congratulations! You Passed")
                                                            : (Lang.IsRtl ? "⚠️ نتيجة الاختبار بحاجة إلى تحسين" : "⚠️ Keep practicing! Passing score is 70%"))
                                </h5>
                                <div class="display-6 fw-bold">@scorePercentage%</div>
                                <small class="text-muted">
                                    @(Lang.IsRtl ? $"أجبت بشكل صحيح على {correctCount} من أصل {Questions.Count} أسئلة"
                                                 : $"Correct answers: {correctCount} out of {Questions.Count}")
                                </small>
                            </div>

                            @if (scorePercentage >= 70)
                            {
                                <!-- Official Printable Certificate Container -->
                                <div id="printableCertificate" class="p-4 border rounded shadow-sm text-center bg-white position-relative mb-3"
                                     style="border: 4px double #1b6ec2 !important; min-height: 340px;">
                                    <div class="text-uppercase text-muted small fw-bold tracking-wider mb-2">Certificate of Technical Mastery</div>
                                    <h4 class="fw-bold text-primary mb-1">Healthcare Interoperability Specialist</h4>
                                    <small class="text-muted d-block mb-3">HL7 v2.x ER7 &amp; HL7 FHIR Release 4 Certified Practitioner</small>
                                    
                                    <div class="my-3 py-2 border-top border-bottom">
                                        <div class="small text-muted mb-1">This is proudly presented to</div>
                                        <h3 class="fw-bold text-dark mb-0 font-monospace">@candidateName</h3>
                                    </div>

                                    <p class="small text-muted mb-3" style="font-size: 0.78rem;">
                                        For demonstrating proficiency in HL7 v2 segment pipelines, MLLP socket transmission,
                                        FHIR R4 resource architecture, RESTful query syntax, and Middle Eastern clinical data profiles (NPHIES/Malaffi).
                                    </p>

                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top text-muted small" style="font-size: 0.7rem;">
                                        <span>Date: @DateTime.UtcNow.ToString("MMM dd, yyyy")</span>
                                        <span class="badge bg-success">Passed with Distinction (@scorePercentage%)</span>
                                        <span class="font-monospace">ID: AGY-@Math.Abs(candidateName.GetHashCode()).ToString("X6")</span>
                                    </div>
                                </div>

                                <button class="btn btn-outline-primary btn-sm w-100" @onclick="PrintCertificate">
                                    <i class="bi bi-printer me-1"></i> @(Lang.IsRtl ? "طباعة / حفظ الشهادة PDF" : "Print / Export Certificate PDF")
                                </button>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted bg-light rounded">
                                <i class="bi bi-file-earmark-lock fs-1 text-secondary"></i>
                                <p class="mt-2 mb-0 small">
                                    @(Lang.IsRtl ? "أجب عن أسئلة التقييم واضغط \"تصحيح الاختبار\" لإصدار شهادتك الرسمية."
                                                 : "Complete the 10-question evaluation on the left and submit to unlock your verified credential.")
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string activeTab = "journey";
    private int currentStepIndex = 0;
    private string candidateName = "Healthcare Engineer";
    private bool examSubmitted = false;
    private int correctCount = 0;
    private int scorePercentage = 0;
    private Dictionary<int, int> userAnswers = new();

    private record JourneyStepItem(
        string Title, string ArabicTitle,
        string Description, string ArabicDescription,
        string V2MessageType, string V2Message,
        string FhirResourceType, string FhirJson);

    private static readonly List<JourneyStepItem> JourneySteps = new()
