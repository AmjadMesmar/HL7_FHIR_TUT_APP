                                <p class="card-text text-muted small flex-grow-1 mb-0" style="font-size: 0.8rem;">@(Lang.IsRtl && !string.IsNullOrEmpty(term.DefinitionAr) ? term.DefinitionAr : term.Definition)</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
