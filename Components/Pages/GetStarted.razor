                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select form-select-sm" @bind="selectedJargonCategory">
                        <option value="All">@(Lang.IsRtl ? "جميع التصنيفات" : "All Categories")</option>
                        <option value="HL7 v2">@(Lang.IsRtl ? "مصطلحات HL7 v2" : "HL7 v2 Terms")</option>
                        <option value="FHIR">@(Lang.IsRtl ? "مصطلحات FHIR" : "FHIR Terms")</option>
                        <option value="Terminology">@(Lang.IsRtl ? "أنظمة الترميز والتصنيف" : "Coding & Terminologies")</option>
                        <option value="Hospital">@(Lang.IsRtl ? "مفاهيم المستشفيات" : "Hospital Concepts")</option>
                    </select>
                </div>
            </div>

            <!-- Terms Grid -->
            <div class="row g-2">
