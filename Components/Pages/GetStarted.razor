    private record JargonItem(string Term, string FullName, string Category, string Definition);

    private static readonly List<JargonItem> AllJargon = new()
    {
        new("ADT", "Admission, Discharge, Transfer", "HL7 v2", "The most common HL7 v2 message family. Tracks patient demographic events and movement within the hospital."),
        new("ORU", "Observational Results (Unsolicited)", "HL7 v2", "The standard message sent by laboratories and diagnostic devices containing test results."),
        new("ORM", "Order Message", "HL7 v2", "General order message sent by physicians to request clinical actions (labs, imaging, medication orders)."),
        new("MSH", "Message Header", "HL7 v2", "The very first segment of every HL7 v2 message. Defines delimiters, sending system, receiving system, and timestamp."),
        new("PID", "Patient Identification", "HL7 v2", "The core segment containing patient demographics: MRN, Name, Date of Birth, Gender, Address, Phone."),
        new("PV1", "Patient Visit", "HL7 v2", "The segment tracking patient visit details: Inpatient/Outpatient class, Assigned Bed/Room, Attending Doctor."),
        new("OBR", "Observation Request", "HL7 v2", "The header for an ordered test panel (e.g. Basic Metabolic Panel) ordered by a physician."),
        new("OBX", "Observation / Result", "HL7 v2", "The segment holding a single discrete test result (e.g. Glucose = 142 mg/dL) with units and abnormal flags."),
        new("DG1", "Diagnosis", "HL7 v2", "Segment reporting clinical diagnoses associated with a patient visit, typically coded in ICD-10."),
        new("IN1", "Insurance", "HL7 v2", "Segment detailing patient health insurance policy information for claims processing."),
        new("MLLP", "Minimal Lower Layer Protocol", "HL7 v2", "The framing protocol used over raw TCP sockets to send HL7 v2 messages between hospital servers."),
        new("MRN", "Medical Record Number", "Hospital", "A unique permanent identification number assigned to a patient by a healthcare organization."),
        new("Resource", "FHIR Core Building Block", "FHIR", "The basic granular unit in FHIR (e.g. Patient, Observation, Encounter) serialized as JSON or XML."),
        new("Bundle", "FHIR Collection Container", "FHIR", "A container resource grouping multiple resources together for search results, batch transactions, or message transfers."),
        new("LOINC", "Logical Observation Identifiers Names and Codes", "Terminology", "The universal standard vocabulary for identifying medical laboratory observations and diagnostic tests."),
        new("SNOMED CT", "Systematized Nomenclature of Medicine", "Terminology", "The comprehensive clinical healthcare terminology used worldwide for clinical findings and diagnoses."),
        new("SMART on FHIR", "Substitutable Medical Applications, Reusable Technologies", "FHIR", "An open healthcare standard built on OAuth 2.0 enabling web apps to securely launch inside EHRs like Epic and Cerner."),
        new("UCUM", "Unified Code for Units of Measure", "Terminology", "The standard system for expressing units of measurement (e.g. mg/dL, mmol/L) in healthcare software.")
