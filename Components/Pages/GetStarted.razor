    private IEnumerable<JargonItem> FilteredJargon => AllJargon
        .Where(j => selectedJargonCategory == "All" || j.Category == selectedJargonCategory)
        .Where(j => string.IsNullOrWhiteSpace(jargonSearch) ||
                    j.Term.Contains(jargonSearch, StringComparison.OrdinalIgnoreCase) ||
                    j.FullName.Contains(jargonSearch, StringComparison.OrdinalIgnoreCase) ||
                    (j.FullNameAr != null && j.FullNameAr.Contains(jargonSearch, StringComparison.OrdinalIgnoreCase)) ||
                    j.Definition.Contains(jargonSearch, StringComparison.OrdinalIgnoreCase) ||
                    (j.DefinitionAr != null && j.DefinitionAr.Contains(jargonSearch, StringComparison.OrdinalIgnoreCase)));

