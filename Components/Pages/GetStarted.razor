    <!-- TOPIC 6: INTERACTIVE PRACTICE QUIZ & REFS -->
    <div id="topic-quiz" class="card shadow-sm mb-4 border-secondary border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-award-fill me-2"></i> @(Lang.IsRtl ? "الموضوع 6: اختبار تقييم الاستيعاب والمراجع الرسمية" : "Topic 6: Knowledge Check & Official References")
            </h5>
            <span class="badge bg-secondary">@(Lang.IsRtl ? "التقييم الذاتي" : "Self-Assessment")</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                @(Lang.IsRtl ? "اختبر فهمك مع هذه الأسئلة العملية المبنية على سيناريوهات واقعية من بيئات الإنتاج:"
                             : "Test your understanding with these real-world decoding questions:")
            </p>

            <div class="row g-3 mb-4">
                @for (int i = 0; i < QuizQuestions.Count; i++)
                {
                    var qIndex = i;
                    var q = QuizQuestions[qIndex];
                    <div class="col-md-6">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-header bg-light py-2 fw-semibold small d-flex justify-content-between align-items-center">
                                <span>@(Lang.IsRtl ? $"السؤال {qIndex + 1} من {QuizQuestions.Count}" : $"Question {qIndex + 1} of {QuizQuestions.Count}")</span>
                                @if (userAnswers.ContainsKey(qIndex))
                                {
                                    if (userAnswers[qIndex] == q.CorrectOptionIndex)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> @(Lang.IsRtl ? "إجابة صحيحة!" : "Correct!")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> @(Lang.IsRtl ? "حاول مرة أخرى" : "Try Again")</span>
                                    }
                                }
                            </div>
                            <div class="card-body p-3 small">
                                <p class="fw-bold mb-2">@(Lang.IsRtl && !string.IsNullOrEmpty(q.QuestionTextAr) ? q.QuestionTextAr : q.QuestionText)</p>
                                @if (!string.IsNullOrEmpty(q.Snippet))
                                {
                                    <div class="p-1 mb-2 bg-dark text-info rounded font-monospace small" style="direction: ltr !important; text-align: left !important; unicode-bidi: isolate; font-size: 0.75rem;">
                                        @q.Snippet
                                    </div>
                                }
                                <div class="d-grid gap-1 mb-2">
                                    @{
                                        var currentOpts = Lang.IsRtl && q.OptionsAr != null && q.OptionsAr.Count == q.Options.Count ? q.OptionsAr : q.Options;
                                    }
                                    @for (int opt = 0; opt < currentOpts.Count; opt++)
                                    {
                                        var optIndex = opt;
                                        var isSelected = userAnswers.ContainsKey(qIndex) && userAnswers[qIndex] == optIndex;
                                        var isCorrect = optIndex == q.CorrectOptionIndex;
                                        string btnClass = "btn-outline-secondary";

                                        if (userAnswers.ContainsKey(qIndex))
                                        {
                                            if (isCorrect) btnClass = "btn-success text-white fw-bold";
                                            else if (isSelected) btnClass = "btn-danger text-white";
                                        }

                                        <button class="btn btn-sm text-start py-1 px-2 @btnClass"
                                                @onclick="() => AnswerQuestion(qIndex, optIndex)">
                                            <span class="me-1">@((char)('A' + optIndex)).</span> @currentOpts[optIndex]
                                        </button>
                                    }
                                </div>
                                @if (userAnswers.ContainsKey(qIndex))
                                {
                                    <div class="alert @(userAnswers[qIndex] == q.CorrectOptionIndex ? "alert-success" : "alert-warning") p-2 mb-0 mt-2" style="font-size: 0.8rem;">
                                        <strong>@(Lang.IsRtl ? "التوضيح:" : "Explanation:")</strong> @(Lang.IsRtl && !string.IsNullOrEmpty(q.ExplanationAr) ? q.ExplanationAr : q.Explanation)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Official Documentation Links -->
            <h6 class="fw-bold text-dark mb-2">
                <i class="bi bi-bookmark-star text-primary me-1"></i> @(Lang.IsRtl ? "مراجع الوثائق والمواصفات القياسية الرسمية" : "Authoritative Documentation References")
            </h6>
            <div class="row g-2 small">
                <div class="col-md-3">
                    <a href="https://hl7.org/fhir/R4/" target="_blank" class="btn btn-outline-primary btn-sm w-100 text-truncate">
                        @(Lang.IsRtl ? "مواصفة HL7 FHIR R4" : "HL7 FHIR R4 Spec") <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="https://docs.fire.ly/projects/Firely-NET-SDK/" target="_blank" class="btn btn-outline-success btn-sm w-100 text-truncate">
                        @(Lang.IsRtl ? "توثيق حزمة Firely .NET SDK" : "Firely C# SDK Docs") <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="https://loinc.org/" target="_blank" class="btn btn-outline-warning btn-sm text-dark w-100 text-truncate">
                        @(Lang.IsRtl ? "منظومة أكواد LOINC" : "Regenstrief LOINC") <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="https://smarthealthit.org/" target="_blank" class="btn btn-outline-info btn-sm text-dark w-100 text-truncate">
                        @(Lang.IsRtl ? "بروتوكول SMART on FHIR" : "SMART Health IT OAuth2") <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
