@page "/get-started"
@rendermode InteractiveServer
@implements IDisposable
@inject LanguageService Lang

<PageTitle>@(Lang.IsRtl ? "الدليل التعليمي الشامل لمعايير HL7 و FHIR" : "Get Started - The Master Healthcare Interoperability Guide")</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #198754 0%, #0d6efd 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-light text-dark mb-2 px-3 py-1 fw-semibold">
                    @(Lang.IsRtl ? "المنهج المتعمق لهندسة تكامل المستشفيات" : "In-Depth Healthcare Engineering Curriculum")
                </span>
                <h1 class="h2 fw-bold mb-1">
                    @(Lang.IsRtl ? "دليل إتقان معايير HL7 v2 و FHIR R4 الشامل" : "HL7 v2 & FHIR: The Master Educational Guide")
                </h1>
                <p class="mb-0 text-white-50">
                    @(Lang.IsRtl ? "شرح معمق لصيغ البيانات (JSON vs XML vs ER7)، والفواصل ومحارف الهروب، وتشريح 5 رسائل جراحية، ومصفوفة حجر رشيد لترجمة المفاهيم."
                                 : "Comprehensive deep-dive covering body formats (JSON vs XML vs ER7), delimiters and escape operators, 5 surgical message dissections, and interactive tools.")
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="regional-interop" class="btn btn-warning fw-bold px-3">
                    <i class="bi bi-globe-central-south-asia me-1"></i> @(Lang.IsRtl ? "المعايير الإقليمية (NPHIES)" : "Regional Interop")
                </a>
                <a href="training-academy" class="btn btn-light fw-bold px-3 text-primary">
                    <i class="bi bi-mortarboard-fill me-1"></i> @(Lang.IsRtl ? "الأكاديمية والشهادة" : "Academy & Cert")
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Bar -->
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 align-items-center small">
                <span class="fw-bold text-muted me-1"><i class="bi bi-compass"></i> @(Lang.IsRtl ? "انتقل إلى الموضوع:" : "Jump to Topic:")</span>
                <a href="get-started#topic-formats" class="btn btn-sm btn-outline-primary py-0">@(Lang.IsRtl ? "1. مقارنة صيغ البيانات (JSON/XML/ER7)" : "1. JSON vs XML vs ER7")</a>
                <a href="get-started#topic-rosetta" class="btn btn-sm btn-outline-warning py-0 fw-semibold">@(Lang.IsRtl ? "حجر رشيد ونشأة 1989" : "The Rosetta Stone & 1989 Origins")</a>
                <a href="get-started#topic-operators" class="btn btn-sm btn-outline-primary py-0">@(Lang.IsRtl ? "2. فواصل ومحارف HL7" : "2. HL7 Delimiters & Operators")</a>
                <a href="get-started#topic-messages" class="btn btn-sm btn-outline-primary py-0">@(Lang.IsRtl ? "3. تشريح 5 رسائل جراحية" : "3. 5 Deep-Dive Messages")</a>
                <a href="get-started#topic-journey" class="btn btn-sm btn-outline-primary py-0">@(Lang.IsRtl ? "4. محاكي رحلة المريض" : "4. Patient Journey Simulator")</a>
                <a href="regional-interop" class="btn btn-sm btn-outline-success py-0 fw-semibold"><i class="bi bi-globe me-1"></i> @(Lang.IsRtl ? "المعايير العربية والأسماء" : "Arabic 4-Part Names")</a>
                <a href="training-academy" class="btn btn-sm btn-outline-info py-0 fw-semibold"><i class="bi bi-award me-1"></i> @(Lang.IsRtl ? "شهادة الكفاءة" : "Certification")</a>
            </div>
        </div>
    </div>

    <!-- TOPIC 1: WHEN TO USE DATA BODY TYPES (JSON vs XML vs ER7 vs RDF) -->
    <div id="topic-formats" class="card shadow-sm mb-4 border-primary border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-primary">
                <i class="bi bi-file-earmark-binary-fill me-2"></i> @(Lang.IsRtl ? "الموضوع 1: متى تستخدم صيغ البيانات (JSON مقابل XML مقابل ER7 مقابل RDF)" : "Topic 1: When to Use Payload Formats (JSON vs XML vs ER7 vs RDF)")
            </h5>
            <span class="badge bg-primary">@(Lang.IsRtl ? "دليل القرارات المعمارية" : "Architecture Decision Guide")</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                @(Lang.IsRtl ? "تتبادل برمجيات الرعاية الصحية البيانات السريرية عبر أربع صيغ رئيسية. معرفة متى تختار كل صيغة أمر أساسي للتخطيط والتصميم المعماري:"
                             : "Healthcare software interchanges clinical data across four primary formats. Knowing which format to select is essential for architectural planning:")
            </p>

            <div class="row g-3 mb-3">
                <!-- JSON Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-success">JSON (JavaScript Object Notation)</span>
                            <span class="badge bg-success">@(Lang.IsRtl ? "معيار FHIR" : "FHIR Standard")</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>@(Lang.IsRtl ? "متى تستخدمها:" : "When to use:")</strong>
                                @(Lang.IsRtl ? "تطبيقات الويب والجوّال الحديثة، واجهات برمجة تطبيقات FHIR RESTful (معايير SMART on FHIR)، والخدمات المصغرة السحابية، وتبادل البيانات الصحية العامة."
                                             : "Modern web apps, mobile apps, RESTful FHIR APIs (SMART on FHIR), cloud microservices, and public health data exchanges.")
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>@(Lang.IsRtl ? "المزايا:" : "Pros:")</strong> @(Lang.IsRtl ? "مدمجة وخفيفة، بدون وسوم إغلاق، مدعومة محلياً في المتصفحات و .NET و Python و TypeScript." : "Compact, no closing tags, parsed natively by browsers, .NET System.Text.Json, Python, and TypeScript.")</li>
                                <li><strong>@(Lang.IsRtl ? "العيوب:" : "Cons:")</strong> @(Lang.IsRtl ? "تفتقر إلى التحقق من المخطط افتراضياً بدون مخططات إضافية (تتطلب FHIR JSON Schemas)." : "Lacks native schema validation out of the box (requires FHIR JSON Schemas).")</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- XML Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-primary">XML (eXtensible Markup)</span>
                            <span class="badge bg-primary">@(Lang.IsRtl ? "مستندات C-CDA ومؤسساتية" : "C-CDA / Enterprise")</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>@(Lang.IsRtl ? "متى تستخدمها:" : "When to use:")</strong>
                                @(Lang.IsRtl ? "التبادلات المعتمدة على المستندات الطبية مثل C-CDA (ملخصات استمرارية الرعاية)، مسارات SOAP/ESB المؤسسية، والأرشفة القانونية للسجلات الصحية."
                                             : "Document-based exchanges like C-CDA (Continuity of Care Documents), enterprise SOAP/ESB feeds, and legal medical records archiving.")
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>@(Lang.IsRtl ? "المزايا:" : "Pros:")</strong> @(Lang.IsRtl ? "تحقق صارم عبر قواعد XSD و Schematron؛ دعم أصيل للتوقيعات الرقمية المشفرة (XML-DSig)." : "Strict validation via XSD and Schematron rules; native digital signatures (XML-DSig).")</li>
                                <li><strong>@(Lang.IsRtl ? "العيوب:" : "Cons:")</strong> @(Lang.IsRtl ? "وسوم الإغلاق المطولة تزيد حجم الحمولة بنسبة 30-50%؛ استهلاك ذاكرة أعلى." : "Verbose closing tags inflate payload size by 30-50%; heavier memory footprint.")</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- ER7 Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-warning text-dark">ER7 (Pipe-and-Hat)</span>
                            <span class="badge bg-warning text-dark">@(Lang.IsRtl ? "إرث HL7 v2 الكلاسيكي" : "HL7 v2 Legacy")</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>@(Lang.IsRtl ? "متى تستخدمها:" : "When to use:")</strong>
                                @(Lang.IsRtl ? "محركات تكامل المستشفيات في الوقت الفعلي (Mirth Connect، Cloverleaf، Rhapsody)، الأجهزة الطبية بجانب المريض، واتصالات السوكت بين أنظمة السجلات الطبية EHR ومختبرات LIS."
                                             : "Real-time hospital interface engines (Mirth, Cloverleaf, Rhapsody), bedside medical devices, and internal EHR-to-LIS socket feeds.")
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>@(Lang.IsRtl ? "المزايا:" : "Pros:")</strong> @(Lang.IsRtl ? "تدفق بايتات ASCII فائق الخفة؛ استهلاك ضئيل لحزمة البيانات؛ تحليل فوري على الأجهزة المضمنة." : "Ultra-lightweight ASCII byte stream; tiny bandwidth footprint; instantaneous parsing on older hardware.")</li>
                                <li><strong>@(Lang.IsRtl ? "العيوب:" : "Cons:")</strong> @(Lang.IsRtl ? "بنية مشفرة وتعتمد كلياً على ترتيب المواقع؛ يصعب استهلاكها مباشرة في المتصفحات بدون تحويل." : "Cryptic syntax; position-dependent; difficult for web browsers to consume directly.")</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Turtle / RDF Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-info text-dark">Turtle / RDF</span>
                            <span class="badge bg-info text-dark">@(Lang.IsRtl ? "الرسوم البيانية المعرفية" : "Knowledge Graphs")</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>@(Lang.IsRtl ? "متى تستخدمها:" : "When to use:")</strong>
                                @(Lang.IsRtl ? "الأبحاث الطبية الحيوية الأكاديمية، الأنطولوجيات السريرية (اجتياز رسوم SNOMED و OBO)، وأنظمة الاستدلال بالذكاء الاصطناعي."
                                             : "Academic biomedical research, clinical ontologies (SNOMED/OBO graph traversals), and AI reasoning systems.")
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>@(Lang.IsRtl ? "المزايا:" : "Pros:")</strong> @(Lang.IsRtl ? "بنية ثلاثية دلالية أصلية (الموضوع ← المحمول ← الكائن)." : "Native semantic triple structure (Subject → Predicate → Object).")</li>
                                <li><strong>@(Lang.IsRtl ? "العيوب:" : "Cons:")</strong> @(Lang.IsRtl ? "شديدة التعقيد؛ نادراً ما تُدعم في مسارات البيانات السريرية التشغيلية اليومية." : "Very complex; rarely supported for operational clinical feeds.")</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Architectural Comparison Matrix -->
            <div class="table-responsive">
                <table class="table table-bordered table-sm small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@(Lang.IsRtl ? "السيناريو السريري" : "Scenario")</th>
                            <th>@(Lang.IsRtl ? "الصيغة الموصى بها" : "Recommended Format")</th>
                            <th>@(Lang.IsRtl ? "طبقة النقل والشبكة" : "Transport Layer")</th>
                            <th>@(Lang.IsRtl ? "المسوغ والتعليل المعماري" : "Rationale")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "بوابة / تطبيق الجوّال للمرضى" : "Patient Mobile Portal / App")</strong></td>
                            <td><span class="badge bg-success">FHIR JSON</span></td>
                            <td style="direction: ltr; text-align: left;">HTTPS REST / OAuth2</td>
                            <td>@(Lang.IsRtl ? "الأسرع في المعالجة على iOS و Android؛ أصغر حمولة؛ متوافقة أصلياً مع بيئات الويب." : "Fastest parsing on iOS/Android; smallest payload; native web serialization.")</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "نقل السجلات بين المستشفيات (USCDI)" : "Hospital-to-Hospital Record Transfer (USCDI)")</strong></td>
                            <td><span class="badge bg-primary">C-CDA XML</span></td>
                            <td style="direction: ltr; text-align: left;">Direct Secure Messaging / XCA</td>
                            <td>@(Lang.IsRtl ? "إلزامية في المعايير القانونية للملخصات السريرية المعتمدة مع التحقق الصارم بواسطة Schematron." : "Federally mandated for legal clinical summary documents with Schematron validation.")</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "أجهزة التحليل المخبري داخل المستشفى ← LIS" : "In-Hospital Lab Analyzer Machine → LIS")</strong></td>
                            <td><span class="badge bg-warning text-dark">HL7 v2 ER7</span></td>
                            <td style="direction: ltr; text-align: left;">MLLP over raw TCP Sockets</td>
                            <td>@(Lang.IsRtl ? "تعمل على وحدات تحكم مدمجة بذاكرة متواضعة؛ إرسال موجه نحو التدفق المتصل بدون حمولة بروتوكولات إضافية." : "Runs on embedded microcontrollers with minimal RAM; stream-oriented delivery.")</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "الرسوم البيانية المعرفية للطب الحيوي وعلم الصيدلة الجيني" : "Biomedical Knowledge Graph & Pharmacogenomics")</strong></td>
                            <td><span class="badge bg-info text-dark">RDF / Turtle</span></td>
                            <td style="direction: ltr; text-align: left;">SPARQL / Graph Endpoints</td>
                            <td>@(Lang.IsRtl ? "تتيح الاستدلال الدلالي والأنطولوجي المتقدم عبر قواعد بيانات التفاعلات الدوائية المعقدة." : "Enables ontological reasoning across drug-drug interaction databases.")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- THE ROSETTA STONE & 1989 HISTORICAL ORIGINS -->
    <div id="topic-rosetta" class="card shadow-sm mb-4 border-warning border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-translate text-warning me-2"></i> @(Lang.IsRtl ? "حجر رشيد والنشأة التاريخية عام 1989" : "The Rosetta Stone & 1989 Historical Origins")
            </h5>
            <span class="badge bg-warning text-dark">@(Lang.IsRtl ? "الترجمة المفاهيمية" : "Conceptual Translation")</span>
        </div>
        <div class="card-body p-3">
            <!-- 1989 vs Modern Web Infographic -->
            <div class="p-3 mb-4 rounded bg-dark text-light border">
                <h6 class="fw-bold text-warning mb-2">
                    <i class="bi bi-clock-history me-1"></i> @(Lang.IsRtl ? "لماذا تبدو رسائل HL7 v2 كأنابيب وقبعات؟ (واقع شبكات عام 1989)" : "Why Does HL7 v2 Look Like Pipes & Hats? (The 1989 Wire Reality)")
                </h6>
                <div class="row g-3 small">
                    <div class="col-md-6 border-end border-secondary pe-3">
                        <strong class="text-info d-block mb-1">@(Lang.IsRtl ? "1989: نشأة وولادة معيار HL7 v2" : "1989: The Genesis of HL7 v2")</strong>
                        <ul class="text-white-50 ps-3 mb-0" style="font-size: 0.8rem;">
                            <li><strong>@(Lang.IsRtl ? "قيود العتاد:" : "Hardware Constraints:")</strong> @(Lang.IsRtl ? "كانت الحواسيب تعمل بمعالجات Intel 80286/80386 مع ذاكرة 640 كيلوبايت فقط." : "Computers ran Intel 80286/80386 chips with 640 KB RAM.")</li>
                            <li><strong>@(Lang.IsRtl ? "الشبكات:" : "Networking:")</strong> @(Lang.IsRtl ? "كابلات تسلسلية RS-232 ومودمات بسرعة 1200 باود؛ كانت حزمة البيانات شحيحة وثمينة للغاية." : "Raw RS-232 serial cables and 1200-baud modems; bandwidth was exceptionally scarce.")</li>
                            <li><strong>@(Lang.IsRtl ? "لماذا الفواصل؟" : "Why Delimiters?")</strong> @(Lang.IsRtl ? "بحذف وسوم الخصائص مثل (\"patientName\": \"Smith\")، اختصرت صيغة ER7 ما يزيد عن 90% من حجم البايتات. رسالة تنويم كاملة كانت تتسع في 300 بايت فقط!" : "By omitting XML/JSON property tags (like \"patientName\": \"Smith\"), ER7 stripped out 90% of wire bytes. An entire admission message fit in 300 bytes!")</li>
                            <li><strong>@(Lang.IsRtl ? "تكلفة التحليل:" : "Cost of Parsing:")</strong> @(Lang.IsRtl ? "كانت وحدات المعالجة البسيطة تقسم السلسلة على محرف ASCII 0x7C (|) في ميكروثانية دون استهلاك ذاكرة إضافية." : "Microcontrollers could split on ASCII 0x7C (|) in microseconds with zero string allocations.")</li>
                        </ul>
                    </div>
                    <div class="col-md-6 ps-3">
                        <strong class="text-success d-block mb-1">@(Lang.IsRtl ? "2014 ← 2026: عصر معيار FHIR المبني على REST" : "2014 → 2026: The FHIR REST Era")</strong>
                        <ul class="text-white-50 ps-3 mb-0" style="font-size: 0.8rem;">
                            <li><strong>@(Lang.IsRtl ? "البيئة الحديثة:" : "Modern Environment:")</strong> @(Lang.IsRtl ? "الهواتف الذكية، الخدمات المصغرة السحابية، وشبكات الجيل الخامس 5G فائقة السرعة." : "Smartphones, cloud microservices, and 5G gigabit networks.")</li>
                            <li><strong>@(Lang.IsRtl ? "لماذا JSON؟" : "Why JSON?")</strong> @(Lang.IsRtl ? "سعة الشبكات أصبحت وفيرة ورخيصة؛ تجربة المطورين والتحقق من المخططات وأفعال REST أصبحت ذات قيمة أعلى بكثير." : "Bandwidth is cheap; developer ergonomics, JSON schema validation, and RESTful verbs are far more valuable.")</li>
                            <li><strong>@(Lang.IsRtl ? "أصلية للويب:" : "Web-Native:")</strong> @(Lang.IsRtl ? "يستطيع مطورو الويب استهلاك GET /Patient/123 باستخدام fetch() الأصيل في JavaScript دون الحاجة لمحركات تحليل اتصالات مخصصة." : "Web developers can consume GET /Patient/123 using native JavaScript fetch() without specialized telecom parsing engines.")</li>
                            <li><strong>@(Lang.IsRtl ? "أمان SMART:" : "SMART Authorization:")</strong> @(Lang.IsRtl ? "مدعوم برموز تفويض OAuth2 القياسية بدلاً من تدفقات TCP الخام غير الموثقة." : "Backed by standard OAuth2 tokens rather than unauthenticated raw TCP streams.")</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- The Rosetta Stone Translation Table -->
            <h6 class="fw-bold text-dark mb-2">
                <i class="bi bi-arrow-left-right text-primary me-1"></i> @(Lang.IsRtl ? "حجر رشيد لمهندسي ومطوري الأنظمة الصحية" : "The Healthcare Developer's Rosetta Stone")
            </h6>
            <p class="small text-muted mb-2">
                @(Lang.IsRtl ? "ترجمة النماذج العقلية بين بنية المقاطع الهرمية لـ HL7 v2 المعتمدة على الأحداث وشبكة الموارد المترابطة لمعيار FHIR:"
                             : "Translating mental models between HL7 v2's event-driven segment trees and FHIR's resource-oriented graph:")
            </p>
            <div class="table-responsive">
                <table class="table table-bordered table-sm small mb-0 table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%;">@(Lang.IsRtl ? "المفهوم السريري" : "Clinical Concept")</th>
                            <th style="width: 35%;">@(Lang.IsRtl ? "ما يقابله في HL7 v2 ER7" : "HL7 v2 ER7 Equivalent")</th>
                            <th style="width: 40%;">@(Lang.IsRtl ? "ما يقابله في موارد FHIR R4" : "FHIR R4 Resource Equivalent")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "بيانات المريض ورقم السجل الطبي (MRN)" : "Patient Demographics & MRN")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>PID-3</code> (MRN) &bull; <code>PID-5</code> (Family^Given) &bull; <code>PID-7</code> (DOB)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">Patient</span> (<code>.identifier[]</code>, <code>.name.family</code>, <code>.birthDate</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "الإقامة بالمستشفى / زيارة العيادة" : "Hospital Stay / Clinic Visit")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>PV1-2</code> (Patient Class) &bull; <code>PV1-3</code> (Room/Bed) &bull; <code>PV1-44</code> (Admit)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">Encounter</span> (<code>.class</code>, <code>.location[]</code>, <code>.period.start</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "الطبيب المعالج المسؤول" : "Attending Doctor")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>PV1-7</code> (ID^Family^Given)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">Practitioner</span> referenced via <code>Encounter.participant</code></td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "طلب الفحص المخبري / الأشعة" : "Diagnostic Lab / Radiology Order")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>ORC-2</code> / <code>OBR-2</code> (Placer #) &bull; <code>OBR-4</code> (LOINC Code)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">ServiceRequest</span> (<code>.identifier</code>, <code>.code</code>, <code>.intent</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "تقرير التحاليل المخبرية / تقرير الأشعة" : "Laboratory Panel / Radiology Report")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>OBR</code> Segment &bull; <code>OBR-25</code> (Status: F=Final)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">DiagnosticReport</span> (<code>.status</code>, <code>.code</code>, <code>.result[]</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "نتيجة فحص مخبري منفردة / علامة حيوية" : "Individual Lab Result / Vital Sign")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>OBX-2</code> (NM/ST) &bull; <code>OBX-3</code> (LOINC) &bull; <code>OBX-5</code> (Val) &bull; <code>OBX-6</code> (Units)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">Observation</span> (<code>.code</code>, <code>.valueQuantity</code>, <code>.interpretation</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "التشخيص الطبي السريري / المشكلة الصحية" : "Clinical Diagnosis / Problem")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>DG1-3</code> (ICD-10 Code) &bull; <code>DG1-6</code> (Type: A=Admit)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">Condition</span> linked via <code>Encounter.diagnosis</code></td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "حزمة الرسالة المتكاملة" : "Complete Message Package")</strong></td>
                            <td style="direction: ltr; text-align: left;">Whole ER7 stream (MSH &rarr; PID &rarr; PV1 &rarr; OBR &rarr; OBX)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">Bundle</span> (type = <code>collection</code> or <code>transaction</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>@(Lang.IsRtl ? "إشعار الاستلام / الرد البرمجي" : "Acknowledgment / Response")</strong></td>
                            <td style="direction: ltr; text-align: left;"><code>MSA-1</code> (<code>AA</code>=Accept, <code>AE</code>=Error, <code>AR</code>=Reject)</td>
                            <td style="direction: ltr; text-align: left;"><span class="badge bg-success">OperationOutcome</span> (<code>.issue.severity</code>, <code>.issue.code</code>)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TOPIC 2: HL7 DELIMITERS, OPERATORS, & ESCAPE SEQUENCES -->
    <div id="topic-operators" class="card shadow-sm mb-4 border-warning border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-code-slash me-2"></i> @(Lang.IsRtl ? "الموضوع 2: الدليل الشامل لفواصل ومحارف الهروب في HL7 v2" : "Topic 2: Masterclass on HL7 v2 Operators, Delimiters & Escapes")
            </h5>
            <span class="badge bg-warning text-dark">@(Lang.IsRtl ? "تحليل متعمق للبنية" : "Syntax Deep Dive")</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                @(Lang.IsRtl ? "لا يستخدم معيار HL7 v2 علامات الاقتباس أو الأقواس المعقوفة. كل شيء يتم التحكم به عبر 5 فواصل هيكلية أساسية يتم التصريح عنها ديناميكياً في بداية مقطع MSH:"
                             : "HL7 v2 does not use quotes or curly braces. Everything is controlled by 5 primary structural operators declared dynamically in the MSH segment:")
            </p>

            <div class="p-2 mb-3 bg-dark text-light rounded font-monospace small" style="direction: ltr; text-align: left;">
                <span class="text-warning">MSH</span><span class="text-danger">|</span><span class="text-info">^~\&amp;</span><span class="text-danger">|</span>HIS<span class="text-danger">|</span>HOSPITAL_A<span class="text-danger">|</span>...
                <div class="text-muted mt-1" style="font-size: 0.78rem;">
                    &bull; @(Lang.IsRtl ? "البايت رقم 4 هو فاصل الحقول (|)" : "Byte 4 is | (Field Delimiter)")<br />
                    &bull; @(Lang.IsRtl ? "البايتات من 5 إلى 8 هي فواصل المكونات والتكرار والهروب والمكونات الفرعية (^~\\&)" : "Bytes 5-8 are ^~\\& (Component, Repetition, Escape, Subcomponent)")
                </div>
            </div>

            <!-- The 5 Primary Delimiters Table -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-sm small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">@(Lang.IsRtl ? "المحرف" : "Operator")</th>
                            <th style="width: 20%;">@(Lang.IsRtl ? "الاسم" : "Name")</th>
                            <th style="width: 30%;">@(Lang.IsRtl ? "الغرض والمستوى الهيكلي" : "Purpose & Hierarchy")</th>
                            <th style="width: 40%;">@(Lang.IsRtl ? "مثال عملي في ER7" : "Real-World ER7 Example")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-danger fw-bold" style="direction: ltr;">|</td>
                            <td><strong>@(Lang.IsRtl ? "فاصل الحقول" : "Field Delimiter")</strong></td>
                            <td>@(Lang.IsRtl ? "يفصل بين الحقول السريرية الرئيسية في المقطع الواحد (أعلى مستوى هيكلي)." : "Separates major clinical fields in a segment. (Highest structural level).")</td>
                            <td style="direction: ltr; text-align: left;"><code>PID|1||MRN1002||Smith^Eleanor</code><br /><span class="text-muted">@(Lang.IsRtl ? "يفصل معرّف الترتيب، المعرفات، والأسماء." : "Splits Set ID, IDs, and Names.")</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-primary fw-bold" style="direction: ltr;">^</td>
                            <td><strong>@(Lang.IsRtl ? "فاصل المكونات" : "Component Delimiter")</strong></td>
                            <td>@(Lang.IsRtl ? "يفصل بين الأجزاء الفرعية لنوع بيانات مركب (مثل: العائلة^الاسم الشخصي، أو الكود^النص^النظام)." : "Separates sub-parts of a composite datatype (e.g. Family^Given, or Code^Text^System).")</td>
                            <td style="direction: ltr; text-align: left;"><code>PID-5: Smith^Eleanor^Jane</code><br /><span class="text-muted">@(Lang.IsRtl ? "العائلة (Smith) ^ الشخصي (Eleanor) ^ الأوسط (Jane)." : "Family (Smith) ^ Given (Eleanor) ^ Middle (Jane).")</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-warning fw-bold" style="direction: ltr;">~</td>
                            <td><strong>@(Lang.IsRtl ? "محرف التكرار" : "Repetition Character")</strong></td>
                            <td>@(Lang.IsRtl ? "يتيح تكرار الحقل عدة مرات دون إنشاء مقطع جديد (مثل تكرار أرقام الهواتف)." : "Allows a field to repeat multiple times without creating a new segment (e.g. multiple phone numbers).")</td>
                            <td style="direction: ltr; text-align: left;"><code>PID-13: 5125550199~5125559876</code><br /><span class="text-muted">@(Lang.IsRtl ? "المريض لديه رقما هاتف مسجلان في حقل واحد." : "Patient has two registered phone numbers.")</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-info fw-bold" style="direction: ltr;">\</td>
                            <td><strong>@(Lang.IsRtl ? "محرف الهروب" : "Escape Character")</strong></td>
                            <td>@(Lang.IsRtl ? "ينبه المحلل إلى أن المحرف التالي هو تسلسل هروب، لمنع الفواصل الحرفية من كسر المعالجة." : "Flags that the following character is an escape sequence, preventing literal delimiters from breaking the parser.")</td>
                            <td style="direction: ltr; text-align: left;"><code>OBX-5: Severe \F\ Acute Pain</code><br /><span class="text-muted">@(Lang.IsRtl ? "\\F\\ يُدرج رمز الخط العمودي | داخل النص السريري بأمان." : "\\F\\ inserts a literal pipe character inside clinical text.")</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-success fw-bold" style="direction: ltr;">&amp;</td>
                            <td><strong>@(Lang.IsRtl ? "فاصل المكونات الفرعية" : "Subcomponent Delimiter")</strong></td>
                            <td>@(Lang.IsRtl ? "يفصل بين الأجزاء الدقيقة داخل المكون الواحد (أدنى مستوى هيكلي)." : "Separates micro-parts within a component (lowest structural hierarchy level).")</td>
                            <td style="direction: ltr; text-align: left;"><code>PID-3: 12345^^^HOSP&amp;MAIN_CAMPUS^MR</code><br /><span class="text-muted">@(Lang.IsRtl ? "الجهة المصدرة تمتلك منشأة فرعية HOSP&MAIN_CAMPUS." : "Assigning Authority has sub-facility HOSP&MAIN_CAMPUS.")</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Escape Sequences Cheat Sheet -->
            <h6 class="fw-bold text-dark mb-2">
                <i class="bi bi-shield-exclamation text-warning me-1"></i> @(Lang.IsRtl ? "ورقة الغش الرسمية لتسلسلات الهروب في HL7" : "The Official HL7 Escape Sequences Cheat Sheet")
            </h6>
            <p class="small text-muted mb-2">
                @(Lang.IsRtl ? "ماذا يحدث إذا كتب الطبيب ملاحظة: \"ارتفاع ضغط الدم | دوخة لدى المريض\"؟ إذا أرسلت خط الأنبوب الحرفي (|)، سيعتقد المحلل أنه حقل جديد وينهار النظام! يجب عليك استبداله بمحرف الهروب الرسمي:"
                             : "What happens if a doctor types \"Blood pressure elevated | Patient dizzy\"? If you send a literal pipe |, the parser thinks it is a new field and crashes! You must escape it using the official HL7 escape table:")
            </p>

            <div class="row g-2 small">
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-danger">\F\</code> &rarr; <strong>@(Lang.IsRtl ? "فاصل الحقول (|)" : "Field Separator (|)")</strong><br />
                        <span class="text-muted">@(Lang.IsRtl ? "مثال: Chest \\F\\ Lung Pain تصبح Chest | Lung Pain." : "Example: Chest \\F\\ Lung Pain becomes Chest | Lung Pain.")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-primary">\S\</code> &rarr; <strong>@(Lang.IsRtl ? "فاصل المكونات (^)" : "Component Separator (^)")</strong><br />
                        <span class="text-muted">@(Lang.IsRtl ? "مثال: Smith \\S\\ Jones Clinic تصبح Smith ^ Jones Clinic." : "Example: Smith \\S\\ Jones Clinic becomes Smith ^ Jones Clinic.")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-warning">\R\</code> &rarr; <strong>@(Lang.IsRtl ? "فاصل التكرار (~)" : "Repetition Separator (~)")</strong><br />
                        <span class="text-muted">@(Lang.IsRtl ? "مثال: Approx \\R\\ 5 days تصبح Approx ~ 5 days." : "Example: Approx \\R\\ 5 days becomes Approx ~ 5 days.")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-info">\E\</code> &rarr; <strong>@(Lang.IsRtl ? "محرف الهروب (\\)" : "Escape Character (\\)")</strong><br />
                        <span class="text-muted">@(Lang.IsRtl ? "مثال: Dose: 5mg\\E\\day تصبح Dose: 5mg\\day." : "Example: Dose: 5mg\\E\\day becomes Dose: 5mg\\day.")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-success">\T\</code> &rarr; <strong>@(Lang.IsRtl ? "المكون الفرعي (&)" : "Subcomponent (&)")</strong><br />
                        <span class="text-muted">@(Lang.IsRtl ? "مثال: Research \\T\\ Development تصبح Research & Development." : "Example: Research \\T\\ Development becomes Research & Development.")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-dark">\.br\</code> &rarr; <strong>@(Lang.IsRtl ? "سطر جديد إجباري" : "Hard Line Break")</strong><br />
                        <span class="text-muted">@(Lang.IsRtl ? "تُستخدم في ملاحظات الطبيب (NTE و TX) لبدء فقرة جديدة." : "Used in doctor notes (NTE, TX) to start a new paragraph line.")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOPIC 3: 5 REAL-WORLD HL7 MESSAGES WITH SURGERY-LEVEL DISSECTIONS -->
    <div id="topic-messages" class="card shadow-sm mb-4 border-danger border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-danger">
                <i class="bi bi-heart-pulse-fill me-2"></i> @(Lang.IsRtl ? "الموضوع 3: تشريح 5 رسائل واقعية على مستوى جراحي دقيق" : "Topic 3: 5 Real-World Messages with \"Surgery-Level\" Dissection")
            </h5>
            <span class="badge bg-danger">@(Lang.IsRtl ? "التشريح السريري" : "Clinical Anatomy")</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                @(Lang.IsRtl ? "تمثل عائلات الرسائل الخمس هذه أكثر من 90% من إجمالي حركة البيانات في محركات تكامل المستشفيات عالمياً. حدد أي رسالة أدناه لتفحص تدفقها الخام وتشريحها السريري مقطعاً بمقطع:"
                             : "These 5 message families represent over 90% of all hospital interface engine traffic worldwide. Select any message below to inspect its raw stream and segment-by-segment clinical anatomy:")
            </p>

            <!-- Message Selector Tabs -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                @for (int m = 0; m < SurgicalMessages.Count; m++)
                {
                    var msgIndex = m;
                    var item = SurgicalMessages[msgIndex];
                    <button class="btn btn-sm @(selectedMessageIndex == msgIndex ? "btn-danger fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                            @onclick="() => selectedMessageIndex = msgIndex">
                        <span class="badge bg-dark me-1" style="direction: ltr;">@item.EventCode</span> @(Lang.IsRtl && !string.IsNullOrEmpty(item.TitleAr) ? item.TitleAr : item.Title)
                    </button>
                }
            </div>

            <!-- Active Message Deep Dive View -->
            @{
                var activeMsg = SurgicalMessages[selectedMessageIndex];
            }
            <div class="card border bg-light shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                    <div>
                        <span class="badge bg-danger fs-6 me-2" style="direction: ltr;">@activeMsg.EventCode</span>
                        <strong class="text-dark">@(Lang.IsRtl && !string.IsNullOrEmpty(activeMsg.TitleAr) ? activeMsg.TitleAr : activeMsg.Title)</strong>
                    </div>
                    <span class="text-muted small">@(Lang.IsRtl && !string.IsNullOrEmpty(activeMsg.CategoryAr) ? activeMsg.CategoryAr : activeMsg.Category)</span>
                </div>
                <div class="card-body p-3">
                    <!-- Clinical Context Story -->
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <strong><i class="bi bi-hospital me-1"></i> @(Lang.IsRtl ? "السياق والأهمية السريرية:" : "Clinical Context & Significance:")</strong>
                        <div>@(Lang.IsRtl && !string.IsNullOrEmpty(activeMsg.ClinicalStoryAr) ? activeMsg.ClinicalStoryAr : activeMsg.ClinicalStory)</div>
                    </div>

                    <!-- Raw ER7 Block -->
                    <h6 class="fw-bold small text-muted mb-1">@(Lang.IsRtl ? "تدفق رسالة HL7 v2 ER7 الخام:" : "Raw HL7 v2 ER7 Stream:")</h6>
                    <pre class="bg-dark text-light p-3 rounded font-monospace small mb-3 overflow-auto" style="direction: ltr !important; text-align: left !important; unicode-bidi: isolate; max-height: 220px; white-space: pre-wrap; word-break: break-all;"><code>@activeMsg.RawEr7</code></pre>

                    <!-- Surgery-Level Segment-by-Segment Dissection -->
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-tools text-danger me-1"></i> @(Lang.IsRtl ? "التشريح الدقيق مقطعاً بمقطع (Surgery-Level):" : "Segment-by-Segment \"Surgery-Level\" Breakdown:")
                    </h6>
                    <div class="accordion" id="surgicalSegmentsAccordion">
                        @for (int s = 0; s < activeMsg.Segments.Count; s++)
                        {
                            var segIndex = s;
                            var seg = activeMsg.Segments[segIndex];
                            var collapseId = $"collapseSurgSeg_{selectedMessageIndex}_{segIndex}";
                            var isFirst = segIndex == 0;

                            <div class="accordion-item mb-2 border rounded">
                                <h2 class="accordion-header" id="@($"headingSurgSeg_{segIndex}")">
                                    <button class="accordion-button @(isFirst ? "" : "collapsed") py-2 px-3 bg-white" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#@collapseId">
                                        <span class="badge bg-dark me-2 font-monospace" style="direction: ltr;">@seg.SegmentId</span>
                                        <strong class="me-2 small">@(Lang.IsRtl && !string.IsNullOrEmpty(seg.NameAr) ? seg.NameAr : seg.Name)</strong>
                                        <span class="text-muted small ms-auto me-3 font-monospace" style="direction: ltr; text-align: left; unicode-bidi: isolate;">@seg.RawLine</span>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")">
                                    <div class="accordion-body p-2 bg-light">
                                        <div class="table-responsive bg-white rounded border">
                                            <table class="table table-sm table-hover mb-0 small">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 15%;">@(Lang.IsRtl ? "موقع الحقل" : "Field Position")</th>
                                                        <th style="width: 25%;">@(Lang.IsRtl ? "اسم الحقل والمواصفة" : "Field Name & Spec")</th>
                                                        <th style="width: 25%;">@(Lang.IsRtl ? "القيمة الخام" : "Raw Value")</th>
                                                        <th style="width: 35%;">@(Lang.IsRtl ? "المعنى السريري والتنبيه الهندسي" : "Clinical Meaning & Engineering Gotcha")</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var field in seg.Fields)
                                                    {
                                                        <tr>
                                                            <td class="font-monospace fw-bold text-primary" style="direction: ltr; text-align: left;">@field.Position</td>
                                                            <td class="text-dark fw-semibold">@(Lang.IsRtl && !string.IsNullOrEmpty(field.NameAr) ? field.NameAr : field.Name)</td>
                                                            <td class="font-monospace text-danger" style="direction: ltr; text-align: left; unicode-bidi: isolate;">@field.Value</td>
                                                            <td class="text-muted">@(Lang.IsRtl && !string.IsNullOrEmpty(field.ClinicalMeaningAr) ? field.ClinicalMeaningAr : field.ClinicalMeaning)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOPIC 4: PATIENT JOURNEY SIMULATOR -->
    <div id="topic-journey" class="card shadow-sm mb-4 border-success border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-success">
                <i class="bi bi-clock-history me-2"></i> @(Lang.IsRtl ? "الموضوع 4: محاكي رحلة المريض (تدفق العمليات خلال 24 ساعة)" : "Topic 4: The Patient Journey Simulator (24-Hour Hospital Flow)")
            </h5>
            <span class="badge bg-success">@(Lang.IsRtl ? "خطوات تفاعلية" : "Interactive Stepper")</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                @(Lang.IsRtl ? "تتبع رحلة المريضة إليانور سميث خلال 24 ساعة في المستشفى لترى كيف يُطلق كل حدث سريري رسائل v2 المقابلة وموارد FHIR المرتبطة بها:"
                             : "Step through Eleanor Smith's 24-hour hospitalization to see how each clinical event triggers corresponding v2 messages and FHIR resources:")
            </p>

            <!-- Stepper Buttons -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-sm @(currentJourneyStep == 1 ? "btn-success fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                        @onclick="() => currentJourneyStep = 1">
                    <span class="badge bg-dark me-1">1</span> @(Lang.IsRtl ? "10:00 ص: وصول العيادات الخارجية" : "10:00 AM: Outpatient Arrival")
                </button>
