@rendermode InteractiveServer

<PageTitle>Get Started - The Master Healthcare Interoperability Guide</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Hero Header -->
    <div class="p-4 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #198754 0%, #0d6efd 100%);">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-light text-dark mb-2 px-3 py-1 fw-semibold">In-Depth Healthcare Engineering Curriculum</span>
                <h1 class="h2 fw-bold mb-1">HL7 v2 & FHIR: The Master Educational Guide</h1>
                <p class="mb-0 text-white-50">
                    Comprehensive deep-dive covering body formats (JSON vs XML vs ER7), delimiters and escape operators, 5 surgical message dissections, and interactive tools.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="bridge" class="btn btn-warning fw-bold px-3">
                    <i class="bi bi-shuffle me-1"></i> Open Live Bridge
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Bar -->
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 align-items-center small">
                <span class="fw-bold text-muted me-1"><i class="bi bi-compass"></i> Jump to Topic:</span>
                <a href="get-started#topic-formats" class="btn btn-sm btn-outline-primary py-0">1. JSON vs XML vs ER7</a>
                <a href="get-started#topic-rosetta" class="btn btn-sm btn-outline-warning py-0 fw-semibold">The Rosetta Stone &amp; 1989 Origins</a>
                <a href="get-started#topic-operators" class="btn btn-sm btn-outline-primary py-0">2. HL7 Delimiters &amp; Operators</a>
                <a href="get-started#topic-messages" class="btn btn-sm btn-outline-primary py-0">3. 5 Deep-Dive Messages</a>
                <a href="get-started#topic-journey" class="btn btn-sm btn-outline-primary py-0">4. Patient Journey Simulator</a>
                <a href="get-started#topic-jargon" class="btn btn-sm btn-outline-primary py-0">5. Jargon Buster Dictionary</a>
                <a href="get-started#topic-quiz" class="btn btn-sm btn-outline-primary py-0">6. Practice Quiz &amp; Specs</a>
            </div>
        </div>
    </div>

    <!-- TOPIC 1: WHEN TO USE DATA BODY TYPES (JSON vs XML vs ER7 vs RDF) -->
    <div id="topic-formats" class="card shadow-sm mb-4 border-primary border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-primary">
                <i class="bi bi-file-earmark-binary-fill me-2"></i> Topic 1: When to Use Payload Formats (JSON vs XML vs ER7 vs RDF)
            </h5>
            <span class="badge bg-primary">Architecture Decision Guide</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                Healthcare software interchanges clinical data across four primary formats. Knowing <em>which</em> format to select is essential for architectural planning:
            </p>

            <div class="row g-3 mb-3">
                <!-- JSON Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-success">JSON (JavaScript Object Notation)</span>
                            <span class="badge bg-success">FHIR Standard</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>When to use:</strong> Modern web apps, mobile apps, RESTful FHIR APIs (SMART on FHIR), cloud microservices, and public health data exchanges.
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>Pros:</strong> Compact, no closing tags, parsed natively by browsers, .NET <code>System.Text.Json</code>, Python, and TypeScript.</li>
                                <li><strong>Cons:</strong> Lacks native schema validation out of the box (requires FHIR JSON Schemas).</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- XML Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-primary">XML (eXtensible Markup)</span>
                            <span class="badge bg-primary">C-CDA / Enterprise</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>When to use:</strong> Document-based exchanges like <strong>C-CDA (Continuity of Care Documents)</strong>, enterprise SOAP/ESB feeds, and legal medical records archiving.
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>Pros:</strong> Strict validation via XSD and Schematron rules; native digital signatures (XML-DSig).</li>
                                <li><strong>Cons:</strong> Verbose closing tags inflate payload size by 30-50%; heavier memory footprint.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- ER7 Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-warning text-dark">ER7 (Pipe-and-Hat)</span>
                            <span class="badge bg-warning text-dark">HL7 v2 Legacy</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>When to use:</strong> Real-time hospital interface engines (Mirth, Cloverleaf, Rhapsody), bedside medical devices, and internal EHR-to-LIS socket feeds.
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>Pros:</strong> Ultra-lightweight ASCII byte stream; tiny bandwidth footprint; instantaneous parsing on older hardware.</li>
                                <li><strong>Cons:</strong> Cryptic syntax; position-dependent; difficult for web browsers to consume directly.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Turtle / RDF Card -->
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 border shadow-sm">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold text-info text-dark">Turtle / RDF</span>
                            <span class="badge bg-info text-dark">Knowledge Graphs</span>
                        </div>
                        <div class="card-body p-2 small d-flex flex-column">
                            <p class="text-muted mb-2 flex-grow-1">
                                <strong>When to use:</strong> Academic biomedical research, clinical ontologies (SNOMED/OBO graph traversals), and AI reasoning systems.
                            </p>
                            <ul class="list-unstyled text-muted mb-0" style="font-size: 0.78rem;">
                                <li><strong>Pros:</strong> Native semantic triple structure (Subject &rarr; Predicate &rarr; Object).</li>
                                <li><strong>Cons:</strong> Very complex; rarely supported for operational clinical feeds.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Architectural Comparison Matrix -->
            <div class="table-responsive">
                <table class="table table-bordered table-sm small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Scenario</th>
                            <th>Recommended Format</th>
                            <th>Transport Layer</th>
                            <th>Rationale</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Patient Mobile Portal / App</strong></td>
                            <td><span class="badge bg-success">FHIR JSON</span></td>
                            <td>HTTPS REST / OAuth2</td>
                            <td>Fastest parsing on iOS/Android; smallest payload; native web serialization.</td>
                        </tr>
                        <tr>
                            <td><strong>Hospital-to-Hospital Record Transfer (USCDI)</strong></td>
                            <td><span class="badge bg-primary">C-CDA XML</span></td>
                            <td>Direct Secure Messaging / XCA</td>
                            <td>Federally mandated for legal clinical summary documents with Schematron validation.</td>
                        </tr>
                        <tr>
                            <td><strong>In-Hospital Lab Analyzer Machine &rarr; LIS</strong></td>
                            <td><span class="badge bg-warning text-dark">HL7 v2 ER7</span></td>
                            <td>MLLP over raw TCP Sockets</td>
                            <td>Runs on embedded microcontrollers with minimal RAM; stream-oriented delivery.</td>
                        </tr>
                        <tr>
                            <td><strong>Biomedical Knowledge Graph &amp; Pharmacogenomics</strong></td>
                            <td><span class="badge bg-info text-dark">RDF / Turtle</span></td>
                            <td>SPARQL / Graph Endpoints</td>
                            <td>Enables ontological reasoning across drug-drug interaction databases.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- THE ROSETTA STONE & 1989 HISTORICAL ORIGINS -->
    <div id="topic-rosetta" class="card shadow-sm mb-4 border-warning border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-translate text-warning me-2"></i> The Rosetta Stone &amp; 1989 Historical Origins
            </h5>
            <span class="badge bg-warning text-dark">Conceptual Translation</span>
        </div>
        <div class="card-body p-3">
            <!-- 1989 vs Modern Web Infographic -->
            <div class="p-3 mb-4 rounded bg-dark text-light border">
                <h6 class="fw-bold text-warning mb-2"><i class="bi bi-clock-history me-1"></i> Why Does HL7 v2 Look Like Pipes &amp; Hats? (The 1989 Wire Reality)</h6>
                <div class="row g-3 small">
                    <div class="col-md-6 border-end border-secondary pe-3">
                        <strong class="text-info d-block mb-1">1989: The Genesis of HL7 v2</strong>
                        <ul class="text-white-50 ps-3 mb-0" style="font-size: 0.8rem;">
                            <li><strong>Hardware Constraints:</strong> Computers ran Intel 80286/80386 chips with 640 KB RAM.</li>
                            <li><strong>Networking:</strong> Raw RS-232 serial cables and 1200-baud modems; bandwidth was exceptionally scarce.</li>
                            <li><strong>Why Delimiters?</strong> By omitting XML/JSON property tags (like <code>"patientName": "Smith"</code>), ER7 stripped out 90% of wire bytes. An entire admission message fit in 300 bytes!</li>
                            <li><strong>Cost of Parsing:</strong> Microcontrollers could split on ASCII <code>0x7C</code> (<code>|</code>) in microseconds with zero string allocations.</li>
                        </ul>
                    </div>
                    <div class="col-md-6 ps-3">
                        <strong class="text-success d-block mb-1">2014 &rarr; 2026: The FHIR REST Era</strong>
                        <ul class="text-white-50 ps-3 mb-0" style="font-size: 0.8rem;">
                            <li><strong>Modern Environment:</strong> Smartphones, cloud microservices, and 5G gigabit networks.</li>
                            <li><strong>Why JSON?</strong> Bandwidth is cheap; developer ergonomics, JSON schema validation, and RESTful verbs are far more valuable.</li>
                            <li><strong>Web-Native:</strong> Web developers can consume <code>GET /Patient/123</code> using native JavaScript <code>fetch()</code> without specialized telecom parsing engines.</li>
                            <li><strong>SMART Authorization:</strong> Backed by standard OAuth2 tokens rather than unauthenticated raw TCP streams.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- The Rosetta Stone Translation Table -->
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-arrow-left-right text-primary me-1"></i> The Healthcare Developer's Rosetta Stone</h6>
            <p class="small text-muted mb-2">
                Translating mental models between HL7 v2's event-driven segment trees and FHIR's resource-oriented graph:
            </p>
            <div class="table-responsive">
                <table class="table table-bordered table-sm small mb-0 table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%;">Clinical Concept</th>
                            <th style="width: 35%;">HL7 v2 ER7 Equivalent</th>
                            <th style="width: 40%;">FHIR R4 Resource Equivalent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Patient Demographics &amp; MRN</strong></td>
                            <td><code>PID-3</code> (MRN) &bull; <code>PID-5</code> (Family^Given) &bull; <code>PID-7</code> (DOB)</td>
                            <td><span class="badge bg-success">Patient</span> (<code>.identifier[]</code>, <code>.name.family</code>, <code>.birthDate</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>Hospital Stay / Clinic Visit</strong></td>
                            <td><code>PV1-2</code> (Patient Class) &bull; <code>PV1-3</code> (Room/Bed) &bull; <code>PV1-44</code> (Admit)</td>
                            <td><span class="badge bg-success">Encounter</span> (<code>.class</code>, <code>.location[]</code>, <code>.period.start</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>Attending Doctor</strong></td>
                            <td><code>PV1-7</code> (ID^Family^Given)</td>
                            <td><span class="badge bg-success">Practitioner</span> referenced via <code>Encounter.participant</code></td>
                        </tr>
                        <tr>
                            <td><strong>Diagnostic Lab / Radiology Order</strong></td>
                            <td><code>ORC-2</code> / <code>OBR-2</code> (Placer #) &bull; <code>OBR-4</code> (LOINC Code)</td>
                            <td><span class="badge bg-success">ServiceRequest</span> (<code>.identifier</code>, <code>.code</code>, <code>.intent</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>Laboratory Panel / Radiology Report</strong></td>
                            <td><code>OBR</code> Segment &bull; <code>OBR-25</code> (Status: F=Final)</td>
                            <td><span class="badge bg-success">DiagnosticReport</span> (<code>.status</code>, <code>.code</code>, <code>.result[]</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>Individual Lab Result / Vital Sign</strong></td>
                            <td><code>OBX-2</code> (NM/ST) &bull; <code>OBX-3</code> (LOINC) &bull; <code>OBX-5</code> (Val) &bull; <code>OBX-6</code> (Units)</td>
                            <td><span class="badge bg-success">Observation</span> (<code>.code</code>, <code>.valueQuantity</code>, <code>.interpretation</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>Clinical Diagnosis / Problem</strong></td>
                            <td><code>DG1-3</code> (ICD-10 Code) &bull; <code>DG1-6</code> (Type: A=Admit)</td>
                            <td><span class="badge bg-success">Condition</span> linked via <code>Encounter.diagnosis</code></td>
                        </tr>
                        <tr>
                            <td><strong>Complete Message Package</strong></td>
                            <td>Whole ER7 stream (MSH &rarr; PID &rarr; PV1 &rarr; OBR &rarr; OBX)</td>
                            <td><span class="badge bg-success">Bundle</span> (type = <code>collection</code> or <code>transaction</code>)</td>
                        </tr>
                        <tr>
                            <td><strong>Acknowledgment / Response</strong></td>
                            <td><code>MSA-1</code> (<code>AA</code>=Accept, <code>AE</code>=Error, <code>AR</code>=Reject)</td>
                            <td><span class="badge bg-success">OperationOutcome</span> (<code>.issue.severity</code>, <code>.issue.code</code>)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TOPIC 2: HL7 DELIMITERS, OPERATORS, & ESCAPE SEQUENCES -->
    <div id="topic-operators" class="card shadow-sm mb-4 border-warning border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-code-slash me-2"></i> Topic 2: Masterclass on HL7 v2 Operators, Delimiters &amp; Escapes
            </h5>
            <span class="badge bg-warning text-dark">Syntax Deep Dive</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                HL7 v2 does not use quotes or curly braces. Everything is controlled by <strong>5 primary structural operators</strong> declared dynamically in the <code>MSH</code> segment:
            </p>

            <div class="p-2 mb-3 bg-dark text-light rounded font-monospace small">
                <span class="text-warning">MSH</span><span class="text-danger">|</span><span class="text-info">^~\&amp;</span><span class="text-danger">|</span>HIS<span class="text-danger">|</span>HOSPITAL_A<span class="text-danger">|</span>...
                <div class="text-muted mt-1" style="font-size: 0.78rem;">
                    &bull; Byte 4 is <code>|</code> (Field Delimiter)<br />
                    &bull; Bytes 5-8 are <code>^~\&amp;</code> (Component, Repetition, Escape, Subcomponent)
                </div>
            </div>

            <!-- The 5 Primary Delimiters Table -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-sm small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">Operator</th>
                            <th style="width: 20%;">Name</th>
                            <th style="width: 30%;">Purpose &amp; Hierarchy</th>
                            <th style="width: 40%;">Real-World ER7 Example</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-danger fw-bold">|</td>
                            <td><strong>Field Delimiter</strong></td>
                            <td>Separates major clinical fields in a segment. (Highest structural level).</td>
                            <td><code>PID|1||MRN1002||Smith^Eleanor</code><br /><span class="text-muted">Splits Set ID, IDs, and Names.</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-primary fw-bold">^</td>
                            <td><strong>Component Delimiter</strong></td>
                            <td>Separates sub-parts of a composite datatype (e.g. Family^Given, or Code^Text^System).</td>
                            <td><code>PID-5: Smith^Eleanor^Jane</code><br /><span class="text-muted">Family (Smith) ^ Given (Eleanor) ^ Middle (Jane).</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-warning fw-bold">~</td>
                            <td><strong>Repetition Character</strong></td>
                            <td>Allows a field to repeat multiple times without creating a new segment (e.g. multiple phone numbers).</td>
                            <td><code>PID-13: 5125550199~5125559876</code><br /><span class="text-muted">Patient has two registered phone numbers.</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-info fw-bold">\</td>
                            <td><strong>Escape Character</strong></td>
                            <td>Flags that the following character is an escape sequence, preventing literal delimiters from breaking the parser.</td>
                            <td><code>OBX-5: Severe \F\ Acute Pain</code><br /><span class="text-muted"><code>\F\</code> inserts a literal pipe character inside clinical text.</span></td>
                        </tr>
                        <tr>
                            <td class="font-monospace text-center fs-5 text-success fw-bold">&amp;</td>
                            <td><strong>Subcomponent Delimiter</strong></td>
                            <td>Separates micro-parts within a component (lowest structural hierarchy level).</td>
                            <td><code>PID-3: 12345^^^HOSP&amp;MAIN_CAMPUS^MR</code><br /><span class="text-muted">Assigning Authority has sub-facility <code>HOSP&amp;MAIN_CAMPUS</code>.</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Escape Sequences Cheat Sheet -->
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-exclamation text-warning me-1"></i> The Official HL7 Escape Sequences Cheat Sheet</h6>
            <p class="small text-muted mb-2">
                What happens if a doctor types <code>"Blood pressure elevated | Patient dizzy"</code>? If you send a literal pipe <code>|</code>, the parser thinks it is a new field and crashes!
                You must escape it using the official HL7 escape table:
            </p>

            <div class="row g-2 small">
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-danger">\F\</code> &rarr; <strong>Field Separator (<code>|</code>)</strong><br />
                        <span class="text-muted">Example: <code>Chest \F\ Lung Pain</code> becomes <code>Chest | Lung Pain</code>.</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-primary">\S\</code> &rarr; <strong>Component Separator (<code>^</code>)</strong><br />
                        <span class="text-muted">Example: <code>Smith \S\ Jones Clinic</code> becomes <code>Smith ^ Jones Clinic</code>.</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-warning">\R\</code> &rarr; <strong>Repetition Separator (<code>~</code>)</strong><br />
                        <span class="text-muted">Example: <code>Approx \R\ 5 days</code> becomes <code>Approx ~ 5 days</code>.</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-info">\E\</code> &rarr; <strong>Escape Character (<code>\</code>)</strong><br />
                        <span class="text-muted">Example: <code>Dose: 5mg\E\day</code> becomes <code>Dose: 5mg\day</code>.</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-success">\T\</code> &rarr; <strong>Subcomponent (<code>&amp;</code>)</strong><br />
                        <span class="text-muted">Example: <code>Research \T\ Development</code> becomes <code>Research &amp; Development</code>.</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <code class="fw-bold text-dark">\.br\</code> &rarr; <strong>Hard Line Break</strong><br />
                        <span class="text-muted">Used in doctor notes (<code>NTE</code>, <code>TX</code>) to start a new paragraph line.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOPIC 3: 5 REAL-WORLD HL7 MESSAGES WITH SURGERY-LEVEL DISSECTIONS -->
    <div id="topic-messages" class="card shadow-sm mb-4 border-danger border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-danger">
                <i class="bi bi-heart-pulse-fill me-2"></i> Topic 3: 5 Real-World Messages with "Surgery-Level" Dissection
            </h5>
            <span class="badge bg-danger">Clinical Anatomy</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                These 5 message families represent over <strong>90% of all hospital interface engine traffic</strong> worldwide. 
                Select any message below to inspect its raw stream and segment-by-segment clinical anatomy:
            </p>

            <!-- Message Selector Tabs -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                @for (int m = 0; m < SurgicalMessages.Count; m++)
                {
                    var msgIndex = m;
                    var item = SurgicalMessages[msgIndex];
                    <button class="btn btn-sm @(selectedMessageIndex == msgIndex ? "btn-danger fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                            @onclick="() => selectedMessageIndex = msgIndex">
                        <span class="badge bg-dark me-1">@item.EventCode</span> @item.Title
                    </button>
                }
            </div>

            <!-- Active Message Deep Dive View -->
            @{
                var activeMsg = SurgicalMessages[selectedMessageIndex];
            }
            <div class="card border bg-light shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                    <div>
                        <span class="badge bg-danger fs-6 me-2">@activeMsg.EventCode</span>
                        <strong class="text-dark">@activeMsg.Title</strong>
                    </div>
                    <span class="text-muted small">@activeMsg.Category</span>
                </div>
                <div class="card-body p-3">
                    <!-- Clinical Context Story -->
                    <div class="alert alert-info py-2 px-3 small mb-3">
                        <strong><i class="bi bi-hospital"></i> Clinical Context &amp; Significance:</strong>
                        <div>@activeMsg.ClinicalStory</div>
                    </div>

                    <!-- Raw ER7 Block -->
                    <h6 class="fw-bold small text-muted mb-1">Raw HL7 v2 ER7 Stream:</h6>
                    <pre class="bg-dark text-light p-3 rounded font-monospace small mb-3 overflow-auto" style="max-height: 220px; white-space: pre-wrap; word-break: break-all;"><code>@activeMsg.RawEr7</code></pre>

                    <!-- Surgery-Level Segment-by-Segment Dissection -->
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-tools text-danger me-1"></i> Segment-by-Segment "Surgery-Level" Breakdown:</h6>
                    <div class="accordion" id="surgicalSegmentsAccordion">
                        @for (int s = 0; s < activeMsg.Segments.Count; s++)
                        {
                            var segIndex = s;
                            var seg = activeMsg.Segments[segIndex];
                            var collapseId = $"collapseSurgSeg_{selectedMessageIndex}_{segIndex}";
                            var isFirst = segIndex == 0;

                            <div class="accordion-item mb-2 border rounded">
                                <h2 class="accordion-header" id="@($"headingSurgSeg_{segIndex}")">
                                    <button class="accordion-button @(isFirst ? "" : "collapsed") py-2 px-3 bg-white" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#@collapseId">
                                        <span class="badge bg-dark me-2 font-monospace">@seg.SegmentId</span>
                                        <strong class="me-2 small">@seg.Name</strong>
                                        <span class="text-muted small ms-auto me-3 font-monospace">@seg.RawLine</span>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")">
                                    <div class="accordion-body p-2 bg-light">
                                        <div class="table-responsive bg-white rounded border">
                                            <table class="table table-sm table-hover mb-0 small">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th style="width: 15%;">Field Position</th>
                                                        <th style="width: 25%;">Field Name &amp; Spec</th>
                                                        <th style="width: 25%;">Raw Value</th>
                                                        <th style="width: 35%;">Clinical Meaning &amp; Engineering Gotcha</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var field in seg.Fields)
                                                    {
                                                        <tr>
                                                            <td class="font-monospace fw-bold text-primary">@field.Position</td>
                                                            <td class="text-dark fw-semibold">@field.Name</td>
                                                            <td class="font-monospace text-danger">@field.Value</td>
                                                            <td class="text-muted">@field.ClinicalMeaning</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOPIC 4: PATIENT JOURNEY SIMULATOR -->
    <div id="topic-journey" class="card shadow-sm mb-4 border-success border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-success">
                <i class="bi bi-clock-history me-2"></i> Topic 4: The Patient Journey Simulator (24-Hour Hospital Flow)
            </h5>
            <span class="badge bg-success">Interactive Stepper</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                Step through Eleanor Smith's 24-hour hospitalization to see how each clinical event triggers corresponding v2 messages and FHIR resources:
            </p>

            <!-- Stepper Buttons -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-sm @(currentJourneyStep == 1 ? "btn-success fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                        @onclick="() => currentJourneyStep = 1">
                    <span class="badge bg-dark me-1">1</span> 10:00 AM: Outpatient Arrival
                </button>
                <button class="btn btn-sm @(currentJourneyStep == 2 ? "btn-success fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                        @onclick="() => currentJourneyStep = 2">
                    <span class="badge bg-dark me-1">2</span> 10:45 AM: Inpatient Bed Admission
                </button>
                <button class="btn btn-sm @(currentJourneyStep == 3 ? "btn-success fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                        @onclick="() => currentJourneyStep = 3">
                    <span class="badge bg-dark me-1">3</span> 11:30 AM: Blood Test (Lab Results)
                </button>
                <button class="btn btn-sm @(currentJourneyStep == 4 ? "btn-success fw-bold text-white shadow-sm" : "btn-outline-secondary")"
                        @onclick="() => currentJourneyStep = 4">
                    <span class="badge bg-dark me-1">4</span> 02:00 PM: Discharge Home
                </button>
            </div>

            <!-- Milestone Details Card -->
            <div class="card border bg-light shadow-sm">
                <div class="card-body p-3">
                    @if (currentJourneyStep == 1)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-primary fs-6 me-2">Milestone 1</span>
                            <h6 class="fw-bold mb-0 text-dark">10:00 AM – Patient Arrival &amp; Demographic Registration</h6>
                        </div>
                        <p class="small text-muted mb-3">
                            Eleanor arrives at the clinic check-in desk. The receptionist collects her legal name, date of birth, address, phone number, and assigns her a Medical Record Number (MRN).
                        </p>
                        <div class="row g-2 small">
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-primary mb-1">HL7 v2 Message: <code>ADT^A04</code> (Register Outpatient)</div>
                                    <p class="text-muted mb-1">Fires the <strong>PID</strong> (Patient Identification) segment containing demographics:</p>
                                    <code class="d-block p-1 bg-dark text-info rounded font-monospace small">
                                        PID|1||MRN982341^^^HOSP^MR||Smith^Eleanor^J||19850614|F|||1244 Healthcare Blvd^^Austin^TX^78701
                                    </code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-success mb-1">FHIR Target: <code>Patient</code> Resource</div>
                                    <p class="text-muted mb-1">Creates an independent demographic identity object with typed properties:</p>
                                    <code class="d-block p-1 bg-dark text-success rounded font-monospace small">
                                        { "resourceType": "Patient", "name": [{ "family": "Smith", "given": ["Eleanor"] }] }
                                    </code>
                                </div>
                            </div>
                        </div>
                    }
                    else if (currentJourneyStep == 2)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-primary fs-6 me-2">Milestone 2</span>
                            <h6 class="fw-bold mb-0 text-dark">10:45 AM – Emergency Inpatient Admission to Bed &amp; Ward</h6>
                        </div>
                        <p class="small text-muted mb-3">
                            The triage physician detects abnormal symptoms and officially admits Eleanor to the Cardiology ICU ward, assigning her Room 402, Bed B under attending doctor Sarah Cardio.
                        </p>
                        <div class="row g-2 small">
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-primary mb-1">HL7 v2 Message: <code>ADT^A01</code> (Admit Inpatient)</div>
                                    <p class="text-muted mb-1">Fires the <strong>PV1</strong> (Patient Visit) segment with patient class <code>I</code> (Inpatient) and bed location:</p>
                                    <code class="d-block p-1 bg-dark text-info rounded font-monospace small">
                                        PV1|1|I|ICU_CARDIO^ROOM_402^BED_B||||DOC881^Cardio^Sarah||||||||||||VISIT-77391
                                    </code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-success mb-1">FHIR Target: <code>Encounter</code> Resource</div>
                                    <p class="text-muted mb-1">Creates an <code>Encounter</code> with <code>class = IMP</code>, linked to the Patient via <code>subject</code>:</p>
                                    <code class="d-block p-1 bg-dark text-success rounded font-monospace small">
                                        { "resourceType": "Encounter", "status": "in-progress", "class": { "code": "IMP" } }
                                    </code>
                                </div>
                            </div>
                        </div>
                    }
                    else if (currentJourneyStep == 3)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-primary fs-6 me-2">Milestone 3</span>
                            <h6 class="fw-bold mb-0 text-dark">11:30 AM – Laboratory Blood Test (Metabolic Panel Analyzed)</h6>
                        </div>
                        <p class="small text-muted mb-3">
                            A blood sample is sent to the lab. The lab analyzer measures Eleanor's Glucose (142 mg/dL - abnormally High) and Potassium (4.2 mmol/L - Normal).
                        </p>
                        <div class="row g-2 small">
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-primary mb-1">HL7 v2 Message: <code>ORU^R01</code> (Observational Results)</div>
                                    <p class="text-muted mb-1"><strong>OBR</strong> is the lab panel header; <strong>OBX</strong> holds the discrete test values and flags:</p>
                                    <code class="d-block p-1 bg-dark text-info rounded font-monospace small">
                                        OBR|1|||24323-8^Basic Metabolic Panel^LN<br />
                                        OBX|1|NM|2345-7^Glucose^LN||142|mg/dL|70-99|H
                                    </code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-success mb-1">FHIR Target: <code>Observation</code> Resources</div>
                                    <p class="text-muted mb-1">Each test result becomes an <code>Observation</code> with LOINC code, UCUM units, and interpretation flag:</p>
                                    <code class="d-block p-1 bg-dark text-success rounded font-monospace small">
                                        { "resourceType": "Observation", "code": "2345-7", "valueQuantity": { "value": 142 }, "interpretation": ["H"] }
                                    </code>
                                </div>
                            </div>
                        </div>
                    }
                    else if (currentJourneyStep == 4)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-primary fs-6 me-2">Milestone 4</span>
                            <h6 class="fw-bold mb-0 text-dark">02:00 PM – Patient Stabilized &amp; Discharged Home</h6>
                        </div>
                        <p class="small text-muted mb-3">
                            Eleanor responds well to medication, receives her care plan instructions, and is discharged to home in good condition.
                        </p>
                        <div class="row g-2 small">
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-primary mb-1">HL7 v2 Message: <code>ADT^A03</code> (Discharge Event)</div>
                                    <p class="text-muted mb-1">Fires PV1 with discharge date (PV1-45) and disposition code <code>01</code> (home):</p>
                                    <code class="d-block p-1 bg-dark text-info rounded font-monospace small">
                                        PV1|1|I|...||||||||||||||||||||||||||||||||||||||01||||||20261011104500|20261011140000
                                    </code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2 bg-white rounded border h-100">
                                    <div class="fw-bold text-success mb-1">FHIR Target: <code>Encounter</code> State Update</div>
                                    <p class="text-muted mb-1">The existing Encounter transitions to <code>finished</code> with an end timestamp:</p>
                                    <code class="d-block p-1 bg-dark text-success rounded font-monospace small">
                                        { "resourceType": "Encounter", "status": "finished", "period": { "end": "2026-10-11T14:00:00Z" } }
                                    </code>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- TOPIC 5: JARGON BUSTER DICTIONARY -->
    <div id="topic-jargon" class="card shadow-sm mb-4 border-info border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-info">
                <i class="bi bi-search me-2"></i> Topic 5: "Jargon Buster" – Searchable Acronym Dictionary
            </h5>
            <span class="badge bg-info text-dark">Glossary</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                Search or filter any unfamiliar healthcare terminology:
            </p>

            <div class="row g-2 mb-3">
                <div class="col-md-8">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Search any term (e.g. ADT, LOINC, PID, MLLP, MRN, OBR, OBX)..." 
                               @bind="jargonSearch" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select form-select-sm" @bind="selectedJargonCategory">
                        <option value="All">All Categories</option>
                        <option value="HL7 v2">HL7 v2 Terms</option>
                        <option value="FHIR">FHIR Terms</option>
                        <option value="Terminology">Coding &amp; Terminologies</option>
                        <option value="Hospital">Hospital Concepts</option>
                    </select>
                </div>
            </div>

            <!-- Terms Grid -->
            <div class="row g-2">
                @foreach (var term in FilteredJargon)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-body p-2 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="font-monospace fw-bold text-primary">@term.Term</span>
                                    <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">@term.Category</span>
                                </div>
                                <h6 class="card-title fw-semibold small mb-1">@term.FullName</h6>
                                <p class="card-text text-muted small flex-grow-1 mb-0" style="font-size: 0.8rem;">@term.Definition</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TOPIC 6: INTERACTIVE PRACTICE QUIZ & REFS -->
    <div id="topic-quiz" class="card shadow-sm mb-4 border-secondary border-top border-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-award-fill me-2"></i> Topic 6: Knowledge Check &amp; Official References
            </h5>
            <span class="badge bg-secondary">Self-Assessment</span>
        </div>
        <div class="card-body p-3">
            <p class="small text-muted mb-3">
                Test your understanding with these real-world decoding questions:
            </p>

            <div class="row g-3 mb-4">
                @for (int i = 0; i < QuizQuestions.Count; i++)
                {
                    var qIndex = i;
                    var q = QuizQuestions[qIndex];
                    <div class="col-md-6">
                        <div class="card h-100 border shadow-sm">
                            <div class="card-header bg-light py-2 fw-semibold small d-flex justify-content-between align-items-center">
                                <span>Question @(qIndex + 1) of @QuizQuestions.Count</span>
                                @if (userAnswers.ContainsKey(qIndex))
                                {
                                    if (userAnswers[qIndex] == q.CorrectOptionIndex)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Correct!</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Try Again</span>
                                    }
                                }
                            </div>
                            <div class="card-body p-3 small">
                                <p class="fw-bold mb-2">@q.QuestionText</p>
                                @if (!string.IsNullOrEmpty(q.Snippet))
                                {
                                    <div class="p-1 mb-2 bg-dark text-info rounded font-monospace small" style="font-size: 0.75rem;">
                                        @q.Snippet
                                    </div>
                                }
                                <div class="d-grid gap-1 mb-2">
                                    @for (int opt = 0; opt < q.Options.Count; opt++)
                                    {
                                        var optIndex = opt;
                                        var isSelected = userAnswers.ContainsKey(qIndex) && userAnswers[qIndex] == optIndex;
                                        var isCorrect = optIndex == q.CorrectOptionIndex;
                                        string btnClass = "btn-outline-secondary";

                                        if (userAnswers.ContainsKey(qIndex))
                                        {
                                            if (isCorrect) btnClass = "btn-success text-white fw-bold";
                                            else if (isSelected) btnClass = "btn-danger text-white";
                                        }

                                        <button class="btn btn-sm text-start py-1 px-2 @btnClass"
                                                @onclick="() => AnswerQuestion(qIndex, optIndex)">
                                            <span class="me-1">@((char)('A' + optIndex)).</span> @q.Options[optIndex]
                                        </button>
                                    }
                                </div>
                                @if (userAnswers.ContainsKey(qIndex))
                                {
                                    <div class="alert @(userAnswers[qIndex] == q.CorrectOptionIndex ? "alert-success" : "alert-warning") p-2 mb-0 mt-2" style="font-size: 0.8rem;">
                                        <strong>Explanation:</strong> @q.Explanation
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Official Documentation Links -->
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-bookmark-star text-primary me-1"></i> Authoritative Documentation References</h6>
            <div class="row g-2 small">
                <div class="col-md-3">
                    <a href="https://hl7.org/fhir/R4/" target="_blank" class="btn btn-outline-primary btn-sm w-100 text-truncate">
                        HL7 FHIR R4 Spec <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="https://docs.fire.ly/projects/Firely-NET-SDK/" target="_blank" class="btn btn-outline-success btn-sm w-100 text-truncate">
                        Firely C# SDK Docs <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="https://loinc.org/" target="_blank" class="btn btn-outline-warning btn-sm text-dark w-100 text-truncate">
                        Regenstrief LOINC <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="https://smarthealthit.org/" target="_blank" class="btn btn-outline-info btn-sm text-dark w-100 text-truncate">
                        SMART Health IT OAuth2 <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
