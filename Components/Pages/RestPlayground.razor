@page "/rest-playground"
@rendermode InteractiveServer
@inject FhirService FhirService
@inject IJSRuntime JS

<PageTitle>FHIR REST API Playground &amp; Query Builder</PageTitle>

<div class="py-2 w-100" style="max-width: 100%; overflow-x: hidden;">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h3 fw-bold mb-0"><i class="bi bi-cloud-arrow-down text-info"></i> FHIR REST API Playground &amp; Query Builder</h2>
            <p class="text-muted small mb-0">Learn FHIR RESTful interactions, visual search parameters, _include joins, and Bundle responses.</p>
        </div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="mockToggle" @bind="useMockMode">
            <label class="form-check-label small fw-semibold" for="mockToggle">
                Offline / Mock Mode @(useMockMode ? "(Instant)" : "(Live Cloud API)")
            </label>
        </div>
    </div>

    <!-- Visual Search Builder Card -->
    <div class="card shadow-sm mb-3 border">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold small"><i class="bi bi-sliders text-primary me-1"></i> Visual FHIR Search Parameter Builder</span>
            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => showAdvancedBuilder = !showAdvancedBuilder">
                <i class="bi @(showAdvancedBuilder ? "bi-chevron-up" : "bi-chevron-down")"></i> @(showAdvancedBuilder ? "Hide Advanced Options" : "Show Advanced Options (_include, prefixes)")
            </button>
        </div>
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Base FHIR Endpoint</label>
                    <input type="text" class="form-control form-control-sm font-monospace" @bind="baseUrl" disabled="@useMockMode" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Resource Type</label>
                    <select class="form-select form-select-sm" @bind="selectedResourceType" @bind:after="UpdateQueryFromBuilder">
                        <option value="Patient">Patient</option>
                        <option value="Observation">Observation</option>
                        <option value="Encounter">Encounter</option>
                        <option value="DiagnosticReport">DiagnosticReport</option>
                        <option value="Condition">Condition</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Compiled Search URL Query</label>
                    <input type="text" class="form-control form-control-sm font-monospace text-primary fw-bold" @bind="searchQuery" />
                </div>
                <div class="col-md-2 align-self-end">
                    <button class="btn btn-primary btn-sm w-100" @onclick="ExecuteQuery" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span> <span>Querying...</span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill"></i> <span>Send Request</span>
                        }
                    </button>
                </div>
            </div>

            <!-- Advanced Builder Controls -->
            @if (showAdvancedBuilder)
            {
                <div class="p-3 mt-3 bg-light rounded border small">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-funnel text-primary me-1"></i> Advanced Query Modifiers:</h6>
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3">
                            <label class="text-muted d-block mb-1">Date Comparator Prefix:</label>
                            <select class="form-select form-select-sm" @bind="selectedDatePrefix" @bind:after="UpdateQueryFromBuilder">
                                <option value="">None (Exact)</option>
                                <option value="ge">ge (&gt;= Greater or Equal)</option>
                                <option value="le">le (&lt;= Less or Equal)</option>
                                <option value="gt">gt (&gt; Greater Than)</option>
                                <option value="lt">lt (&lt; Less Than)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted d-block mb-1">Compound Join (<code>_include</code>):</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="incResult" @bind="includeResultResource" @bind:after="UpdateQueryFromBuilder">
                                <label class="form-check-label" for="incResult">
                                    <code>_include=DiagnosticReport:result</code> (Fetch report + lab observations)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="incSubject" @bind="includePatientSubject" @bind:after="UpdateQueryFromBuilder">
                                <label class="form-check-label" for="incSubject">
                                    <code>_include=Observation:patient</code> (Fetch observation + patient chart)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="text-muted d-block mb-1">Chained Parameter Search:</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chainSearch" @bind="useChainedSearch" @bind:after="UpdateQueryFromBuilder">
                                <label class="form-check-label" for="chainSearch">
                                    <code>subject:Patient.name=Smith</code> (Find observations by patient surname)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Quick Preset Queries -->
            <div class="mt-2 pt-2 border-top d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small">Quick Presets:</span>
                <button class="btn btn-outline-secondary btn-sm py-0" @onclick='() => SetQuery("Patient", "name=Smith")'>Patient?name=Smith</button>
                <button class="btn btn-outline-secondary btn-sm py-0" @onclick='() => SetQuery("Patient", "gender=female&_count=5")'>Patient?gender=female</button>
                <button class="btn btn-outline-secondary btn-sm py-0" @onclick='() => SetQuery("Observation", "category=laboratory&_count=5")'>Observation?category=laboratory</button>
                <button class="btn btn-outline-secondary btn-sm py-0" @onclick='() => SetQuery("Encounter", "status=in-progress")'>Encounter?status=in-progress</button>
                <button class="btn btn-outline-secondary btn-sm py-0" @onclick='() => SetQuery("DiagnosticReport", "_include=DiagnosticReport:result")'>DiagnosticReport?_include=result</button>
            </div>
        </div>
    </div>

    <!-- Results and Teaching Breakdown -->
    <div class="row g-3">
        <!-- Results Column -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
                    <div>
                        <span class="badge @(responseStatusClass) me-2 font-monospace">@statusBadge</span>
                        <span class="font-monospace small text-muted text-break">GET @($"{baseUrl}/{selectedResourceType}?{searchQuery}")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(executionTime))
                    {
                        <span class="badge bg-secondary">@executionTime</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="p-3">
                            <div class="alert alert-warning mb-0">
                                <strong><i class="bi bi-exclamation-triangle"></i> Notice:</strong> @errorMessage
                                <div class="mt-2 small text-muted">Tip: Enable <strong>Offline / Mock Mode</strong> above to test with zero network latency.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <pre class="bg-dark text-light p-3 m-0 font-monospace small overflow-auto" 
                             style="max-height: 60vh; tab-size: 2; white-space: pre-wrap; word-break: break-all; border-radius: 0 0 var(--bs-card-inner-border-radius) var(--bs-card-inner-border-radius);"><code>@responseContent</code></pre>
                    }
                </div>
            </div>
        </div>

        <!-- FHIR REST Paradigm Guide -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light fw-semibold small py-2">
                    <i class="bi bi-journal-text text-primary"></i> FHIR REST Search Rules
                </div>
                <div class="card-body p-3 small text-muted">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <strong class="text-dark">1. <code>_include</code> (Compound Queries):</strong><br />
                            Allows you to fetch parent and child resources in a single call (e.g. Report + Observations), preventing the "N+1 queries" problem.
                        </li>
                        <li class="mb-2">
                            <strong class="text-dark">2. Date Prefixes:</strong><br />
                            <code>ge</code> (&gt;=), <code>le</code> (&lt;=), <code>gt</code> (&gt;), <code>lt</code> (&lt;).<br />
                            Example: <code>birthdate=ge1980-01-01</code>.
                        </li>
                        <li class="mb-2">
                            <strong class="text-dark">3. Chained Parameters:</strong><br />
                            Use colons to query related resources without separate requests: <code>Observation?subject:Patient.name=Smith</code>.
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light fw-semibold small py-2">
                    <i class="bi bi-shield-lock text-secondary"></i> SMART on FHIR Security
                </div>
                <div class="card-body p-3 small text-muted">
                    Production EHR APIs (Epic, Cerner) enforce OAuth 2.0 scopes:
                    <ul class="mt-2 mb-0 ps-3">
                        <li><code>patient/*.read</code>: Read all patient resources</li>
                        <li><code>user/Observation.write</code>: Log clinical vitals</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string baseUrl = "https://hapi.fhir.org/baseR4";
    private string selectedResourceType = "Patient";
    private string searchQuery = "name=Smith";
    private bool useMockMode = false;
    private bool isLoading = false;
    private bool showAdvancedBuilder = false;
    private string selectedDatePrefix = "";
    private bool includeResultResource = false;
    private bool includePatientSubject = false;
    private bool useChainedSearch = false;

    private string responseContent = string.Empty;
    private string statusBadge = "200 OK";
    private string responseStatusClass = "bg-success";
    private string executionTime = string.Empty;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await ExecuteQuery();
    }

    private void SetQuery(string type, string query)
    {
        selectedResourceType = type;
        searchQuery = query;
    }

    private void UpdateQueryFromBuilder()
    {
        var parts = new List<string>();

        if (selectedResourceType == "Patient")
        {
            parts.Add("name=Smith");
            if (!string.IsNullOrEmpty(selectedDatePrefix))
            {
                parts.Add($"birthdate={selectedDatePrefix}1980-01-01");
            }
        }
        else if (selectedResourceType == "Observation")
        {
            if (useChainedSearch)
            {
                parts.Add("subject:Patient.name=Smith");
            }
            else
            {
                parts.Add("category=laboratory");
            }

            if (includePatientSubject)
            {
                parts.Add("_include=Observation:patient");
            }
        }
        else if (selectedResourceType == "DiagnosticReport")
        {
            if (includeResultResource)
            {
                parts.Add("_include=DiagnosticReport:result");
            }
            else
            {
                parts.Add("status=final");
            }
        }
        else
        {
            parts.Add("status=in-progress");
        }

        parts.Add("_count=5");
        searchQuery = string.Join("&", parts);
    }

    private async Task ExecuteQuery()
    {
        isLoading = true;
        errorMessage = null;
        var sw = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            if (useMockMode)
            {
                await Task.Delay(80);
                responseContent = GenerateMockSearchBundle(selectedResourceType);
                statusBadge = "200 OK (Mock)";
                responseStatusClass = "bg-info text-dark";
            }
            else
            {
                var (success, json, error) = await FhirService.QueryPublicFhirServerAsync(selectedResourceType, searchQuery, baseUrl);
                if (success)
                {
                    responseContent = json;
                    statusBadge = "200 OK (Live Server)";
                    responseStatusClass = "bg-success";
                }
                else
                {
                    errorMessage = error;
                    statusBadge = "Offline / Error";
                    responseStatusClass = "bg-danger";
                    responseContent = GenerateMockSearchBundle(selectedResourceType);
                }
            }
        }
        finally
        {
            sw.Stop();
            executionTime = $"{sw.ElapsedMilliseconds} ms";
            isLoading = false;
        }
    }

    private string GenerateMockSearchBundle(string resType)
    {
        return $@"{{
  ""resourceType"": ""Bundle"",
  ""id"": ""mock-searchset-{Guid.NewGuid():N}"",
  ""type"": ""searchset"",
  ""total"": 1,
  ""link"": [
    {{
      ""relation"": ""self"",
      ""url"": ""{baseUrl}/{resType}?{searchQuery}""
    }}
  ],
  ""entry"": [
    {{
      ""fullUrl"": ""https://hapi.fhir.org/baseR4/{resType}/10042"",
      ""resource"": {{
        ""resourceType"": ""{resType}"",
        ""id"": ""10042"",
        ""meta"": {{
          ""versionId"": ""1"",
          ""lastUpdated"": ""{DateTime.UtcNow:yyyy-MM-ddTHH:mm:ssZ}""
        }},
        ""text"": {{
          ""status"": ""generated"",
          ""div"": ""<div xmlns=\""http://www.w3.org/1999/xhtml\"">Sample {resType} Search Result</div>""
        }}
      }}
    }}
  ]
}}";
    }
}
